import { Theme } from "../theme.slint";
import { MenuRow } from "../state.slint";
import { Glyph } from "glyph.slint";
import { Wash } from "wash.slint";

// The actions not worth a button of their own. What comes back is the row's action,
// not its position: a handler switching on a row number is one insertion away from
// firing the wrong thing.
export component ActionMenu inherits PopupWindow {
    in property <[MenuRow]> items;

    callback triggered(string);

    property <length> row-height: 32px;
    property <length> separator-height: 9px;

    width: 240px;
    height: 10px + rows.preferred-height;
    close-policy: close-on-click-outside;

    Rectangle {
        background: Theme.raised;
        border-radius: Theme.radius-small;
        border-width: 1px;
        border-color: Theme.border-strong;
    }

    rows := VerticalLayout {
        x: 5px;
        y: 5px;
        width: parent.width - 10px;
        height: parent.height - 10px;

        for item in root.items : Rectangle {
            property <bool> usable: !item.separator && !item.disabled;

            height: item.separator ? root.separator-height : root.row-height;

            if item.separator : Rectangle {
                x: 4px;
                y: (parent.height - 1px) / 2;
                width: parent.width - 8px;
                height: 1px;
                background: Theme.border;
            }

            if !item.separator : Wash {
                hovered: hover.has-hover && usable;
            }

            if !item.separator : HorizontalLayout {
                x: 10px;
                width: parent.width - 20px;
                spacing: 9px;
                alignment: start;

                Glyph {
                    width: item.glyph == "" ? 0px : 12px * self.weight;
                    name: item.glyph;
                    weight: 1;
                    tone: item.danger ? Theme.danger : Theme.faint;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: item.label;
                    color: item.danger ? Theme.danger : Theme.text;
                    opacity: usable ? 1 : 0.4;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                }
            }

            hover := TouchArea {
                enabled: usable;
                mouse-cursor: pointer;

                // Told before it is taken down: closing first would leave the rest
                // of this reaching through handles the close may have let go of.
                clicked => {
                    root.triggered(item.action);
                    root.close();
                }
            }
        }
    }
}
