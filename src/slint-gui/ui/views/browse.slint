import { Theme } from "../theme.slint";
import { Sys, Ports } from "../state.slint";
import { Sheets } from "../sheets.slint";
import { Surface } from "../components/surface.slint";
import { Pill } from "../components/pill.slint";
import { GlyphButton } from "../components/glyph-button.slint";
import { AppButton } from "../components/app-button.slint";
import { Fact } from "../components/fact.slint";
import { Scroller } from "../components/scroller.slint";

// The half of the engines page that fetches a port, unpacks it beside ZDL's own
// files and adds it to the list profiles pick from.
export component BrowseView {
    // A page fills its frame; a component with no base would shrink to its contents.
    preferred-width: 100%;
    preferred-height: 100%;

    property <length> bleed: 16px;
    property <length> gutter: 16px;
    property <length> room: sheet.width - root.bleed * 2 - 8px;
    property <int> columns: max(1, floor((root.room + root.gutter) / (330px + root.gutter)));
    property <length> cell: (root.room - (root.columns - 1) * root.gutter) / root.columns;
    property <length> row-height: 186px;
    property <int> rows: floor((Ports.rows.length + root.columns - 1) / root.columns);
    property <length> shelf-height: root.rows * (root.row-height + root.gutter);

    // Nothing is asked of GitHub until somebody comes looking.
    changed visible => {
        if (root.visible) {
            Ports.refresh(false);
        }
    }

    sheet := Flickable {
        viewport-width: self.width;
        viewport-height: root.shelf-height + 2px + kept.height + 34px;

        for card[index] in Ports.rows : Surface {
            property <bool> working: card.status == "fetching" || card.status == "unpacking";
            property <bool> here: card.status == "installed";

            property <bool> behind: here && card.have != "" && card.version != ""
                && card.version != card.have;

            x: root.bleed + Math.mod(index, root.columns) * (root.cell + root.gutter);
            y: 2px + floor(index / root.columns) * (root.row-height + root.gutter);
            width: root.cell;
            height: root.row-height;
            hoverable: true;
            hovered: reach.has-hover;

            reach := TouchArea { }

            VerticalLayout {
                x: 16px;
                y: 16px;
                width: parent.width - 32px;
                height: self.preferred-height;
                spacing: 8px;
                alignment: start;

                HorizontalLayout {
                    spacing: 8px;
                    height: self.preferred-height;

                    Text {
                        text: card.name;
                        color: Theme.text;
                        font-size: Theme.font-medium;
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: center;
                    }

                    Rectangle { }

                    // Worth knowing before it is fetched.
                    if card.dos : Pill {
                        height: 22px;
                        dot: false;
                        text: "DOS";
                        tone: Theme.muted;
                        wash: Theme.muted-soft;
                        y: (parent.height - self.height) / 2;
                    }

                    if card.status != "ready" && card.status != "waiting" && !working : Pill {
                        height: 22px;
                        y: (parent.height - self.height) / 2;

                        text: behind ? "Update"
                            : here ? "Installed"
                            : card.status == "checking" ? "Checking"
                            : card.status == "failed" ? "Failed"
                            : card.status == "elsewhere" ? "Its own site"
                            : "Not for this system";

                        tone: behind ? Theme.accent
                            : here ? Theme.success
                            : card.status == "failed" ? Theme.danger
                            : card.status == "checking" ? Theme.accent
                            : Theme.warning;

                        wash: behind ? Theme.accent-soft
                            : here ? Theme.success-soft
                            : card.status == "failed" ? Theme.danger-soft
                            : card.status == "checking" ? Theme.accent-soft
                            : Theme.warning-soft;
                    }
                }

                Text {
                    text: card.blurb;
                    color: Theme.faint;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }

            Rectangle {
                x: 16px;
                y: buttons.y - 26px;
                width: parent.width - 32px;
                height: 16px;

                Text {
                    width: parent.width;
                    y: (parent.height - self.height) / 2;
                    visible: !working;

                    text: card.error != "" ? card.error
                        : card.status == "elsewhere" ? "Fetched from its own site"
                        : behind ? card.have + " here · " + card.version + " released"
                        : here ? (card.have == "" ? "" : card.have + " here")
                        : card.version == "" ? ""
                        : card.size-text != ""
                            ? card.version + " · " + card.size-text
                            : card.version;

                    color: card.status == "failed" ? Theme.danger : Theme.faint;
                    font-size: Theme.font-small;
                    overflow: elide;
                }

                if working : Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.sunken;

                    Rectangle {
                        x: 0;
                        height: parent.height;
                        border-radius: parent.border-radius;
                        background: Theme.accent;

                        // Unpacking has no number, so the bar stands full.
                        width: card.status == "unpacking"
                            ? parent.width
                            : parent.width * clamp(card.progress, 0.0, 1.0);

                        animate width { duration: 120ms; }
                    }
                }
            }

            buttons := HorizontalLayout {
                x: 16px;
                y: parent.height - self.height - 16px;
                width: self.preferred-width;
                height: self.preferred-height;
                spacing: 8px;

                if working : AppButton {
                    text: "Stop";
                    glyph: "cross";
                    compact: true;
                    clicked => {
                        Ports.cancel(index);
                    }
                }

                if !working && card.status != "elsewhere" && card.status != "unavailable"
                        : AppButton {
                    text: behind ? "Update" : here ? "Fetch again" : "Install";
                    glyph: "download";
                    variant: here && !behind ? "default" : "primary";
                    compact: true;
                    busy: card.status == "checking";

                    hint: here
                        ? "Fetch the latest build over the one that is here"
                        : "Fetch it and add it to the source ports";

                    clicked => {
                        Ports.install(index);
                    }
                }

                if here && !working : GlyphButton {
                    glyph: "folder";
                    outlined: true;
                    y: (parent.height - self.height) / 2;
                    hint: "Open the directory it was unpacked into";
                    clicked => {
                        Sys.reveal(Sys.directory-of(card.file));
                    }
                }

                if here && !working : GlyphButton {
                    glyph: "trash";
                    outlined: true;
                    hover-tone: Theme.danger;
                    y: (parent.height - self.height) / 2;
                    hint: "Delete what was fetched and take it out of the port list";
                    clicked => {
                        Sheets.ask("remove-fetched", "", index,
                                   "Remove " + card.name + "?",
                                   "Everything ZDL unpacked for it is deleted and it is taken "
                                   + "out of the source ports. Profiles pointing at it are "
                                   + "left without a port.",
                                   "Remove it", true);
                    }
                }

                if !here || working : AppButton {
                    text: "Project page";
                    variant: "ghost";
                    compact: true;
                    clicked => {
                        Sys.open-url(card.homepage);
                    }
                }
            }
        }

        kept := Surface {
            x: root.bleed;
            y: root.shelf-height + 20px;
            width: root.room;
            height: 76px;

            Fact {
                x: 16px;
                y: (parent.height - self.height) / 2;
                height: self.preferred-height;
                label: "Where they are kept";
                value: Ports.directory;
                path: true;
                clickable: true;
                hint: "Open the directory";
                room: parent.width - 200px;
            }
        }
    }

    bar := Scroller {
        x: parent.width - self.width;
        height: parent.height;
        offset: sheet.viewport-y;
        content: sheet.viewport-height;
        room: sheet.height;
        scrolled(to) => {
            sheet.viewport-y = to;
        }
    }
}
