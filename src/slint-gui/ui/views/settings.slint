import { Theme } from "../theme.slint";
import { Sys, Cfg, Ports, Pick } from "../state.slint";
import { Sheets } from "../sheets.slint";
import { Surface } from "../components/surface.slint";
import { Field } from "../components/field.slint";
import { PathField } from "../components/path-field.slint";
import { Toggle } from "../components/toggle.slint";
import { Segmented } from "../components/segmented.slint";
import { AppButton } from "../components/app-button.slint";
import { Fact } from "../components/fact.slint";
import { Scroller } from "../components/scroller.slint";

// Everything the application's rather than any one profile's.
export component SettingsView {
    // A page fills its frame; a component with no base would shrink to its contents.
    preferred-width: 100%;
    preferred-height: 100%;

    // The other pages' inset, so they line up as they swap.
    property <length> bleed: 16px;

    property <length> width-of-body: body.width;
    property <bool> wide: root.width-of-body >= 760px;
    property <length> half: root.wide
        ? (root.width-of-body - 32px - 20px) / 2
        : root.width-of-body - 32px;

    // Where the path came from: this machine's own, one named by hand, or none.
    property <string> dosbox: Cfg.dosbox != "" ? Cfg.dosbox : Cfg.system-dosbox;
    property <string> dosbox-kind: root.dosbox == "" ? "none"
        : !Sys.is-file(root.dosbox) ? "missing"
        : root.dosbox == Cfg.system-dosbox ? "system"
        : "custom";

    // Counted when the page is looked at, not kept up to date behind its back.
    changed visible => {
        if (root.visible) {
            Ports.measure();
        }
    }

    VerticalLayout {
        spacing: 16px;

        VerticalLayout {
            padding-left: root.bleed;
            padding-right: root.bleed;
            height: self.preferred-height;
            spacing: 3px;

            Text {
                text: "Settings";
                color: Theme.text;
                font-size: Theme.font-display;
                font-weight: Theme.heading-weight;
            }

            Text {
                text: "How launching behaves, and where all of it is kept";
                color: Theme.faint;
                font-size: Theme.font-small;
            }
        }

        sheet := Flickable {
            // A layout hands its height up to whatever holds it, so without this
            // the page stops where its content does and scrolls the rest away.
            max-height: root.height;
            viewport-width: self.width;
            viewport-height: body.preferred-height + 8px;

            body := VerticalLayout {
                x: root.bleed;
                width: sheet.width - root.bleed * 2 - 8px;
                height: self.preferred-height;
                spacing: 16px;

                Surface {
                    height: behaviour.preferred-height + 32px;

                    behaviour := VerticalLayout {
                        x: 16px;
                        y: 16px;
                        width: parent.width - 32px;
                        height: self.preferred-height;
                        spacing: 16px;
                        alignment: start;

                        Text {
                            text: "Behaviour";
                            color: Theme.text;
                            font-size: Theme.font-medium;
                            font-weight: Theme.heading-weight;
                        }

                        // One carries a pill and is taller for it, so they line up
                        // by the boxes rather than the labels.
                        HorizontalLayout {
                            spacing: 20px;
                            height: self.preferred-height;
                            alignment: start;
                            cross-axis-alignment: end;

                            Field {
                                width: root.half;
                                label: "Always add these arguments";
                                placeholder: "Added to every launch, whatever the profile";
                                text: Cfg.always-add;
                                mono: true;
                                edited(value) => {
                                    Cfg.set-always-add(value);
                                }
                            }

                            PathField {
                                width: root.half;
                                label: "DOSBox";
                                placeholder: "Only for source ports that are DOS programs";

                                // Filled in rather than described, so it can be
                                // typed over like any other.
                                text: root.dosbox;

                                filters: Sys.port-filters;
                                remember: "src";
                                browse-title: "Select DOSBox";
                                pick-action: "dosbox";

                                badge: root.dosbox-kind == "none" ? "Not found"
                                    : root.dosbox-kind == "missing" ? "Missing"
                                    : root.dosbox-kind == "system" ? "System"
                                    : "Custom";

                                badge-tone: root.dosbox-kind == "none" ? Theme.warning
                                    : root.dosbox-kind == "missing" ? Theme.danger
                                    : root.dosbox-kind == "system" ? Theme.success
                                    : Theme.accent;

                                badge-wash: root.dosbox-kind == "none" ? Theme.warning-soft
                                    : root.dosbox-kind == "missing" ? Theme.danger-soft
                                    : root.dosbox-kind == "system" ? Theme.success-soft
                                    : Theme.accent-soft;

                                edited(value) => {
                                    Cfg.set-dosbox(value);
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }

                        VerticalLayout {
                            spacing: 18px;
                            height: self.preferred-height;

                            HorizontalLayout {
                                spacing: 20px;
                                height: self.preferred-height;
                                alignment: start;

                                Toggle {
                                    width: root.half;
                                    text: "Close on launch";
                                    checked: Cfg.auto-close;
                                    hint: "Quit ZDL as soon as the source port has started";
                                    toggled(value) => {
                                        Cfg.set-auto-close(value);
                                    }
                                }

                                Toggle {
                                    width: root.half;
                                    text: "Show file paths";
                                    checked: Cfg.show-paths;
                                    hint: "Show the directory a file came from underneath its "
                                        + "name";
                                    toggled(value) => {
                                        Cfg.set-show-paths(value);
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 20px;
                                height: self.preferred-height;
                                alignment: start;

                                Toggle {
                                    width: root.half;
                                    text: "Launch .zdl files at once";
                                    checked: Cfg.launch-zdl-immediately;
                                    hint: "A .zdl given on the command line launches without "
                                        + "showing this window";
                                    toggled(value) => {
                                        Cfg.set-launch-zdl-immediately(value);
                                    }
                                }

                                Toggle {
                                    width: root.half;
                                    text: "A config file per profile";
                                    checked: Cfg.profile-configs;
                                    hint: "Each profile keeps the source port's own settings -- "
                                        + "controls, video, sound -- in a file of its own, "
                                        + "instead of every profile sharing one";
                                    toggled(value) => {
                                        Cfg.set-profile-configs(value);
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            height: self.preferred-height;

                            Text {
                                text: "Open the library on";
                                color: Theme.text;
                                font-size: Theme.font-body;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            Rectangle { }

                            Segmented {
                                y: (parent.height - self.height) / 2;
                                current: Cfg.start-view;
                                options: [{ key: "profiles", label: "Profiles" },
                                          { key: "games", label: "Games" }];
                                selected(key) => {
                                    Cfg.set-start-view(key);
                                }
                            }
                        }
                    }
                }

                Surface {
                    height: kept.preferred-height + 32px;

                    kept := VerticalLayout {
                        x: 16px;
                        y: 16px;
                        width: parent.width - 32px;
                        height: self.preferred-height;
                        spacing: 16px;
                        alignment: start;

                        Text {
                            text: "This config";
                            color: Theme.text;
                            font-size: Theme.font-medium;
                            font-weight: Theme.heading-weight;
                        }

                        Fact {
                            label: "Configuration file";
                            value: Cfg.path;
                            path: true;
                            clickable: true;
                            hint: "Open the directory it is in";
                            opens: Sys.directory-of(Cfg.path);
                            room: kept.width - 40px;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            height: self.preferred-height;
                            alignment: start;

                            AppButton {
                                text: "Open a config…";
                                glyph: "folder";
                                compact: true;
                                hint: "Work on a different config file from here on";
                                clicked => {
                                    Pick.start("load-config", "Open a config file",
                                               Sys.config-filters, false, false, "config",
                                               "", "");
                                }
                            }

                            AppButton {
                                text: "Save as…";
                                glyph: "up";
                                compact: true;
                                hint: "Write this config somewhere else and work on it there "
                                    + "from now on";
                                clicked => {
                                    Pick.start("save-config", "Save the config into",
                                               Sys.any-filters, true, false, "config", "", "");
                                }
                            }

                            AppButton {
                                text: "Use as the user config";
                                glyph: "check";
                                compact: true;
                                enabled: !Cfg.user-config;
                                hint: Cfg.user-config
                                    ? "This is already the one ZDL opens by default"
                                    : "Make this the one ZDL opens by default";
                                clicked => {
                                    Sheets.ask("adopt-config", "", 0,
                                               "Use this as the user config?",
                                               "This config replaces the one ZDL opens by "
                                               + "default, at " + Sys.pretty-path(Cfg.path)
                                               + ".",
                                               "Replace it", false);
                                }
                            }

                            AppButton {
                                text: "Import a .zdl…";
                                glyph: "download";
                                compact: true;
                                hint: "Read a .zdl launch config in as a profile of its own";
                                clicked => {
                                    Pick.start("load-zdl", "Load a .zdl launch config",
                                               Sys.zdl-filters, false, false, "zdl", "", "");
                                }
                            }

                            AppButton {
                                text: "Clear everything";
                                glyph: "trash";
                                variant: "danger";
                                compact: true;
                                hint: "Empties this config: every profile with the files and "
                                    + "settings in it, every game, and every source port. The "
                                    + "wads and the ports themselves are left where they are";
                                clicked => {
                                    Sheets.ask("clear-everything", "", 0,
                                               "Clear everything?",
                                               "Every profile, every game and every source port "
                                               + "is removed. Nothing on disk is touched, but "
                                               + "this config is emptied and cannot be got back.",
                                               "Clear everything", true);
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }

                        // The flag lives in the user config, and an older ZDL could
                        // set it with no way back.
                        Toggle {
                            text: "Skip the user config at startup";
                            checked: Cfg.ignore-user-config;
                            hint: "ZDL loads a portable config kept next to its program "
                                + "instead. If there is none there, it falls back to the "
                                + "user config anyway";
                            toggled(value) => {
                                Cfg.set-ignore-user-config(value);
                            }
                        }
                    }
                }

                Surface {
                    height: shelf.preferred-height + 32px;

                    shelf := VerticalLayout {
                        x: 16px;
                        y: 16px;
                        width: parent.width - 32px;
                        height: self.preferred-height;
                        spacing: 14px;
                        alignment: start;

                        Text {
                            text: "Downloads";
                            color: Theme.text;
                            font-size: Theme.font-medium;
                            font-weight: Theme.heading-weight;
                        }

                        HorizontalLayout {
                            spacing: 14px;
                            height: self.preferred-height;

                            VerticalLayout {
                                spacing: 6px;
                                y: (parent.height - self.height) / 2;
                                height: self.preferred-height;

                                Fact {
                                    label: "Where they are kept";
                                    value: Ports.downloads;
                                    path: true;
                                    clickable: true;
                                    hint: "Open the directory";
                                    room: shelf.width - 200px;
                                }

                                Text {
                                    text: Ports.cached-text + " kept · what a port was fetched "
                                        + "from stays here, so fetching it again does not bring "
                                        + "it down twice";
                                    color: Theme.faint;
                                    font-size: Theme.font-small;
                                    overflow: elide;
                                }
                            }

                            // Without this the column's spare width is the button's,
                            // and it grows to twice what it says.
                            Rectangle {
                                horizontal-stretch: 1;
                            }

                            AppButton {
                                text: "Empty it";
                                glyph: "trash";
                                variant: "danger";
                                compact: true;
                                enabled: Ports.cached;
                                y: (parent.height - self.height) / 2;

                                hint: Ports.cached
                                    ? "Delete what was downloaded. The ports already unpacked "
                                      + "are left alone"
                                    : "There is nothing being kept";

                                clicked => {
                                    Sheets.ask("clear-downloads", "", 0,
                                               "Empty the downloads?",
                                               "The archives ZDL fetched are deleted. Every port "
                                               + "already unpacked stays where it is, and "
                                               + "anything fetched after this comes down the "
                                               + "wire afresh.",
                                               "Empty it", true);
                                }
                            }
                        }
                    }
                }

                Surface {
                    height: 76px;

                    HorizontalLayout {
                        x: 16px;
                        width: parent.width - 32px;
                        height: parent.height;
                        spacing: 14px;

                        Image {
                            width: 40px;
                            height: 40px;
                            y: (parent.height - self.height) / 2;
                            source: @image-url("../../../../assets/qzdl-128.png");
                        }

                        VerticalLayout {
                            spacing: 2px;
                            y: (parent.height - self.height) / 2;
                            height: self.preferred-height;

                            Text {
                                text: "ZDL " + Sys.version;
                                color: Theme.text;
                                font-size: Theme.font-body;
                                font-weight: 600;
                            }

                            Text {
                                text: "A launcher for ZDoom based Doom engine source ports · "
                                    + Sys.runtime;
                                color: Theme.faint;
                                font-size: Theme.font-small;
                                overflow: elide;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            width: self.preferred-width;
                            y: (parent.height - self.height) / 2;
                            height: self.preferred-height;

                            AppButton {
                                text: "Project page";
                                variant: "ghost";
                                compact: true;
                                clicked => {
                                    Sys.open-url("https://github.com/spacebub/qzdl");
                                }
                            }

                            AppButton {
                                text: "About";
                                compact: true;
                                clicked => {
                                    Sheets.about-open = true;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    bar := Scroller {
        x: parent.width - self.width;
        y: sheet.y;
        height: sheet.height;
        offset: sheet.viewport-y;
        content: sheet.viewport-height;
        room: sheet.height;
        scrolled(to) => {
            sheet.viewport-y = to;
        }
    }
}
