import { Theme } from "../theme.slint";
import { Sys, Cfg } from "../state.slint";
import { Sheets } from "../sheets.slint";
import { Sheet } from "../components/sheet.slint";
import { SectionLabel } from "../components/section-label.slint";
import { PathLabel } from "../components/path-label.slint";
import { GlyphButton } from "../components/glyph-button.slint";
import { AppButton } from "../components/app-button.slint";

// Who wrote this, what it is built on, and where its config file lives.
export component AboutSheet inherits Sheet {
    open: Sheets.about-open;
    card-width: 520px;
    card-height: content.preferred-height + 44px;

    dismissed => {
        Sheets.about-open = false;
    }

    content := VerticalLayout {
        x: 22px;
        y: 22px;
        width: root.room-width - 44px;
        spacing: 16px;
        alignment: start;

        HorizontalLayout {
            spacing: 14px;

            Image {
                width: 56px;
                height: 56px;
                y: (parent.height - self.height) / 2;
                source: @image-url("../../../../assets/qzdl-128.png");
            }

            VerticalLayout {
                spacing: 2px;
                y: (parent.height - self.height) / 2;
                height: self.preferred-height;

                Text {
                    text: "ZDL";
                    color: Theme.text;
                    font-size: Theme.font-display;
                    font-weight: Theme.heading-weight;
                }

                Text {
                    text: "Version " + Sys.version + " · " + Sys.runtime;
                    color: Theme.faint;
                    font-size: Theme.font-small;
                }

                Text {
                    text: "A launcher for ZDoom based Doom engine source ports.";
                    color: Theme.muted;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }
            }

            GlyphButton {
                y: (parent.height - self.height) / 2;
                glyph: "cross";
                size: 26px;
                clicked => {
                    Sheets.about-open = false;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        VerticalLayout {
            spacing: 3px;

            SectionLabel { text: "COPYRIGHT"; }

            for line in ["© 2023-2026 spacebub",
                         "© 2018-2019 Lcferrum",
                         "© 2004-2012 ZDL Software Foundation"] : Text {
                text: line;
                color: Theme.muted;
                font-size: Theme.font-small;
            }
        }

        VerticalLayout {
            spacing: 3px;

            SectionLabel { text: "THANKS"; }

            Text {
                text: "BioHazard, for the original version. NeuralStunner, without whose help "
                    + "none of this would be possible. Blzut3, Risen, Enjay, DRDTeam.org and "
                    + "ZDoom.org.";
                color: Theme.muted;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            spacing: 4px;

            SectionLabel { text: "CONFIGURATION FILE"; }

            PathLabel {
                path: Cfg.path;
                room: content.width;
                clickable: true;
                opens: Sys.directory-of(Cfg.path);
                font-size: Theme.font-small;
            }
        }

        HorizontalLayout {
            height: Theme.control-small;

            AppButton {
                text: "Project page";
                variant: "ghost";
                compact: true;
                clicked => {
                    Sys.open-url("https://github.com/spacebub/qzdl");
                }
            }

            Rectangle { }

            AppButton {
                text: "Close";
                variant: "primary";
                compact: true;
                clicked => {
                    Sheets.about-open = false;
                }
            }
        }
    }
}
