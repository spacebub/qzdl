import { Theme } from "../theme.slint";

// A folder or a page, drawn rather than themed.
export component FileGlyph {
    in property <bool> folder: false;
    in property <color> tone: root.folder ? Theme.accent : Theme.faint;

    property <float> weight: 1.2;

    width: 15px * root.weight;
    height: 15px * root.weight;

    if root.folder : Path {
        viewbox-width: 15;
        viewbox-height: 15;
        commands: "M 1 4 L 5.5 4 L 7 5.8 L 14 5.8 L 14 13 L 1 13 Z";
        fill: root.tone.with-alpha(0.85);
    }

    if !root.folder : Path {
        viewbox-width: 15;
        viewbox-height: 15;
        commands: "M 3 1.5 L 9.5 1.5 L 12.5 4.8 L 12.5 13.5 L 3 13.5 Z M 9.3 1.7 L 9.3 5 L 12.3 5";
        stroke: root.tone;
        stroke-width: 1.2px * root.weight;
        stroke-line-join: round;
    }
}
