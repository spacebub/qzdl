import { ListView } from "std-widgets.slint";

import { Theme } from "../theme.slint";
import { Glyph } from "glyph.slint";
import { SectionLabel } from "section-label.slint";
import { Wash } from "wash.slint";
import { Metrics } from "metrics.slint";
import { Scroller } from "scroller.slint";
import { Tip } from "tips.slint";
import { Veil } from "veil.slint";

// One of a list of things -- a skill, a map, a game type. All the same control, so
// the launch page reads as one page. The list opens over what is under it rather
// than pushing the page about, and scrolls past a point.
export component Picker {
    in property <[string]> options;
    in property <int> current: -1;

    // A word against an option, in the options' own order. Short of the list, or an
    // empty string in it, is an option with nothing to add.
    in property <[string]> badges;

    // Nothing picked means "leave it to the port", which is worth saying.
    in property <string> placeholder: "(Default)";
    in property <string> label;
    in property <string> hint;
    in property <bool> enabled: true;

    in property <bool> clearable: false;

    callback selected(int);

    property <string> current-text: root.current >= 0 && root.current < root.options.length
        ? root.options[root.current] : "";
    property <string> current-badge: root.current >= 0 && root.current < root.badges.length
        ? root.badges[root.current] : "";

    property <int> shift: root.clearable ? 1 : 0;
    property <int> rows: min(root.options.length + root.shift, 9);
    property <length> list-height: max(44px, root.rows * 32px + 10px);
    property <bool> open: list.is-open;

    min-width: 200px;
    min-height: column.preferred-height;
    preferred-height: self.min-height;
    opacity: root.enabled ? 1 : 0.45;

    column := VerticalLayout {
        spacing: 6px;

        if root.label != "" : SectionLabel {
            text: root.label.to-uppercase();
        }

        box := Rectangle {
            height: Theme.control;
            border-radius: Theme.radius-small;
            background: area.pressed ? Theme.sunken : Theme.field;
            border-width: 1px;
            border-color: root.open ? Theme.accent
                : area.has-hover ? Theme.border-strong
                : Theme.border;

            animate background, border-color { duration: 110ms; }

            Rectangle {
                border-radius: parent.border-radius;
                background: Theme.hover;
                opacity: area.has-hover && !area.pressed ? 1 : 0;

                animate opacity { duration: 110ms; }
            }

            Text {
                x: 12px;
                y: (parent.height - self.height) / 2;
                width: parent.width - 12px - (tag.width > 0 ? tag.width + 8px : 0px) - 32px;
                text: root.current-text == "" ? root.placeholder : root.current-text;
                color: root.current-text == "" ? Theme.faint : Theme.text;
                font-size: Theme.font-body;
                overflow: elide;
            }

            tag := Text {
                x: parent.width - 32px - self.width - (self.width > 0 ? 8px : 0px);
                y: (parent.height - self.height) / 2;
                width: root.current-badge == "" ? 0px : self.preferred-width;
                text: root.current-badge;
                color: Theme.faint;
                font-size: Theme.font-tiny;
                font-weight: 600;
            }

            Glyph {
                x: parent.width - 12px - self.width;
                y: (parent.height - self.height) / 2;
                name: "down";
                weight: 1;
                tone: root.open ? Theme.accent : Theme.faint;
                turn: root.open ? 180deg : 0deg;

                animate turn { duration: 160ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
            }

            area := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => {
                    list.show();
                }
            }

            // Over the pointer, not the middle of something as wide as the page.
            Tip {
                text: root.open ? "" : root.hint;
                over: area.has-hover;
                at: area.mouse-x;
            }

            list := PopupWindow {
                // Below the box, or above it when there is no room: left to itself
                // a popup slides up until it fits, over the value it would change.
                x: 0;
                y: box.absolute-position.y + box.height + 4px + root.list-height
                        <= Metrics.window-height
                    ? box.height + 4px
                    : -root.list-height - 4px;
                width: box.width;
                height: root.list-height;
                close-policy: close-on-click-outside;

                veil := Veil {
                    dismissed => {
                        list.close();
                    }

                    Rectangle {
                        background: Theme.raised;
                        border-radius: Theme.radius-small;
                        border-width: 1px;
                        border-color: Theme.border-strong;
                    }

                    rows := ListView {
                        x: 5px;
                        y: 5px;
                        width: parent.width - 10px - (bar.visible ? bar.width + 2px : 0px);
                        height: parent.height - 10px;
                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                        init => {
                            // Opened on whatever is picked rather than at the top.
                            self.viewport-y = -clamp((root.current + root.shift) * 32px
                                                     - self.height + 32px,
                                                     0px,
                                                     max(0px, self.viewport-height - self.height));
                        }

                        for index in root.options.length + root.shift : Rectangle {
                            height: 32px;

                            property <int> at: index - root.shift;
                            property <string> option: at < 0 ? root.placeholder : root.options[at];
                            property <bool> picked: at == root.current;
                            property <string> badge: at >= 0 && at < root.badges.length
                                ? root.badges[at] : "";

                            Wash {
                                selected: picked;
                                hovered: hover.has-hover;
                            }

                            Text {
                                x: 10px;
                                y: (parent.height - self.height) / 2;
                                width: parent.width - 20px
                                       - (flag.width > 0 ? flag.width + 10px : 0px);
                                text: option;
                                color: picked ? Theme.accent
                                    : index < root.shift ? Theme.faint
                                    : Theme.text;
                                font-size: Theme.font-body;
                                font-weight: picked ? 600 : 400;
                                overflow: elide;
                            }

                            flag := Text {
                                x: parent.width - 10px - self.width;
                                y: (parent.height - self.height) / 2;
                                width: badge == "" ? 0px : self.preferred-width;
                                text: badge;
                                color: picked ? Theme.accent : Theme.faint;
                                font-size: Theme.font-tiny;
                                font-weight: 600;
                            }

                            hover := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.selected(index - root.shift);
                                    veil.dismiss();
                                }
                            }
                        }
                    }

                    bar := Scroller {
                        x: parent.width - self.width - 4px;
                        y: 5px;
                        height: parent.height - 10px;
                        offset: rows.viewport-y;
                        content: rows.viewport-height;
                        room: rows.height;
                        scrolled(to) => {
                            rows.viewport-y = to;
                        }
                    }
                }
            }
        }
    }
}
