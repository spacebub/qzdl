import { Theme } from "../theme.slint";
import { SectionLabel } from "section-label.slint";
import { PathLabel } from "path-label.slint";
import { Tip } from "tips.slint";

export component Fact {
    in property <string> label;
    in property <string> value;
    in property <bool> path: false;
    in property <bool> clickable: false;
    in property <string> hint;
    in property <length> room: 320px;

    // What a click opens; the value when empty.
    in property <string> opens;

    callback activated();

    min-height: column.preferred-height;
    preferred-height: self.min-height;
    preferred-width: root.room;

    column := VerticalLayout {
        spacing: 3px;
        alignment: start;

        SectionLabel {
            text: root.label.to-uppercase();
        }

        Rectangle {
            width: root.path ? root.room
                : min(plain.preferred-width, root.room);
            height: root.path ? shown.preferred-height : plain.preferred-height;
            background: transparent;

            shown := PathLabel {
                visible: root.path;
                width: parent.width;
                room: root.room;
                path: root.value;
                color: root.clickable && reach.has-hover ? Theme.accent : Theme.text;
                font-size: Theme.font-body;
                font-weight: 600;
                clickable: root.clickable;
                opens: root.opens;

                hint: self.trimmed && root.hint != ""
                    ? self.pretty + "\n" + root.hint
                    : root.hint;
            }

            plain := Text {
                visible: !root.path;
                width: parent.width;
                text: root.value;
                color: root.clickable && reach.has-hover ? Theme.accent : Theme.text;
                font-size: Theme.font-body;
                font-weight: 600;
                overflow: elide;

                animate color { duration: 120ms; }
            }

            reach := TouchArea {
                enabled: root.clickable && !root.path;
                mouse-cursor: pointer;
                clicked => {
                    root.activated();
                }
            }

            Tip {
                text: root.path ? "" : root.hint;
                over: reach.has-hover;
                at: reach.mouse-x;
            }
        }
    }
}
