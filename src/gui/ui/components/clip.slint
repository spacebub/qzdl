// Slint hands no clipboard to C++, so an undrawn text box copies itself. The
// count makes repeat copies of the same text distinct.
export global Clip {
    out property <string> text;
    out property <int> asked;

    public function copy(value: string) {
        self.text = value;
        self.asked += 1;
    }
}

export component ClipBoard {
    property <int> asked: Clip.asked;

    width: 0;
    height: 0;

    changed asked => {
        box.text = Clip.text;
        box.select-all();
        box.copy();
    }

    box := TextInput {
        width: 0;
        height: 0;
        opacity: 0;
    }
}
