import { Theme } from "../theme.slint";

// One piece of a path, clickable.
export component Crumb {
    in property <string> label;
    in property <bool> last: false;

    callback activated();

    width: label.preferred-width + 14px;

    Rectangle {
        y: 3px;
        height: parent.height - 6px;
        border-radius: Theme.radius-small - 2px;
        background: area.has-hover ? Theme.hover : Theme.hover.with-alpha(0);

        animate background { duration: 100ms; }
    }

    label := Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: root.last ? Theme.text : area.has-hover ? Theme.accent : Theme.muted;
        font-size: Theme.font-small;
        font-family: Theme.mono;
        font-weight: root.last ? 600 : 400;
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}
