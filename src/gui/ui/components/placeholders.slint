import { Theme } from "../theme.slint";
import { Tip } from "tips.slint";

// Set after the word before, wrapping to the next row. A comma rides with its link.
component Word inherits Rectangle {
    in property <string> word;
    in property <string> tail;
    in property <string> about;
    in property <bool> link: true;

    in property <length> at-x;
    in property <length> at-y;
    in property <length> room;
    in property <length> step;

    out property <length> next-x: root.x + root.width + 4px;
    out property <length> next-y: root.y;

    property <length> word-width: label.preferred-width;
    property <bool> wraps: root.at-x > 0 && root.at-x + root.width > root.room;

    x: root.wraps ? 0 : root.at-x;
    y: root.wraps ? root.at-y + root.step + 5px : root.at-y;
    width: root.word-width + comma.preferred-width;
    height: root.step;

    label := Text {
        x: 0;
        y: 0;
        height: root.step;
        vertical-alignment: center;
        text: root.word;
        color: !root.link ? Theme.faint
            : touch.has-hover ? Theme.accent : Theme.accent.mix(Theme.faint, 60%);
        font-size: Theme.font-small;
        font-family: root.link ? Theme.mono : "";

        animate color { duration: 90ms; }
    }

    comma := Text {
        x: root.word-width;
        y: 0;
        height: root.step;
        vertical-alignment: center;
        text: root.tail;
        color: Theme.faint;
        font-size: Theme.font-small;
    }

    // The word alone, so the tip excludes the comma.
    hot := Rectangle {
        x: 0;
        y: 0;
        width: root.word-width;
        height: parent.height;

        touch := TouchArea {
            enabled: root.link;
            mouse-cursor: help;
        }

        Tip {
            text: root.about;
            over: touch.has-hover;
            at: touch.mouse-x;
        }
    }
}

export component Placeholders inherits Rectangle {
    // Handed in: the height follows from the wrapping, so a layout cannot supply it.
    in property <length> room;

    // Mono and prose measure differently; the taller sets the line.
    property <length> step: max(spelled.preferred-height, said.preferred-height);

    spelled := Text {
        visible: false;
        text: "Xg";
        font-size: Theme.font-small;
        font-family: Theme.mono;
    }

    said := Text {
        visible: false;
        text: "Xg";
        font-size: Theme.font-small;
    }

    preferred-height: replaydir.y + replaydir.height;
    min-height: self.preferred-height;
    vertical-stretch: 0;

    lead := Word {
        word: "Supported placeholders:";
        link: false;
        at-x: 0;
        at-y: 0;
        room: root.room;
        step: root.step;
    }

    port := Word {
        word: "{source_port}";
        tail: ",";
        about: "The source port this profile is set to.";
        at-x: lead.next-x;
        at-y: lead.next-y;
        room: root.room;
        step: root.step;
    }

    game := Word {
        word: "{game}";
        tail: ",";
        about: "The game this profile is set to.";
        at-x: port.next-x;
        at-y: port.next-y;
        room: root.room;
        step: root.step;
    }

    addons := Word {
        word: "{addon_n}";
        tail: ",";
        about: "An add-on from the list, counting from one. A number the profile "
            + "does not have stops the launch.";
        at-x: game.next-x;
        at-y: game.next-y;
        room: root.room;
        step: root.step;
    }

    profile := Word {
        word: "{profile}";
        tail: ",";
        about: "The profile's own folder, which the next few sit in.";
        at-x: addons.next-x;
        at-y: addons.next-y;
        room: root.room;
        step: root.step;
    }

    cfgdir := Word {
        word: "{cfgdir}";
        tail: ",";
        about: "The port config written for this profile.";
        at-x: profile.next-x;
        at-y: profile.next-y;
        room: root.room;
        step: root.step;
    }

    extracfg := Word {
        word: "{extracfg}";
        tail: ",";
        about: "The second config a vanilla port keeps, named after the first "
            + "with -extra on it. Only Chocolate Doom and its like are handed one.";
        at-x: cfgdir.next-x;
        at-y: cfgdir.next-y;
        room: root.room;
        step: root.step;
    }

    savedir := Word {
        word: "{savedir}";
        tail: ",";
        about: "The profile's saves folder, inside {profile}.";
        at-x: extracfg.next-x;
        at-y: extracfg.next-y;
        room: root.room;
        step: root.step;
    }

    savefile := Word {
        word: "{savefile}";
        tail: ",";
        about: "The save this profile is set to load. A profile with none picked "
            + "stops the launch.";
        at-x: savedir.next-x;
        at-y: savedir.next-y;
        room: root.room;
        step: root.step;
    }

    replaydir := Word {
        word: "{replaydir}";
        about: "The profile's replays folder, inside {profile}.";
        at-x: savefile.next-x;
        at-y: savefile.next-y;
        room: root.room;
        step: root.step;
    }
}
