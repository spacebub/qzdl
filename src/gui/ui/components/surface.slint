import { Theme } from "../theme.slint";

// The one card in the interface: a flat panel with a hairline border.
export component Surface inherits Rectangle {
    in property <bool> inset: false;
    in property <bool> hoverable: false;
    in property <bool> hovered: false;

    background: root.inset ? Theme.sunken : Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.hovered ? Theme.border-strong : Theme.border;

    animate border-color, background { duration: 120ms; }

    // A border alone is easy to miss on something this large. Behind whatever the
    // panel is given, which comes after it.
    Rectangle {
        border-radius: root.border-radius;
        background: Theme.hover;
        opacity: root.hoverable && root.hovered ? 1 : 0;

        animate opacity { duration: 120ms; }
    }

    @children
}
