import { Theme } from "../theme.slint";
import { Glyph } from "glyph.slint";
import { GlyphButton } from "glyph-button.slint";
import { SectionLabel } from "section-label.slint";
import { Pill } from "pill.slint";
import { AppButton } from "app-button.slint";

// A labelled text field, optionally with a button at its right edge.
export component Field {
    in property <string> label;
    in property <string> placeholder;
    in property <string> text;
    in property <string> action;
    in property <string> prefix;
    in property <string> icon;
    in property <bool> read-only: false;

    // A mark inside the left of the box; drawn, not pressed.
    in property <string> leading;
    in property <string> icon-hint;
    in property <string> hint;
    in property <bool> mono: false;

    // Level with the label at the right edge: so far, where the value came from.
    in property <string> badge;
    in property <color> badge-tone: Theme.muted;
    in property <color> badge-wash: Theme.muted-soft;

    callback edited(string);
    callback action-triggered();
    callback accepted();

    public function take-focus() {
        input.focus();
        input.select-all();
    }

    // Pushed in rather than bound: the first keystroke breaks a binding, and the
    // field would then keep showing what was typed into a profile since left.
    changed text => {
        input.text = root.text;
    }

    init => {
        input.text = root.text;
    }

    min-width: 240px;
    min-height: column.preferred-height;
    preferred-height: self.min-height;

    column := VerticalLayout {
        spacing: 6px;

        if root.label != "" || root.badge != "" : HorizontalLayout {
            height: max(caption.preferred-height, root.badge == "" ? 0px : 22px);

            caption := SectionLabel {
                text: root.label.to-uppercase();
                vertical-alignment: center;
            }

            Rectangle { }

            if root.badge != "" : Pill {
                height: 22px;
                text: root.badge;
                tone: root.badge-tone;
                wash: root.badge-wash;
            }
        }

        HorizontalLayout {
            spacing: 8px;

            box := Rectangle {
                height: Theme.control;
                border-radius: Theme.radius-small;
                background: Theme.field;
                border-width: 1px;
                border-color: input.has-focus ? Theme.accent : Theme.border-strong;

                animate border-color { duration: 120ms; }

                mark := Glyph {
                    x: 12px;
                    y: (parent.height - self.height) / 2;
                    width: root.leading == "" ? 0px : 12px * self.weight;
                    name: root.leading;
                    weight: 1.1;
                    tone: input.has-focus ? Theme.accent : Theme.faint;
                }

                fixed := Text {
                    x: root.leading == "" ? 12px : mark.x + mark.width + 9px;
                    y: (parent.height - self.height) / 2;
                    width: root.prefix == "" ? 0px : self.preferred-width;
                    text: root.prefix;
                    color: Theme.faint;
                    font-size: Theme.font-body;
                    font-family: Theme.mono;
                }

                // A rule between the fixed part and the typed one: run together
                // there is no telling where one ends.
                if root.prefix != "" : Rectangle {
                    x: fixed.x + fixed.width + 9px;
                    width: 1px;
                    height: parent.height - 12px;
                    y: 6px;
                    background: Theme.border-strong;
                }

                property <length> left-inset: root.prefix != "" ? fixed.x + fixed.width + 19px
                    : root.leading != "" ? mark.x + mark.width + 9px
                    : 12px;

                property <length> right-inset: root.icon == "" ? 12px : 42px;

                if input.text == "" : Text {
                    x: box.left-inset;
                    y: (parent.height - self.height) / 2;
                    width: parent.width - box.left-inset - box.right-inset;
                    text: root.placeholder;
                    color: Theme.faint;
                    font-size: Theme.font-body;
                    font-family: root.mono ? Theme.mono : "";
                    overflow: elide;
                }

                // The line is as wide as it needs to be and slides under this,
                // so a value longer than the box scrolls with the cursor instead
                // of being selected out in the open past its edge.
                slot := Rectangle {
                    x: box.left-inset;
                    y: 0;
                    width: parent.width - box.left-inset - box.right-inset;
                    height: parent.height;
                    clip: true;

                    input := TextInput {
                        property <length> shift;

                        x: min(0px, max(parent.width - self.width - self.text-cursor-width,
                            self.shift));
                        y: 0;
                        width: max(parent.width - self.text-cursor-width, self.preferred-width);
                        height: parent.height;
                        vertical-alignment: center;
                        single-line: true;
                        read-only: root.read-only;
                        color: Theme.text;
                        selection-background-color: Theme.accent;
                        selection-foreground-color: Theme.accent-text;
                        font-size: Theme.font-body;
                        font-family: root.mono ? Theme.mono : "";

                        cursor-position-changed(at) => {
                            if at.x + self.shift < 0 {
                                self.shift = -at.x;
                            } else if at.x + self.shift
                                > parent.width - self.text-cursor-width {
                                self.shift = parent.width - at.x - self.text-cursor-width;
                            }
                        }

                        edited => {
                            root.edited(self.text);
                        }

                        accepted => {
                            root.accepted();
                        }
                    }
                }

                if root.icon != "" : GlyphButton {
                    x: parent.width - self.width - 4px;
                    y: (parent.height - self.height) / 2;
                    glyph: root.icon;
                    size: 30px;
                    hint: root.icon-hint;
                    clicked => {
                        root.action-triggered();
                    }
                }
            }

            if root.action != "" : AppButton {
                text: root.action;
                compact: true;
                y: (parent.height - self.height) / 2;
                clicked => {
                    root.action-triggered();
                }
            }
        }

        if root.hint != "" : Text {
            text: root.hint;
            color: Theme.faint;
            font-size: Theme.font-small;
            wrap: word-wrap;
            overflow: elide;
        }
    }
}
