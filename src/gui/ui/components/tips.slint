import { Theme } from "../theme.slint";

// One tooltip for the window; only the hovered control's is ever shown.
export global Tips {
    // Empty is nothing hovered.
    out property <string> pending;
    out property <length> px;
    out property <length> top;
    out property <length> bottom;

    in-out property <bool> shown;

    public function arm(text: string, x: length, above: length, below: length) {
        if (text == "") {
            return;
        }

        self.pending = text;
        self.px = x;
        self.top = above;
        self.bottom = below;
    }

    // Guarded, so a control leaving late does not take the new one down.
    public function clear(text: string) {
        if (self.pending == text) {
            self.pending = "";
            self.shown = false;
        }
    }
}

// at is where the pointer came in, since a label can be page-wide.
export component Tip {
    in property <string> text;
    in property <bool> over;
    in property <length> at: -1px;

    // Without a base a component shrinks to its contents.
    preferred-width: 100%;
    preferred-height: 100%;

    property <bool> live: root.over && root.text != "";

    // So a label changing under the pointer takes its own words down, not the new.
    property <string> held;

    function hand-over() {
        root.held = root.text;
        Tips.arm(root.text,
                 root.absolute-position.x + (root.at < 0 ? root.width / 2 : root.at),
                 root.absolute-position.y,
                 root.absolute-position.y + root.height);
    }

    changed live => {
        if (root.live) {
            root.hand-over();
        } else {
            Tips.clear(root.held);
        }
    }

    changed text => {
        if (root.live) {
            Tips.clear(root.held);
            root.hand-over();
        }
    }
}

export component TipLayer {
    property <length> room: 320px;

    property <bool> up: Tips.shown && Tips.pending != "";

    // Held so the words stay put during the fade out.
    property <string> body;
    property <length> px;
    property <length> top;
    property <length> bottom;

    // Without a base a component shrinks to its contents.
    preferred-width: 100%;
    preferred-height: 100%;

    changed up => {
        if (root.up) {
            root.body = Tips.pending;
            root.px = Tips.px;
            root.top = Tips.top;
            root.bottom = Tips.bottom;
        }
    }

    label := Text {
        visible: false;
        text: root.body;
        font-size: Theme.font-small;
        wrap: word-wrap;
        width: min(root.room, self.preferred-width);
    }

    Timer {
        interval: 450ms;
        running: Tips.pending != "" && !Tips.shown;
        triggered => {
            Tips.shown = true;
        }
    }

    Rectangle {
        width: label.width + 20px;
        height: label.height + 20px;

        // Never off an edge; above what it explains where there is room.
        x: clamp(root.px - self.width / 2, 4px, max(4px, root.width - self.width - 4px));
        y: root.top - self.height - 6px < 4px
            ? root.bottom + 6px
            : root.top - self.height - 6px;

        background: Theme.raised;
        border-radius: Theme.radius-small;
        border-width: 1px;
        border-color: Theme.border-strong;
        opacity: root.up ? 1 : 0;

        animate opacity { duration: 110ms; easing: ease-out-quad; }

        Text {
            x: 10px;
            y: 10px;
            width: label.width;
            text: root.body;
            color: Theme.text;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }
    }
}
