import { Theme } from "../theme.slint";

// Behind a row, a tab or an entry: a tint for the picked one, a lighter wash for
// the hovered one. Two rectangles fading on opacity rather than one changing
// colour, since animating between their very different alphas flashes.
export component Wash {
    in property <bool> selected: false;
    in property <bool> hovered: false;
    in property <color> tint: Theme.accent-soft;
    in property <color> pointer: Theme.hover;
    in property <length> rounding: Theme.radius-small;

    // Slint sizes a base-less component to its contents and centres it; this is a layer.
    preferred-width: 100%;
    preferred-height: 100%;

    Rectangle {
        border-radius: root.rounding;
        background: root.tint;
        opacity: root.selected ? 1 : 0;

        animate opacity { duration: 110ms; }
    }

    Rectangle {
        border-radius: root.rounding;
        background: root.pointer;
        opacity: root.hovered && !root.selected ? 1 : 0;

        animate opacity { duration: 110ms; }
    }
}
