import { Theme } from "../theme.slint";
import { Glyph } from "glyph.slint";
import { Tip } from "tips.slint";

// A small status badge: a dot and a word.
export component Pill inherits Rectangle {
    in property <string> text;

    // Drawn in place of the word.
    in property <string> glyph;

    // What the badge means, for a pointer left on it. A pill saying nothing
    // takes no pointer at all, so what is under it still gets the press.
    in property <string> hint;

    // muted | warning | danger. A tone or wash set on its own wins over it.
    in property <string> kind;

    in property <color> tone: root.kind == "warning" ? Theme.warning
        : root.kind == "danger" ? Theme.danger
        : root.kind == "muted" ? Theme.muted
        : Theme.accent;

    in property <color> wash: root.kind == "warning" ? Theme.warning-soft
        : root.kind == "danger" ? Theme.danger-soft
        : root.kind == "muted" ? Theme.muted-soft
        : Theme.accent-soft;

    in property <bool> dot: true;

    // A hue light enough for the dark shade is too close to its own tint in the
    // light one, so there it is taken down until it reads.
    property <color> ink: Theme.dark ? root.tone : root.tone.darker(0.35);

    min-width: row.preferred-width + 22px;
    height: 26px;

    // As wide as the word: a badge is never what a row hands its spare width to.
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    background: root.wash;

    // The tint alone does not always separate the pill from what it sits on: the
    // neutral one is the wash an inset card is painted in.
    border-width: 1px;
    border-color: root.ink.with-alpha(0.3);

    row := HorizontalLayout {
        alignment: center;
        spacing: 6px;

        if root.dot : Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.ink;
            y: (parent.height - self.height) / 2;
        }

        if root.glyph != "" : Glyph {
            name: root.glyph;
            tone: root.ink;
            weight: 1.4;
            y: (parent.height - self.height) / 2;
        }

        if root.glyph == "" : Text {
            text: root.text;
            color: root.ink;
            font-size: Theme.font-small;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    // Only where there is something to say: a TouchArea is opaque to the press,
    // and a badge often sits on something that wants one of its own.
    if root.hint != "" : Rectangle {
        reach := TouchArea { }

        Tip {
            text: root.hint;
            over: reach.has-hover;
        }
    }
}
