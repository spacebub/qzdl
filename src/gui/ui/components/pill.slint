import { Theme } from "../theme.slint";
import { Glyph } from "glyph.slint";
import { Tip } from "tips.slint";

export component Pill inherits Rectangle {
    in property <string> text;

    // Drawn in place of the word.
    in property <string> glyph;

    // Without one the pill takes no pointer, so what is under it gets the press.
    in property <string> hint;

    // muted | warning | danger. An explicit tone or wash wins over it.
    in property <string> kind;

    in property <color> tone: root.kind == "warning" ? Theme.warning
        : root.kind == "danger" ? Theme.danger
        : root.kind == "muted" ? Theme.muted
        : Theme.accent;

    in property <color> wash: root.kind == "warning" ? Theme.warning-soft
        : root.kind == "danger" ? Theme.danger-soft
        : root.kind == "muted" ? Theme.muted-soft
        : Theme.accent-soft;

    in property <bool> dot: true;

    // Darkened in the light shade to read against its own tint.
    property <color> ink: Theme.dark ? root.tone : root.tone.darker(0.35);

    min-width: row.preferred-width + 22px;
    height: 26px;

    horizontal-stretch: 0;
    border-radius: self.height / 2;
    background: root.wash;

    border-width: 1px;
    border-color: root.ink.with-alpha(0.3);

    row := HorizontalLayout {
        alignment: center;
        spacing: 6px;

        if root.dot : Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.ink;
            y: (parent.height - self.height) / 2;
        }

        if root.glyph != "" : Glyph {
            name: root.glyph;
            tone: root.ink;
            weight: 1.4;
            y: (parent.height - self.height) / 2;
        }

        if root.glyph == "" : Text {
            text: root.text;
            color: root.ink;
            font-size: Theme.font-small;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    if root.hint != "" : Rectangle {
        reach := TouchArea { }

        Tip {
            text: root.hint;
            over: reach.has-hover;
        }
    }
}
