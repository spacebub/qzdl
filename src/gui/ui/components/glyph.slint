import { Theme } from "../theme.slint";

// Every icon the interface draws, drawn rather than typed so none depends on what
// the system font carries. Each is laid out in the square it was designed in and
// scaled on the way out; only the one asked for is built.
export component Glyph {
    // close | minimize | maximize | restore | refresh | plus | cross
    // download | save | extract | trash | edit | folder | up | down | check
    // system | light | dark | cog | play | dots | search | grip
    // terminal | minus | copy
    in property <string> name;
    in property <color> tone: Theme.muted;
    in property <float> weight: 1.2;
    in property <angle> turn: 0deg;

    width: 12px * root.weight;
    height: 12px * root.weight;

    // The square it was laid out in; zero for the ones built out of rectangles.
    property <float> box:
          root.name == "search" ? 12
        : root.name == "up" || root.name == "down" || root.name == "refresh"
            || root.name == "play" ? 13
        : root.name == "download" || root.name == "save" || root.name == "extract"
            || root.name == "trash"
            || root.name == "edit" || root.name == "folder" || root.name == "system"
            || root.name == "light" || root.name == "dark" || root.name == "check"
            || root.name == "cog" || root.name == "terminal" || root.name == "copy" ? 14
        : 0;

    // Outline weight, in the units the icon was drawn in.
    property <float> pen:
          root.name == "check" ? 1.8
        : root.name == "download" || root.name == "up" || root.name == "down"
            || root.name == "refresh" ? 1.6
        : root.name == "terminal" ? 1.4
        : 1.5;

    property <string> outline:
          root.name == "search"
            ? "M 8.25 4.75 A 3.5 3.5 0 1 1 1.25 4.75 A 3.5 3.5 0 1 1 8.25 4.75 M 7.6 9.15 L 10.71 12.26"
        : root.name == "download"
            ? "M 7 1 L 7 9.5 M 3.2 6 L 7 9.8 L 10.8 6 M 2 12.6 L 12 12.6"
        : root.name == "save"
            ? "M 1.8 2.2 L 9.2 2.2 L 12.2 5.2 L 12.2 11.8 L 1.8 11.8 Z M 4.4 2.2 L 4.4 5.6 L 8.8 5.6 L 8.8 2.2 M 4 11.8 L 4 8.2 L 10 8.2 L 10 11.8"
        : root.name == "extract"
            ? "M 6.5 1.5 L 1.5 1.5 L 1.5 12.5 L 6.5 12.5 M 5 7 L 12.5 7 M 9.2 3.8 L 12.6 7 L 9.2 10.2"
        : root.name == "trash"
            ? "M 1.5 3.5 L 12.5 3.5 M 5.2 3.3 L 5.2 1.6 L 8.8 1.6 L 8.8 3.3 M 3 3.8 L 3.7 12.6 L 10.3 12.6 L 11 3.8 M 5.8 6 L 6 10.4 M 8.2 6 L 8 10.4"
        : root.name == "edit"
            ? "M 2 12 L 2 9.4 L 9.4 2 L 12 4.6 L 4.6 12 Z"
        : root.name == "up"
            ? "M 6.5 12 L 6.5 1.8 M 2 6.2 L 6.5 1.8 L 11 6.2"
        : root.name == "down"
            ? "M 6.5 1.8 L 6.5 12 M 2 7.6 L 6.5 12 L 11 7.6"
        : root.name == "system"
            ? "M 11.9 7 A 4.9 4.9 0 1 1 2.1 7 A 4.9 4.9 0 1 1 11.9 7"
        : root.name == "light"
            ? "M 10 7 A 3 3 0 1 1 4 7 A 3 3 0 1 1 10 7 M 11.8 7 L 13.3 7 M 10.394 10.394 L 11.455 11.455 M 7 11.8 L 7 13.3 M 3.606 10.394 L 2.545 11.455 M 2.2 7 L 0.7 7 M 3.606 3.606 L 2.545 2.545 M 7 2.2 L 7 0.7 M 10.394 3.606 L 11.455 2.545"
        : root.name == "dark"
            ? "M 8.98 2.41 A 5 5 0 1 1 2.41 8.98 A 5 5 0 0 0 8.98 2.41 Z"
        : root.name == "check"
            ? "M 2 7.4 L 5.6 11 L 12 3.2"
        : root.name == "refresh"
            ? "M 8.77 10.955 A 5 5 0 1 1 10.955 4.23"
        : root.name == "cog"
            ? "M 10.9 7 A 3.9 3.9 0 1 1 3.1 7 A 3.9 3.9 0 1 1 10.9 7 M 10.9 7 L 13.2 7 M 9.758 9.758 L 11.384 11.384 M 7 10.9 L 7 13.2 M 4.242 9.758 L 2.616 11.384 M 3.1 7 L 0.8 7 M 4.242 4.242 L 2.616 2.616 M 7 3.1 L 7 0.8 M 9.758 4.242 L 11.384 2.616"
        : root.name == "terminal"
            ? "M 3 2 L 11 2 A 2 2 0 0 1 13 4 L 13 10 A 2 2 0 0 1 11 12 L 3 12 A 2 2 0 0 1 1 10 L 1 4 A 2 2 0 0 1 3 2 Z M 3.6 5.6 L 5.8 7.4 L 3.6 9.2 M 7.4 9.4 L 10.6 9.4"
        : root.name == "copy"
            ? "M 5.2 5.2 L 12.6 5.2 L 12.6 12.6 L 5.2 12.6 Z M 8.8 4.6 L 8.8 1.4 L 1.4 1.4 L 1.4 8.8 L 4.6 8.8"
        : "";

    property <string> solid:
          root.name == "folder"
            ? "M 1 3.5 L 5.5 3.5 L 7 5.4 L 13 5.4 L 13 12 L 1 12 Z"
        : root.name == "play"
            ? "M 3.4 1.6 L 11.6 6.5 L 3.4 11.4 Z"
        : root.name == "system"
            ? "M 7 11.9 A 4.9 4.9 0 0 1 7 2.1 Z"
        : root.name == "refresh"
            ? "M 9.8 1.6 L 10.6 5.4 L 6.9 4.4 Z"
        : "";

    property <float> solid-box: root.name == "folder" ? 14 : 13;

    // The same bar either way.
    if root.name == "minimize" || root.name == "minus" : Rectangle {
        width: 11px * root.weight;
        height: 1.5px * root.weight;
        border-radius: 1px;
        background: root.tone;
        transform-rotation: root.turn;
    }

    if root.name == "maximize" : Rectangle {
        width: 10px * root.weight;
        height: 10px * root.weight;
        border-radius: 2px;
        background: transparent;
        border-width: 1.5px * root.weight;
        border-color: root.tone;
        transform-rotation: root.turn;
    }

    if root.name == "restore" : Rectangle {
        width: 12px * root.weight;
        height: 12px * root.weight;
        background: transparent;
        transform-rotation: root.turn;

        Rectangle {
            x: 3px * root.weight;
            y: 0;
            width: 9px * root.weight;
            height: 9px * root.weight;
            border-radius: 2px;
            background: transparent;
            border-width: 1.5px * root.weight;
            border-color: root.tone;
        }

        Rectangle {
            x: 0;
            y: 3px * root.weight;
            width: 9px * root.weight;
            height: 9px * root.weight;
            border-radius: 2px;
            background: Theme.surface;
            border-width: 1.5px * root.weight;
            border-color: root.tone;
        }
    }

    if root.name == "close" || root.name == "cross" : Rectangle {
        width: 12px * root.weight;
        height: 12px * root.weight;
        background: transparent;
        transform-rotation: root.turn;

        Rectangle {
            width: 13px * root.weight;
            height: 1.5px * root.weight;
            border-radius: 1px;
            background: root.tone;
            transform-rotation: 45deg;
        }

        Rectangle {
            width: 13px * root.weight;
            height: 1.5px * root.weight;
            border-radius: 1px;
            background: root.tone;
            transform-rotation: -45deg;
        }
    }

    if root.name == "plus" : Rectangle {
        width: 12px * root.weight;
        height: 12px * root.weight;
        background: transparent;
        transform-rotation: root.turn;

        Rectangle {
            width: 12px * root.weight;
            height: 1.6px * root.weight;
            border-radius: 1px;
            background: root.tone;
        }

        Rectangle {
            width: 1.6px * root.weight;
            height: 12px * root.weight;
            border-radius: 1px;
            background: root.tone;
        }
    }

    if root.name == "dots" : HorizontalLayout {
        alignment: center;
        spacing: 2px * root.weight;

        for each in [0, 1, 2] : Rectangle {
            width: 2.6px * root.weight;
            height: 2.6px * root.weight;
            border-radius: self.width / 2;
            background: root.tone;
            y: (parent.height - self.height) / 2;
        }
    }

    // Says a row can be picked up and put down elsewhere.
    if root.name == "grip" : HorizontalLayout {
        alignment: center;
        spacing: 2.6px * root.weight;

        for column in [0, 1] : VerticalLayout {
            alignment: center;
            spacing: 2.6px * root.weight;

            for row in [0, 1, 2] : Rectangle {
                width: 2.2px * root.weight;
                height: 2.2px * root.weight;
                border-radius: self.width / 2;
                background: root.tone;
            }
        }
    }

    if root.outline != "" : Path {
        width: root.box * 1px * root.weight;
        height: root.box * 1px * root.weight;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: root.box;
        viewbox-height: root.box;
        commands: root.outline;
        stroke: root.tone;
        stroke-width: root.pen * 1px * root.weight;
        stroke-line-cap: round;
        stroke-line-join: round;
        transform-rotation: root.turn;
    }

    if root.solid != "" : Path {
        width: root.solid-box * 1px * root.weight;
        height: root.solid-box * 1px * root.weight;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: root.solid-box;
        viewbox-height: root.solid-box;
        commands: root.solid;
        fill: root.name == "folder" ? root.tone.with-alpha(0.9) : root.tone;
        transform-rotation: root.turn;
    }
}
