import { Theme } from "../theme.slint";
import { SectionLabel } from "section-label.slint";
import { GlyphButton } from "glyph-button.slint";
import { Tip } from "tips.slint";

// A small whole number, nudged rather than picked off a list: nine dropdown rows
// are a poor way of saying "four". Stepping below the range clears it.
export component Stepper {
    in property <string> label;
    in property <string> hint;
    in property <int> from: 1;
    in property <int> to: 9;
    in property <int> value: 1;
    in property <bool> enabled: true;

    in property <bool> clearable: false;
    in property <int> off-value: 0;
    in property <string> placeholder: "Off";

    out property <bool> unset: root.clearable && root.value < root.from;

    callback stepped(int);

    function step(by: int) {
        if (root.unset) {
            if (by > 0) {
                root.stepped(root.from);
            }

            return;
        }

        if (root.value + by < root.from) {
            if (root.clearable) {
                root.stepped(root.off-value);
            }
        } else if (root.value + by <= root.to) {
            root.stepped(root.value + by);
        }
    }

    min-width: 170px;
    min-height: column.preferred-height;
    preferred-height: self.min-height;
    opacity: root.enabled ? 1 : 0.45;

    column := VerticalLayout {
        spacing: 6px;

        if root.label != "" : SectionLabel {
            text: root.label.to-uppercase();
        }

        Rectangle {
            height: Theme.control;
            border-radius: Theme.radius-small;
            background: Theme.field;
            border-width: 1px;
            border-color: reach.has-hover ? Theme.border-strong : Theme.border;

            animate border-color { duration: 120ms; }

            reach := TouchArea { }

            GlyphButton {
                x: 4px;
                y: (parent.height - self.height) / 2;
                glyph: "minus";
                size: 30px;
                enabled: root.enabled && !root.unset
                    && (root.clearable || root.value > root.from);
                clicked => {
                    root.step(-1);
                }
            }

            Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: root.unset ? root.placeholder : root.value;
                color: root.unset ? Theme.faint : Theme.text;
                font-size: Theme.font-body;
                font-weight: root.unset ? 400 : 600;
                font-family: root.unset ? "" : Theme.mono;
            }

            GlyphButton {
                x: parent.width - self.width - 4px;
                y: (parent.height - self.height) / 2;
                glyph: "plus";
                size: 30px;
                enabled: root.enabled && (root.unset || root.value < root.to);
                clicked => {
                    root.step(1);
                }
            }

            // Over the pointer, not the middle of something as wide as the page.
            Tip {
                text: root.hint;
                over: reach.has-hover;
                at: reach.mouse-x;
            }
        }
    }
}
