import { Theme } from "../theme.slint";
import { Buzz, Notify } from "../state.slint";
import { Surface } from "surface.slint";
import { GlyphButton } from "glyph-button.slint";

// Anything but an error counts down; hovering holds it.
export component BuzzCard {
    in property <Buzz> message;

    property <color> tone: root.message.severity == 3 ? Theme.danger
        : root.message.severity == 2 ? Theme.warning
        : root.message.severity == 1 ? Theme.success
        : Theme.accent;

    property <color> wash: root.message.severity == 3 ? Theme.danger-soft
        : root.message.severity == 2 ? Theme.warning-soft
        : root.message.severity == 1 ? Theme.success-soft
        : Theme.accent-soft;

    property <int> left: root.message.duration;
    property <duration> step: 250ms;
    property <bool> here: false;
    property <bool> going: false;

    function close() {
        root.going = true;
        exit.running = true;
    }

    width: 392px;
    height: card.height;
    opacity: root.here && !root.going ? 1 : 0;

    animate opacity { duration: 160ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }

    init => {
        root.here = true;
    }

    // Quarter seconds; the bar animates between ticks.
    Timer {
        interval: root.step;
        running: root.message.duration > 0 && !root.going
            && !hover.has-hover && !shut.hovered;
        triggered => {
            root.left -= root.step / 1ms;

            if (root.left <= 0) {
                root.close();
            }
        }
    }

    exit := Timer {
        interval: 170ms;
        running: false;
        triggered => {
            self.running = false;
            Notify.dismiss(root.message.id);
        }
    }

    card := Surface {
        width: parent.width;
        height: layout.preferred-height + 26px;
        clip: true;
        transform-scale: root.here && !root.going ? 1.0 : 0.96;

        animate transform-scale { duration: 160ms; easing: ease-out-back; }

        background: root.wash;
        border-color: root.tone.with-alpha(0.42);

        // Under the rest, or it would take the press meant for the cross.
        hover := TouchArea { }

        layout := VerticalLayout {
            x: 16px;
            y: 13px;
            width: parent.width - 56px;
            spacing: 3px;
            alignment: start;

            if root.message.title != "" : HorizontalLayout {
                spacing: 7px;

                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.tone;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: root.message.title;
                    color: root.tone;
                    font-size: Theme.font-small;
                    font-weight: 700;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                spacing: 7px;

                if root.message.title == "" : Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.tone;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: root.message.body;
                    color: Theme.text;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }
            }
        }

        shut := GlyphButton {
            x: parent.width - self.width - 8px;
            y: 9px;
            glyph: "cross";
            size: 24px;
            tone: Theme.faint;
            hover-tone: Theme.text;
            hover-wash: transparent;
            clicked => {
                root.close();
            }
        }

        if root.message.duration > 0 : Rectangle {
            x: 1px;
            y: parent.height - 4px;
            width: (parent.width - 2px)
                   * clamp(root.left / root.message.duration, 0.0, 1.0);
            height: 3px;
            background: root.tone;

            animate width { duration: root.step; easing: linear; }
        }

    }
}
