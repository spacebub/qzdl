import { Theme } from "../theme.slint";
import { BadgeSpec, MenuRow, Sys } from "../state.slint";
import { CardArt } from "card-art.slint";
import { PlayBadge } from "play-badge.slint";
import { RunPill } from "run-pill.slint";
import { Pill } from "pill.slint";
import { GlyphButton } from "glyph-button.slint";
import { ActionMenu } from "action-menu.slint";
import { Glyph } from "glyph.slint";

// Measures a badge before making it, so one with no room goes under the mark.
component BadgeSlot inherits Rectangle {
    in property <string> text;
    in property <string> kind;
    in property <bool> dot;
    in property <bool> present;

    // Once one is left out the rest are too.
    in property <length> at-x;
    in property <bool> follows: true;
    in property <length> room;

    out property <length> span: root.present
        ? label.preferred-width + (root.dot ? 14px : 0px) + 22px
        : 0px;

    out property <bool> shown: root.present && root.follows
        && root.at-x + root.span <= root.room;
    out property <bool> buried: root.present && !root.shown;
    out property <length> next-x: root.shown ? root.at-x + root.span + 6px : root.at-x;

    x: root.at-x;
    y: 0;
    width: root.shown ? root.span : 0px;
    height: 22px;

    // Measured, never drawn.
    label := Text {
        visible: false;
        text: root.text;
        font-size: Theme.font-small;
        font-weight: 600;
    }

    if root.shown : Pill {
        width: root.span;
        height: parent.height;
        text: root.text;
        dot: root.dot;
        kind: root.kind == "" ? "muted" : root.kind;
    }
}

// The software renderer draws no shadow.
component Cast inherits Rectangle {
    in property <length> spread;
    in property <length> drop;
    in property <length> rounding;

    // Fractions of the blur, outward from the edge.
    property <[float]> steps: [0.50, 0.28, 0.12];

    // Fractions of the shadow's own alpha.
    property <[float]> fades: [0.13, 0.26, 0.45];

    for step[index] in root.steps : Rectangle {
        property <length> out: root.spread * step;

        x: -self.out;
        y: root.drop - self.out;
        width: parent.width + self.out * 2;
        height: parent.height + self.out * 2;
        border-radius: root.rounding + self.out;
        background: Theme.shadow.with-alpha(Theme.shadow.alpha / 255 * root.fades[index]);
    }
}

// A badge that did not fit, flying out of the mark and back.
component BurstPill inherits Rectangle {
    in property <string> text;
    in property <string> kind;
    in property <bool> dot;
    in property <bool> present;
    in property <bool> open;

    in property <length> span;
    in property <length> from-x;
    in property <length> from-y;
    in property <length> to-x;
    in property <length> to-y;

    // For the stagger.
    in property <int> rank;
    in property <int> ranks;

    visible: root.present;
    width: root.span;
    height: 26px;

    x: root.open ? root.to-x : root.from-x;
    y: root.open ? root.to-y : root.from-y;
    opacity: root.open ? 1 : 0;

    transform-scale: root.open ? 1.0 : 0.4;

    animate x, y, opacity, transform-scale {
        duration: 230ms;
        delay: (root.open ? root.rank : root.ranks - 1 - root.rank) * 34ms;
        easing: cubic-bezier(0.22, 1.2, 0.36, 1);
    }

    border-radius: self.height / 2;
    drop-shadow-color: Sys.gpu ? Theme.shadow : transparent;
    drop-shadow-blur: 14px;
    drop-shadow-offset-y: 5px;

    if !Sys.gpu : Cast {
        spread: 14px;
        drop: 5px;
        rounding: root.height / 2;
    }

    Pill {
        width: parent.width;
        height: parent.height;
        text: root.text;
        dot: root.dot;
        kind: root.kind == "" ? "muted" : root.kind;
    }
}

// Both shelves are drawn from this.
export component LibraryCard {
    in property <string> title;
    in property <string> subtitle;
    in property <string> caption;

    in property <string> art-key;

    in property <[BadgeSpec]> badges;

    in property <[MenuRow]> actions;

    in property <string> play-hint;
    in property <bool> playable: true;

    in property <string> status;
    in property <string> status-reason;

    // play | open -- what a click anywhere but the buttons does.
    in property <string> primary: "open";

    in property <bool> draggable: false;
    in property <length> carry-x: 0px;
    in property <length> carry-y: 0px;

    in property <length> rounding: Theme.radius;

    callback played();
    callback opened();
    callback log-requested();
    callback triggered(string);

    // Window coordinates.
    callback pressed();
    callback drag-started(length, length);
    callback drag-moved(length, length);
    callback drag-ended();

    property <bool> claimed: play.hovered || more.hovered || menu.is-open || state.hovered
        || spill.has-hover;
    property <bool> hovered: area.has-hover || root.claimed;

    // Travel before a press counts as a carry.
    property <length> slack: 6px;
    property <length> press-x;
    property <length> press-y;

    // moved only fires while a button is held.
    property <length> glow-x: area.mouse-x;
    property <length> glow-y: area.mouse-y;

    property <bool> dragging;
    property <bool> carried;

    width: Theme.card-width;
    height: Theme.card-art + 94px;

    area := TouchArea {
        mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.pointer;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.carried = false;
                root.dragging = false;
                root.press-x = self.absolute-position.x + self.mouse-x;
                root.press-y = self.absolute-position.y + self.mouse-y;
                root.pressed();
            }

            // A cancelled grab counts as letting go.
            if ((event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel)
                && root.dragging) {
                root.dragging = false;
                root.drag-ended();
            }
        }

        moved => {
            if (!root.draggable) {
                return;
            }

            if (!root.dragging) {
                if (abs(self.absolute-position.x + self.mouse-x - root.press-x) < root.slack
                    && abs(self.absolute-position.y + self.mouse-y - root.press-y) < root.slack) {
                    return;
                }

                root.dragging = true;
                root.carried = true;
                root.drag-started(root.press-x, root.press-y);
            }

            root.drag-moved(self.absolute-position.x + self.mouse-x,
                            self.absolute-position.y + self.mouse-y);
        }

        clicked => {
            if (root.carried) {
                return;
            }

            if (root.primary == "play") {
                root.played();
            } else {
                root.opened();
            }
        }
    }

    property <length> cast-blur: root.hovered ? 34px : 18px;
    property <length> cast-drop: root.hovered ? 14px : 6px;

    // A shadow texture is cached on its blur in a map that never evicts, so the blur is
    // snapped: every distinct value is a texture held for the rest of the session.
    property <length> cast-spread: Math.round(root.cast-blur / 2px) * 2px;

    animate cast-blur, cast-drop {
        duration: 170ms;
        easing: cubic-bezier(0.33, 1, 0.68, 1);
    }

    // Outside the lift, so the card rises off its shadow.
    cast := Rectangle {
        x: root.carry-x;
        y: root.carry-y;
        border-radius: root.rounding;

        drop-shadow-color: Sys.gpu ? Theme.shadow : transparent;
        drop-shadow-blur: root.cast-spread;
        drop-shadow-offset-y: root.cast-drop;

        if !Sys.gpu : Cast {
            spread: root.cast-spread;
            drop: root.cast-drop;
            rounding: root.rounding;
        }
    }

    property <float> rise: area.pressed && !root.dragging ? 0.99 : root.hovered ? 1.02 : 1.0;

    animate rise {
        duration: 170ms;
        easing: cubic-bezier(0.33, 1, 0.68, 1);
    }

    lift := Rectangle {
        // The software renderer draws no transforms, so the rise is a size and costs the
        // hovered card a relayout each frame.
        width: Sys.gpu ? parent.width : parent.width * root.rise;
        height: Sys.gpu ? parent.height : parent.height * root.rise;

        x: root.carry-x - (self.width - parent.width) / 2;
        y: root.carry-y - (self.height - parent.height) / 2;

        transform-scale: Sys.gpu ? root.rise : 1.0;

        face := Rectangle {
            border-radius: root.rounding;
            background: Theme.surface;
            clip: true;
            border-width: 1px;
            border-color: root.hovered ? Theme.border-strong : Theme.border;

            animate border-color { duration: 140ms; }

            art := CardArt {
                // Slint centres an element that sizes itself but not its place.
                y: 0;
                height: Theme.card-art;
                rounding: root.rounding;
                backdrop: Theme.background;
                lit: root.hovered;
                caption: root.caption;
                art-key: root.art-key;

                Rectangle {
                    background: Theme.art-bottom;
                    opacity: root.hovered && root.playable ? 0.35 : 0;

                    animate opacity { duration: 170ms; }
                }

                play := PlayBadge {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    shown: root.hovered && root.playable;
                    active: root.playable;
                    hint: root.play-hint;
                    clicked => {
                        root.played();
                    }
                }

                state := RunPill {
                    x: 10px;
                    y: 10px;
                    status: root.status;
                    reason: root.status-reason;
                    clicked => {
                        root.log-requested();
                    }
                }
            }

            VerticalLayout {
                x: 14px;
                y: art.height + 12px;
                width: parent.width - 28px;
                spacing: 2px;
                alignment: start;

                Text {
                    width: parent.width - 26px;
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.font-medium;
                    font-weight: Theme.heading-weight;
                    overflow: elide;
                }

                if root.subtitle != "" : Text {
                    text: root.subtitle;
                    color: Theme.faint;
                    font-size: Theme.font-small;
                    overflow: elide;
                }
            }

            // Badges that fit are drawn; the rest go under a mark that fans them out.
            row := Rectangle {
                x: 14px;
                y: parent.height - self.height - 12px;
                width: parent.width - 14px - 44px;
                height: 22px;

                property <length> gaps: 6px * max(0, min(root.badges.length, 5) - 1);

                property <bool> crowded: b0.span + b1.span + b2.span + b3.span + b4.span
                    + self.gaps > self.width || root.badges.length > 5;

                // Room for the mark only when a badge is left out.
                property <length> counter: reserve.width + 22px;
                property <length> room: self.crowded ? self.width - self.counter - 6px
                                                     : self.width;

                out property <int> buried: (b0.buried ? 1 : 0) + (b1.buried ? 1 : 0)
                    + (b2.buried ? 1 : 0) + (b3.buried ? 1 : 0) + (b4.buried ? 1 : 0)
                    + max(0, root.badges.length - 5);

                out property <bool> open: spill.has-hover;

                // Offsets run over the badges left out only.
                property <length> off-0: 0px;
                property <length> off-1: self.off-0 + (b0.buried ? b0.span + 6px : 0px);
                property <length> off-2: self.off-1 + (b1.buried ? b1.span + 6px : 0px);
                property <length> off-3: self.off-2 + (b2.buried ? b2.span + 6px : 0px);
                property <length> off-4: self.off-3 + (b3.buried ? b3.span + 6px : 0px);
                property <length> fan: max(0px, self.off-4
                    + (b4.buried ? b4.span + 6px : 0px) - 6px);

                property <int> rank-1: b0.buried ? 1 : 0;
                property <int> rank-2: self.rank-1 + (b1.buried ? 1 : 0);
                property <int> rank-3: self.rank-2 + (b2.buried ? 1 : 0);
                property <int> rank-4: self.rank-3 + (b3.buried ? 1 : 0);

                // In the face's coordinates, pulled back to the card's edge.
                out property <length> mark-x: self.x + b4.next-x;
                out property <length> fan-x: clamp(
                    self.mark-x + self.counter / 2 - self.fan / 2,
                    8px, max(8px, parent.width - self.fan - 8px));

                out property <length> fan-y: self.y - 34px;

                // Measured, never drawn.
                reserve := Glyph {
                    visible: false;
                    name: "dots";
                    weight: 1.4;
                }

                b0 := BadgeSlot {
                    present: root.badges.length > 0;
                    text: root.badges[0].text;
                    kind: root.badges[0].kind;
                    dot: root.badges[0].dot;
                    at-x: 0;
                    room: row.room;
                }

                b1 := BadgeSlot {
                    present: root.badges.length > 1;
                    text: root.badges[1].text;
                    kind: root.badges[1].kind;
                    dot: root.badges[1].dot;
                    at-x: b0.next-x;
                    follows: b0.shown;
                    room: row.room;
                }

                b2 := BadgeSlot {
                    present: root.badges.length > 2;
                    text: root.badges[2].text;
                    kind: root.badges[2].kind;
                    dot: root.badges[2].dot;
                    at-x: b1.next-x;
                    follows: b1.shown;
                    room: row.room;
                }

                b3 := BadgeSlot {
                    present: root.badges.length > 3;
                    text: root.badges[3].text;
                    kind: root.badges[3].kind;
                    dot: root.badges[3].dot;
                    at-x: b2.next-x;
                    follows: b2.shown;
                    room: row.room;
                }

                b4 := BadgeSlot {
                    present: root.badges.length > 4;
                    text: root.badges[4].text;
                    kind: root.badges[4].kind;
                    dot: root.badges[4].dot;
                    at-x: b3.next-x;
                    follows: b3.shown;
                    room: row.room;
                }

                // Sized: an element in a plain rectangle is given all of it.
                if row.buried > 0 : Pill {
                    x: b4.next-x;
                    y: 0;
                    width: row.counter;
                    height: parent.height;
                    glyph: "dots";
                    dot: false;
                }

                // Outside the mark, which comes and goes.
                spill := TouchArea {
                    x: b4.next-x;
                    y: 0;
                    width: row.buried > 0 ? row.counter : 0px;
                    height: parent.height;
                    mouse-cursor: pointer;

                    clicked => {
                        if (root.carried) {
                            return;
                        }

                        if (root.primary == "play") {
                            root.played();
                        } else {
                            root.opened();
                        }
                    }
                }
            }

            // A square under the pointer; a radial gradient is always centred.
            Rectangle {
                property <length> reach: root.width * 0.62;

                x: root.glow-x - self.reach;
                y: root.glow-y - self.reach;
                width: self.reach * 2;
                height: self.reach * 2;
                opacity: root.hovered ? 1 : 0;

                background: @radial-gradient(circle,
                                             #ffffff1c 0%,
                                             #ffffff0a 40%,
                                             #ffffff00 72%);

                animate opacity { duration: 170ms; }
            }

            // Last, so the pointer light is not drawn across them.
            for badge[index] in root.badges : BurstPill {
                present: index == 0 ? b0.buried : index == 1 ? b1.buried
                    : index == 2 ? b2.buried : index == 3 ? b3.buried
                    : index == 4 ? b4.buried : false;

                span: index == 0 ? b0.span : index == 1 ? b1.span
                    : index == 2 ? b2.span : index == 3 ? b3.span
                    : index == 4 ? b4.span : 0px;

                rank: index == 0 ? 0 : index == 1 ? row.rank-1 : index == 2 ? row.rank-2
                    : index == 3 ? row.rank-3 : index == 4 ? row.rank-4 : 0;

                to-x: row.fan-x + (index == 0 ? row.off-0 : index == 1 ? row.off-1
                    : index == 2 ? row.off-2 : index == 3 ? row.off-3
                    : index == 4 ? row.off-4 : 0px);

                to-y: row.fan-y;

                from-x: row.mark-x + (row.counter - self.span) / 2;
                from-y: row.y - 2px;

                open: row.open;
                ranks: row.buried;

                text: badge.text;
                kind: badge.kind;
                dot: badge.dot;
            }
        }

        more := GlyphButton {
            x: parent.width - self.width - 10px;
            y: parent.height - self.height - 10px;
            glyph: "dots";
            size: 26px;
            opacity: root.hovered || menu.is-open ? 1 : 0;
            visible: root.actions.length > 0;
            hint: "More";

            animate opacity { duration: 140ms; }

            clicked => {
                menu.show();
            }
        }

        menu := ActionMenu {
            x: more.x + more.width - self.width;
            y: more.y - self.height - 4px;
            items: root.actions;
            triggered(action) => {
                root.triggered(action);
            }
        }
    }
}
