import { Theme } from "../theme.slint";
import { Surface } from "surface.slint";

// The shell every sheet is built in: a scrim over the window and a card in the
// middle. The area over the scrim is there to swallow clicks as much as to dismiss.
export component Sheet {
    in property <bool> open;
    in property <length> card-width: 460px;
    in property <length> card-height;

    // A sheet's children sit inside the card, but `parent` in the sheet's own scope
    // is this layer over the window.
    out property <length> room-width: card.width;
    out property <length> room-height: card.height;

    callback dismissed();

    visible: root.open;

    // Slint sizes a base-less component to its contents and centres it; this is a layer.
    preferred-width: 100%;
    preferred-height: 100%;

    Rectangle {
        background: Theme.scrim;

        TouchArea {
            mouse-cursor: default;
            clicked => {
                root.dismissed();
            }
        }
    }

    card := Surface {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(root.card-width, parent.width - 48px);
        height: min(root.card-height, parent.height - 48px);
        transform-scale: root.open ? 1.0 : 0.95;

        animate transform-scale { duration: 140ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }

        TouchArea { mouse-cursor: default; }

        @children
    }
}
