import { Theme } from "../theme.slint";
import { Choice, Sys } from "../state.slint";
import { GlyphButton } from "glyph-button.slint";

// The window wears its own decoration and carries the navigation with it. Dragging
// and the window buttons go through the window manager, so a tiling one that
// ignores all three is not left with a bar pretending otherwise.
export component TitleBar inherits Rectangle {
    in property <[Choice]> pages;
    in property <string> current;
    in property <bool> compact: false;
    in property <bool> maximized: false;

    callback selected(string);
    callback minimize();
    callback toggle-maximize();
    callback close-window();

    // The window manager took the drag over, so nothing here follows the pointer.
    property <bool> handed-over: false;

    height: 54px;
    background: Theme.background;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.handed-over = Sys.begin-move();
            }
        }

        moved => {
            if (!root.handed-over && self.pressed) {
                Sys.move-by(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }

        double-clicked => {
            root.toggle-maximize();
        }
    }

    brand := HorizontalLayout {
        x: 16px;
        y: (parent.height - self.preferred-height) / 2;
        height: self.preferred-height;
        width: self.preferred-width;
        spacing: 9px;

        Image {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            source: @image-url("../../../../assets/qzdl-128.png");
        }

        if !root.compact : Text {
            text: "ZDL";
            color: Theme.text;
            font-size: Theme.font-body;
            font-weight: 500;
            letter-spacing: 0.2px;
            vertical-alignment: center;
        }
    }

    // Over the middle, where the pages are: a page is centred, so a tab in the
    // corner is a trip across the screen from what it opens. A narrow window has
    // no middle to spare, and there it sits beside the name.
    tabs := HorizontalLayout {
        x: max(brand.x + brand.width + 22px,
               min((root.width - self.width) / 2, controls.x - self.width - 16px));
        width: self.preferred-width;
        height: root.height;
        spacing: 2px;

        for page in root.pages : Rectangle {
            property <bool> active: root.current == page.key;

            width: label.preferred-width + 30px;
            background: transparent;

            label := Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: page.label;
                color: active || hover.has-hover ? Theme.text : Theme.faint;
                font-size: Theme.font-body;
                font-weight: active ? 600 : 400;

                animate color { duration: 120ms; }
            }

            // A line rather than a pill behind the word: a pill reads as a button.
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height - 2px;
                width: label.preferred-width + 12px;
                height: 2px;
                border-radius: 1px;
                background: Theme.accent;
                opacity: active ? 1 : 0;

                animate opacity { duration: 140ms; }
            }

            if page.badge && !active : Rectangle {
                x: parent.width - self.width - 8px;
                y: 13px;
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.accent;
            }

            hover := TouchArea {
                clicked => {
                    root.selected(page.key);
                }
            }
        }
    }

    controls := HorizontalLayout {
        x: root.width - self.width - 8px;
        y: (parent.height - self.height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: 8px;

        GlyphButton {
            glyph: Theme.mode;
            hint: Theme.mode == "system" ? "Following the desktop. Click for the light theme"
                : Theme.mode == "light" ? "Light theme. Click for the dark one"
                : "Dark theme. Click to follow the desktop again";
            clicked => {
                Theme.cycle();
            }
        }

        HorizontalLayout {
            spacing: 2px;

            GlyphButton {
                glyph: "minimize";
                clicked => {
                    root.minimize();
                }
            }

            GlyphButton {
                glyph: root.maximized ? "restore" : "maximize";
                clicked => {
                    root.toggle-maximize();
                }
            }

            GlyphButton {
                glyph: "close";
                hover-wash: Theme.danger;
                hover-tone: #ffffff;
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}
