// A popup is rebuilt on every show, so the fade in comes off a timer: an opacity
// set during the build has nothing to animate from.
export component Veil inherits Rectangle {
    // Fired after the fade out. Close the popup here and act after that, since
    // closing hands focus back.
    callback dismissed();

    in property <duration> span: 110ms;

    property <bool> lit;
    property <bool> going;
    property <bool> done;

    width: 100%;
    height: 100%;
    opacity: root.lit ? 1 : 0;

    animate opacity { duration: root.span; easing: ease-out-quad; }

    public function dismiss() {
        root.going = true;
        root.lit = false;
    }

    Timer {
        interval: root.going ? root.span : 16ms;
        running: !root.done && (root.going || !root.lit);
        triggered => {
            if (root.going) {
                root.done = true;
                root.dismissed();
            } else {
                root.lit = true;
            }
        }
    }
}
