// What a popup's contents go in, so the list fades rather than blinks. A popup is
// built afresh on every show, so the fade in comes off a one-shot timer: an opacity
// set while the contents are still being made has nothing to animate from.
export component Veil inherits Rectangle {
    // Fired once the fade out has run. Close the popup here, and act after that:
    // closing hands focus back, which would take it off anything the action opens.
    callback dismissed();

    in property <duration> span: 110ms;

    property <bool> lit;
    property <bool> going;
    property <bool> done;

    width: 100%;
    height: 100%;
    opacity: root.lit ? 1 : 0;

    animate opacity { duration: root.span; easing: ease-out-quad; }

    public function dismiss() {
        root.going = true;
        root.lit = false;
    }

    Timer {
        interval: root.going ? root.span : 16ms;
        running: !root.done && (root.going || !root.lit);
        triggered => {
            if (root.going) {
                root.done = true;
                root.dismissed();
            } else {
                root.lit = true;
            }
        }
    }
}
