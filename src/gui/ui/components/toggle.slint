import { Theme } from "../theme.slint";
import { Tip } from "tips.slint";

// An option that is on or off. A switch says which way in where the knob sits, and
// reads from across the page; a tick box has to be looked at closely.
export component Toggle {
    in property <string> text;
    in property <bool> checked: false;
    in property <string> hint;
    in property <bool> enabled: true;

    callback toggled(bool);

    // The one way it changes, so a whole card standing in as the target agrees.
    public function toggle() {
        root.toggled(!root.checked);
    }

    min-width: row.preferred-width;
    preferred-width: self.min-width;

    // Left to a row to size, it would take the row's spare width and whole height.
    horizontal-stretch: 0;
    height: max(24px, row.preferred-height);

    // A setting something else has settled still reads; the hint says why.
    opacity: root.enabled ? 1 : 0.45;

    animate opacity { duration: 120ms; }

    row := HorizontalLayout {
        spacing: 10px;
        alignment: start;

        track := Rectangle {
            width: 38px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: self.height / 2;
            background: root.checked ? Theme.accent : Theme.sunken;
            border-width: 1px;
            border-color: root.checked ? Theme.accent
                : area.has-hover ? Theme.border-strong : Theme.border;

            animate background, border-color { duration: 120ms; }

            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: self.width / 2;
                y: 3px;
                x: root.checked ? parent.width - self.width - 3px : 3px;
                background: root.checked ? Theme.accent-text : Theme.faint;

                animate x { duration: 140ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                animate background { duration: 120ms; }
            }
        }

        if root.text != "" : Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.toggle();
        }
    }

    // Over the pointer, not the middle of something as wide as the page.
    Tip {
        text: root.hint;
        over: area.has-hover;
        at: area.mouse-x;
    }
}
