import { Notify } from "../state.slint";
import { BuzzCard } from "buzz.slint";

// Messages pile up in the corner, newest furthest down.
export component BuzzStack {
    VerticalLayout {
        x: parent.width - self.width;
        width: 392px;
        spacing: 10px;
        alignment: start;

        for message in Notify.messages : BuzzCard {
            message: message;
        }
    }
}
