import { Theme } from "../theme.slint";
import { Sys } from "../state.slint";
import { Glyph } from "glyph.slint";
import { Tip } from "tips.slint";

export component AppButton {
    in property <string> text;
    in property <string> glyph;          // optional, drawn ahead of the label
    in property <string> hint;
    in property <string> variant: "default";   // default | primary | danger | ghost
    in property <bool> busy: false;
    in property <bool> compact: false;
    in property <bool> enabled: true;

    out property <bool> hovered: area.has-hover;

    callback clicked();

    property <color> ink: root.variant == "primary" ? Theme.accent-text
        : root.variant == "danger" ? Theme.danger
        : root.variant == "ghost" ? Theme.accent
        : Theme.text;

    property <length> mark-size: 12px * (root.compact ? 1.1 : 1.2);

    property <length> content-width:
        (root.glyph == "" ? 0px : root.mark-size + 7px) + label.preferred-width;

    // Full sized buttons share a floor, so a pair matches.
    min-width: root.compact
        ? root.content-width + 26px
        : max(root.content-width + 38px, Theme.button-width);
    preferred-width: self.min-width;

    // Never takes a row's spare width.
    horizontal-stretch: 0;
    height: root.compact ? Theme.control-small : Theme.control;

    opacity: root.enabled ? 1 : 0.45;

    property <float> give: area.pressed && root.enabled ? 0.985 : 1.0;

    animate give { duration: 90ms; easing: ease-out-quad; }

    body := Rectangle {
        // The software renderer draws no transforms, so the give is a size.
        width: Sys.gpu ? parent.width : parent.width * root.give;
        height: Sys.gpu ? parent.height : parent.height * root.give;

        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        border-radius: Theme.radius-small;
        border-width: root.variant == "primary" ? 0px : 1px;

        background: root.variant == "primary"
                ? (area.pressed ? Theme.accent.darker(0.15)
                    : area.has-hover ? Theme.accent-hover : Theme.accent)
            : root.variant == "ghost"
                ? (area.has-hover ? Theme.accent-soft : Theme.accent-soft.with-alpha(0))
            : root.variant == "danger"
                ? (area.pressed ? Theme.danger-soft.darker(0.08)
                    : area.has-hover ? Theme.danger-soft : Theme.raised)
            : (area.pressed ? Theme.sunken : Theme.raised);

        border-color: root.variant == "danger"
                ? (area.has-hover ? Theme.danger : Theme.danger.with-alpha(0.5))
            : root.variant == "ghost" ? Theme.accent-soft.with-alpha(0)
            : area.has-hover ? Theme.accent : Theme.border-strong;

        animate background, border-color { duration: 110ms; }

        transform-scale: Sys.gpu ? root.give : 1.0;

        Rectangle {
            border-radius: parent.border-radius;
            background: Theme.hover;
            opacity: root.variant == "default" && area.has-hover && !area.pressed ? 1 : 0;

            animate opacity { duration: 110ms; }
        }
    }

    content := HorizontalLayout {
        alignment: center;
        spacing: 7px;
        opacity: root.busy ? 0 : 1;

        // A zero wide glyph still costs the row its spacing.
        if root.glyph != "" : Glyph {
            width: root.mark-size;
            name: root.glyph;
            tone: root.ink;
            weight: root.compact ? 1.1 : 1.2;
            y: (parent.height - self.height) / 2;
        }

        label := Text {
            text: root.text;
            font-size: root.compact ? Theme.font-small : Theme.font-body;
            font-weight: 600;
            color: root.ink;
            vertical-alignment: center;
        }
    }

    property <int> tick: 0;

    Timer {
        interval: 300ms;
        running: root.busy;
        triggered => {
            root.tick = Math.mod(root.tick + 1, 3);
        }
    }

    if root.busy : HorizontalLayout {
        alignment: center;
        spacing: 5px;

        for dot[index] in [0, 1, 2] : Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: root.variant == "primary" ? Theme.accent-text : Theme.accent;
            opacity: root.tick == index ? 0.25 : 1;
            y: (parent.height - self.height) / 2;

            animate opacity { duration: 320ms; }
        }
    }

    area := TouchArea {
        enabled: root.enabled && !root.busy;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Tip {
        text: root.hint;
        over: area.has-hover;
        at: area.mouse-x;
    }
}
