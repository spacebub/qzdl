import { Theme } from "../theme.slint";
import { Glyph } from "glyph.slint";
import { Tip } from "tips.slint";

export component Check {
    in property <bool> checked: false;
    in property <string> hint;

    callback toggled(bool);

    width: 18px;
    height: 18px;

    Rectangle {
        border-radius: 5px;
        background: root.checked ? Theme.accent : Theme.field;
        border-width: 1px;
        border-color: root.checked ? Theme.accent
            : area.has-hover ? Theme.border-strong
            : Theme.border;

        animate background, border-color { duration: 110ms; }
    }

    Glyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: "check";
        weight: 0.85;
        tone: Theme.accent-text;
        opacity: root.checked ? 1 : 0;

        animate opacity { duration: 110ms; }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggled(!root.checked);
        }
    }

    Tip {
        text: root.hint;
        over: area.has-hover;
        at: area.mouse-x;
    }
}
