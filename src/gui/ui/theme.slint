import { Palette } from "std-widgets.slint";

// One palette in two shades and one ladder of sizes.
export global Theme {
    // "system" follows the desktop.
    in-out property <string> mode: "system";

    out property <bool> dark: root.mode == "light" ? false
        : root.mode == "dark" ? true
        : Palette.color-scheme == ColorScheme.dark;

    callback cycle();

    out property <color> background: root.dark ? #0a0d13 : #e8ecf4;
    out property <color> surface: root.dark ? #151b26 : #ffffff;
    out property <color> raised: root.dark ? #1d2431 : #ffffff;
    out property <color> sunken: root.dark ? #0e131c : #dee4ef;

    // A step past sunken, since fields sit inside inset panels.
    out property <color> field: root.dark ? #07090e : #dae1ed;

    // A wash, so it reads the same over any surface.
    out property <color> hover: root.dark ? #ffffff16 : #0d162814;
    out property <color> border: root.dark ? #232c3a : #ccd5e4;
    out property <color> border-strong: root.dark ? #3b4759 : #a9b6c9;

    out property <color> text: root.dark ? #e4eaf5 : #101620;
    out property <color> muted: root.dark ? #a6b4cd : #46536a;
    out property <color> faint: root.dark ? #7a8cac : #64728a;

    out property <color> accent: root.dark ? #ff7a1a : #c9450a;
    out property <color> accent-hover: root.dark ? #ff9422 : #a83606;

    out property <color> accent-text: root.dark ? #1a0a02 : #ffffff;
    out property <color> accent-soft: root.dark ? #2b1607 : #ffe9dc;

    // Not sunken's shade: a badge nearly always sits on one.
    out property <color> muted-soft: root.dark ? #212a37 : #dde4ef;
    out property <color> success: root.dark ? #52d18b : #0a7d4e;
    out property <color> success-soft: root.dark ? #0f2b1e : #e0f6ec;

    out property <color> warning: root.dark ? #ffc44d : #8a5a08;
    out property <color> warning-soft: root.dark ? #332609 : #fcf0d8;
    out property <color> danger: root.dark ? #ff5470 : #c22a45;
    out property <color> danger-soft: root.dark ? #35121c : #fde7ec;

    out property <color> shadow: root.dark ? #000000a8 : #12203a2e;

    out property <color> scrim: root.dark ? #030509be : #0c142078;

    // Same in both shades.
    out property <color> art-top: #1d2431;
    out property <color> art-middle: #121722;
    out property <color> art-bottom: #0a0d13;
    out property <color> art-edge: #0b0e14;

    out property <color> ember: #ff5a00;
    out property <color> ember-deep: #8f1b06;
    out property <color> ember-high: #ff9422;

    out property <color> steel: #a6b4cd;

    // For the card art, which never turns light.
    out property <color> art-success: #52d18b;
    out property <color> art-danger: #ff6b80;

    // Dark ink reads heavier, so the light shade steps down.
    out property <int> heading-weight: root.dark ? 700 : 600;

    out property <length> font-tiny: 12px;
    out property <length> font-small: 13px;
    out property <length> font-body: 14px;
    out property <length> font-medium: 15px;
    out property <length> font-large: 17px;
    out property <length> font-title: 19px;
    out property <length> font-display: 23px;
    out property <length> font-hero: 44px;

    out property <length> control: 42px;
    out property <length> control-small: 32px;

    // So neighbouring buttons match.
    out property <length> button-width: 140px;

    out property <length> page-width: 1180px;

    // The shelf lays out from these, not a column count.
    out property <length> card-width: 244px;
    out property <length> card-art: 138px;

    out property <length> radius: 12px;
    out property <length> radius-small: 8px;
    out property <length> radius-large: 18px;
    out property <length> gap: 12px;
    out property <length> pad: 20px;

    // Set from C++.
    in-out property <string> mono: "monospace";
}
