// Anything that would have been a second window happens over this one, and this
// says which is up. A sheet carries the name of what happens once it is answered
// rather than something to call, so every question is answered in one place.
import { Sys, Cfg, Runs, Ports, Pick } from "state.slint";

export global Sheets {
    // Anything that cannot be taken back.
    out property <bool> confirm-open;
    out property <string> confirm-title;
    out property <string> confirm-body;
    out property <string> confirm-accept;
    out property <bool> confirm-danger;
    out property <string> confirm-action;
    out property <string> confirm-arg;
    out property <int> confirm-index;

    public function ask(action: string, arg: string, index: int, title: string, body: string,
                        accept: string, danger: bool) {
        self.confirm-action = action;
        self.confirm-arg = arg;
        self.confirm-index = index;
        self.confirm-title = title;
        self.confirm-body = body;
        self.confirm-accept = accept;
        self.confirm-danger = danger;
        self.confirm-open = true;
    }

    public function accept-confirm() {
        self.confirm-open = false;

        if (self.confirm-action == "run-close") {
            Runs.close(self.confirm-arg);
        } else if (self.confirm-action == "delete-profile") {
            Cfg.remove-profile();
        } else if (self.confirm-action == "delete-profile-here") {
            Cfg.remove-profile();
            Sys.go("library");
        } else if (self.confirm-action == "remove-iwad") {
            Cfg.remove-iwad(self.confirm-index);
        } else if (self.confirm-action == "clear-files") {
            Cfg.clear-files();
        } else if (self.confirm-action == "clear-multiplayer") {
            Cfg.clear-multiplayer();
        } else if (self.confirm-action == "clear-replay") {
            Cfg.clear-replay();
        } else if (self.confirm-action == "clear-profile") {
            Cfg.clear-profile();
        } else if (self.confirm-action == "forget-port") {
            Ports.forget(self.confirm-index);
        } else if (self.confirm-action == "remove-fetched") {
            Ports.remove(self.confirm-index);
        } else if (self.confirm-action == "adopt-config") {
            Cfg.adopt-as-user-config();
        } else if (self.confirm-action == "clear-everything") {
            Cfg.clear-everything();
        } else if (self.confirm-action == "clear-downloads") {
            Ports.clear-downloads();
        }
    }

    public function close-confirm() {
        self.confirm-open = false;
    }

    // Anything that needs one line typed before it can happen.
    out property <bool> prompt-open;
    out property <string> prompt-title;
    out property <string> prompt-label;
    out property <string> prompt-accept;
    out property <string> prompt-action;
    in-out property <string> prompt-value;

    public function prompt(action: string, title: string, label: string, value: string,
                           accept: string) {
        self.prompt-action = action;
        self.prompt-title = title;
        self.prompt-label = label;
        self.prompt-value = value;
        self.prompt-accept = accept;
        self.prompt-open = true;
    }

    public function accept-prompt(value: string) {
        self.prompt-open = false;

        if (self.prompt-action == "add-profile") {
            Cfg.add-profile(value);
        } else if (self.prompt-action == "add-profile-open") {
            Cfg.add-profile(value);
            Sys.go("profile");
        } else if (self.prompt-action == "rename-profile") {
            Cfg.rename-profile(value);
        }
    }

    public function close-prompt() {
        self.prompt-open = false;
    }

    // Editing one IWAD or one source port.
    out property <bool> entry-open;
    out property <string> entry-title;
    out property <string> entry-action;
    out property <int> entry-index;
    out property <[string]> entry-filters;
    out property <string> entry-remember;

    // Only a source port can be a DOS one.
    out property <bool> entry-dos-offered;

    // Which list the name is read off the file with: "iwad" or "port".
    out property <string> entry-kind;

    in-out property <string> entry-name;
    in-out property <string> entry-file;
    in-out property <bool> entry-dosbox;

    public function edit(action: string, index: int, kind: string, title: string,
                         filters: [string], remember: string, name: string, file: string,
                         offer-dos: bool, dosbox: bool) {
        self.entry-action = action;
        self.entry-index = index;
        self.entry-kind = kind;
        self.entry-title = title;
        self.entry-filters = filters;
        self.entry-remember = remember;
        self.entry-name = name;
        self.entry-file = file;
        self.entry-dos-offered = offer-dos;
        self.entry-dosbox = dosbox;
        self.entry-open = true;
    }

    public function accept-entry(name: string, file: string, dosbox: bool) {
        self.entry-open = false;

        if (self.entry-action == "edit-iwad") {
            Cfg.update-iwad(self.entry-index, name, file);
        } else if (self.entry-action == "edit-port") {
            Cfg.update-port(self.entry-index, name, file, dosbox);
        }
    }

    public function close-entry() {
        self.entry-open = false;
    }

    // Taking the engine config of another profile on the same source port.
    out property <bool> copy-config-open;

    public function copy-config() {
        Cfg.refresh-config-donors();
        self.copy-config-open = true;
    }

    public function accept-copy-config(id: string) {
        self.copy-config-open = false;
        Cfg.copy-engine-config(id);
    }

    public function close-copy-config() {
        self.copy-config-open = false;
    }

    in-out property <bool> about-open;
    in-out property <bool> command-open;

    // Whatever is over the window, topmost first: what Escape closes.
    out property <bool> covered: self.confirm-open || Pick.open || self.prompt-open
        || self.entry-open || self.copy-config-open || self.about-open || self.command-open;

    public function dismiss-top() {
        if (self.confirm-open) {
            self.confirm-open = false;
        } else if (Pick.open) {
            Pick.dismiss();
        } else if (self.prompt-open) {
            self.prompt-open = false;
        } else if (self.entry-open) {
            self.entry-open = false;
        } else if (self.copy-config-open) {
            self.copy-config-open = false;
        } else if (self.about-open) {
            self.about-open = false;
        } else if (self.command-open) {
            self.command-open = false;
        }
    }
}
