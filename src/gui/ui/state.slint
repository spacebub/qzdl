// C++ writes every property. A control calls the matching callback and waits to
// be told the new value.

export struct ProfileCard {
    index: int,
    id: string,
    key: string,
    name: string,
    iwad: string,
    art-key: string,
    port: string,
    dos-port: bool,
    warp: string,
    files: int,
    loaded: int,
    net-role: int,
    ready: bool,
}

export struct FileRow {
    index: int,
    file: string,
    name: string,
    directory: string,
    loaded: bool,
    missing: bool,
}

export struct NameRow {
    index: int,
    name: string,
    file: string,
    directory: string,
    kind: string,
    missing: bool,
    dosbox: bool,

    // Fetched by ZDL, so it can be thrown away again.
    fetched: bool,

    // Found on this machine.
    detected: bool,
}

export struct EngineBrowseRow {
    index: int,
    name: string,
    blurb: string,
    homepage: string,

    // waiting | checking | ready | elsewhere | unavailable | fetching
    // | unpacking | installed | failed
    status: string,

    version: string,
    have: string,
    size-text: string,
    progress: float,
    file: string,
    error: string,
    dos: bool,

    // Its own field: an installed port stays "installed" while asked.
    asking: bool,
}

export struct LogRow {
    line: string,
    own: bool,
}

export struct Buzz {
    id: int,
    severity: int,
    title: string,
    body: string,
    duration: int,
}

export struct DirEntry {
    name: string,
    path: string,
    directory: bool,
    hidden: bool,
    marked: bool,
}

// A separator is a row with nothing else on it.
export struct MenuRow {
    action: string,
    label: string,
    glyph: string,
    danger: bool,
    separator: bool,
    disabled: bool,
}

export struct ConfigDonor {
    id: string,
    name: string,
    file: string,

    // Launches on the port's own settings rather than this file.
    shared: bool,
}

export struct BadgeSpec {
    text: string,

    // muted | warning | danger
    kind: string,

    dot: bool,
}

export struct Choice {
    key: string,
    label: string,
    badge: bool,
}

export global Sys {
    // The history is kept in C++.
    in-out property <string> page: "library";

    callback go(string);
    callback back();
    callback forward();

    in-out property <string> version;
    in-out property <string> runtime;
    in-out property <bool> windows;

    in-out property <[string]> wad-filters;
    in-out property <[string]> port-filters;
    in-out property <[string]> zdl-filters;
    in-out property <[string]> config-filters;
    in-out property <[string]> save-filters;
    in-out property <[string]> replay-filters;
    in-out property <[string]> any-filters: ["*"];

    // Home written as ~.
    pure callback pretty-path(string) -> string;

    // Drops leading directories to fit; zero is no limit.
    pure callback fit-path(string, int) -> string;

    pure callback directory-of(string) -> string;

    pure callback file-name(string) -> string;

    pure callback trim(string) -> string;

    pure callback is-file(string) -> bool;
    pure callback is-directory(string) -> bool;

    // Case and slash insensitive on Windows.
    pure callback same-file(string, string) -> bool;

    // Bumped when a title screen arrives.
    in-out property <int> art-rev;
    pure callback art-for(int, string) -> image;

    // Each kind remembers its last directory.
    pure callback start-directory(string) -> string;

    callback remember-directory(string, string);

    callback reveal(string);

    // Opens a folder, making it first if it is not there yet.
    callback reveal-folder(string);

    callback open-url(string);

    // Windows takes the gesture over (true); elsewhere the window is nudged by move-by.
    pure callback begin-move() -> bool;
    callback move-by(length, length);

    // The Windows compositor draws the border.
    callback outline(color);
}

export global Notify {
    // Oldest first.
    in-out property <[Buzz]> messages;

    callback dismiss(int);

    callback info(string);
    callback success(string);
    callback warning(string);
    callback error(string);
}

export global Runs {
    // Bumped so bindings on the lookups are redone.
    in-out property <int> rev;

    in-out property <bool> busy;

    // Runs with a tab, oldest first.
    in-out property <[string]> docked;

    // Empty is all folded away.
    in-out property <string> showing;

    // Names with a log, tab or no tab.
    in-out property <[string]> logged;

    in-out property <[LogRow]> lines;
    in-out property <bool> live;

    // launching | running | closed | failed. Empty is nothing to say.
    pure callback state-of(int, string) -> string;
    pure callback reason-of(int, string) -> string;
    pure callback title-of(int, string) -> string;
    pure callback alive(int, string) -> bool;

    callback show(string);
    callback hide();
    callback toggle(string);
    callback close(string);

    // For the clipboard.
    pure callback text() -> string;
}

export global Cfg {
    // Bumped so bindings on the lookups are redone.
    in-out property <int> rev;

    // Bumped only by what a library launch depends on; rev moves on every keystroke.
    in-out property <int> game-rev;

    in-out property <int> profile-index;
    in-out property <string> profile-name;
    in-out property <string> profile-key;
    in-out property <[ProfileCard]> profile-cards;

    // Active profile.
    in-out property <string> iwad;
    in-out property <string> port;
    in-out property <int> skill;
    in-out property <int> monsters;
    in-out property <string> warp;
    in-out property <string> extra;
    in-out property <bool> multiplayer-open;
    in-out property <bool> shared-config;
    in-out property <bool> command-override;
    in-out property <string> command;
    in-out property <string> command-trouble;
    in-out property <bool> dos-fullscreen;
    in-out property <bool> capture-output;
    in-out property <bool> levelstat;
    in-out property <bool> has-levelstat;
    in-out property <string> profile-directory;

    // 0 alone, 1 hosts, 2 joins.
    in-out property <int> net-role;
    in-out property <int> game-type;
    in-out property <int> players;
    in-out property <string> host;
    in-out property <string> net-port;
    in-out property <string> frag-limit;
    in-out property <string> time-limit;
    in-out property <string> dmflags;
    in-out property <string> dmflags2;
    in-out property <int> extratic;
    in-out property <int> netmode;
    in-out property <int> dup;
    in-out property <string> savegame;
    in-out property <bool> listed;

    // What the port's netgame family supports.
    in-out property <bool> net-hosts;
    in-out property <bool> net-joins;
    in-out property <bool> net-players;
    in-out property <bool> net-listing;
    in-out property <bool> net-frag-limit;
    in-out property <bool> net-flags;
    in-out property <bool> net-savegame;
    in-out property <bool> net-extratic;
    in-out property <bool> has-netmode;
    in-out property <bool> net-dup;
    in-out property <bool> multiplayer-set;

    // Replay panel. replay-mode: 0 off, 1 record, 2 play back.
    in-out property <bool> replay-open;
    in-out property <int> replay-mode;
    in-out property <string> replay-file;
    in-out property <int> replay-playback;
    in-out property <bool> replay-longtics;
    in-out property <bool> replay-solo-net;
    in-out property <bool> replay-set;

    // replay-complevel is an index into the list.
    in-out property <[string]> replay-complevels;
    in-out property <[string]> replay-complevel-numbers;
    in-out property <int> replay-complevel;

    in-out property <bool> replay-records;
    in-out property <bool> replay-timed;
    in-out property <bool> replay-fast;
    in-out property <bool> replay-has-complevel;
    in-out property <bool> replay-has-longtics;
    in-out property <bool> replay-has-solo-net;

    // Newest first.
    in-out property <[string]> replay-files;
    in-out property <string> replay-folder;

    // -1 when the demo is outside the folder.
    in-out property <int> replay-index;
    in-out property <string> replay-path;

    // Recording would write over an existing demo.
    in-out property <bool> replay-overwrites;

    in-out property <string> replay-trouble;

    // Saves panel.
    in-out property <bool> save-open;
    in-out property <bool> save-enabled;
    in-out property <string> save-file;

    // Without both -loadgame and a save folder there is no panel.
    in-out property <bool> save-loads;

    // Loads by slot rather than name.
    in-out property <bool> save-slots;

    // Newest first.
    in-out property <[string]> save-files;
    in-out property <[string]> save-slot-labels;
    in-out property <string> save-folder;

    in-out property <int> save-index;
    in-out property <string> save-path;

    in-out property <string> save-trouble;

    // General settings.
    in-out property <string> game-port;
    in-out property <string> always-add;
    in-out property <string> dosbox;
    in-out property <bool> dos-port;
    in-out property <string> system-dosbox;
    in-out property <bool> auto-close;
    in-out property <bool> launch-zdl-immediately;
    in-out property <bool> show-paths;
    in-out property <string> start-view;
    in-out property <bool> profile-configs;

    // Filtered in C++, so the shelf can lay out by counting.
    in-out property <string> filter;
    in-out property <[ProfileCard]> shelf-profiles;
    in-out property <[NameRow]> shelf-games;

    callback set-filter(string);

    // Lists.
    in-out property <[FileRow]> files;
    in-out property <int> enabled-count;
    in-out property <[NameRow]> iwads;
    in-out property <[NameRow]> ports;
    in-out property <[string]> iwad-names;
    in-out property <[string]> port-names;

    // "DOS" or blank per port.
    in-out property <[string]> port-badges;

    in-out property <[string]> maps;

    in-out property <string> command-line;

    // Read from disk, so filled on request.
    in-out property <[ConfigDonor]> config-donors;

    callback refresh-config-donors();
    callback copy-engine-config(string);

    // The config file.
    in-out property <string> path;
    in-out property <bool> user-config;
    in-out property <bool> ignore-user-config;

    pure callback profile-badges(int, int) -> [BadgeSpec];

    pure callback art-key(int) -> string;
    pure callback game-key(string) -> string;
    pure callback game-command-line(int, string) -> string;
    pure callback zdl-file-name() -> string;
    pure callback index-of([string], string) -> int;

    callback set-profile-index(int);
    callback set-iwad(string);
    callback set-port(string);
    callback set-skill(int);
    callback set-monsters(int);
    callback set-warp(string);
    callback set-extra(string);
    callback set-multiplayer-open(bool);
    callback set-shared-config(bool);
    callback set-command-override(bool);
    callback set-command(string);
    callback set-dos-fullscreen(bool);
    callback set-capture-output(bool);
    callback set-levelstat(bool);

    callback set-net-role(int);
    callback set-game-type(int);
    callback set-players(int);
    callback set-host(string);
    callback set-net-port(string);
    callback set-frag-limit(string);
    callback set-time-limit(string);
    callback set-dmflags(string);
    callback set-dmflags2(string);
    callback set-extratic(int);
    callback set-netmode(int);
    callback set-listed(bool);
    callback set-dup(int);
    callback set-savegame(string);

    callback set-replay-open(bool);
    callback set-replay-mode(int);
    callback set-replay-file(string);
    callback set-replay-index(int);
    callback set-replay-playback(int);
    callback set-replay-complevel(int);
    callback set-replay-longtics(bool);
    callback set-replay-solo-net(bool);

    // For a demo a run just wrote.
    callback refresh-replays();

    callback set-save-open(bool);
    callback set-save-enabled(bool);
    callback set-save-index(int);

    // For a game a run just saved.
    callback refresh-saves();

    callback set-game-port(string);
    callback set-always-add(string);
    callback set-dosbox(string);
    callback set-auto-close(bool);
    callback set-launch-zdl-immediately(bool);
    callback set-show-paths(bool);
    callback set-start-view(string);
    callback set-profile-configs(bool);
    callback set-ignore-user-config(bool);

    callback move-profile(int, int);
    callback add-profile(string);
    callback duplicate-profile();
    callback rename-profile(string);
    callback remove-profile();

    callback clear-multiplayer();
    callback clear-replay();
    callback clear-profile();
    callback clear-everything();

    callback save-as(string);
    callback load(string);
    callback adopt-as-user-config();
    callback load-zdl(string);
    callback save-zdl(string);

    callback launch();
    callback launch-at(int);
    callback launch-game(string);

    callback add-files([string]);
    callback remove-file(int);
    callback clear-files();
    callback move-file(int, int);
    callback set-file-enabled(int, bool);

    callback add-iwads([string]);
    callback update-iwad(int, string, string);
    callback remove-iwad(int);
    callback move-iwad(int, int);
    pure callback describe-iwad(string) -> string;

    callback add-port(string, bool);
    callback update-port(int, string, string, bool);
    callback move-port(int, int);
    pure callback describe-port(string) -> string;
}

export global Ports {
    in-out property <[EngineBrowseRow]> rows;
    in-out property <bool> checking;
    in-out property <string> directory;
    in-out property <string> downloads;
    in-out property <string> cached-text;
    in-out property <bool> cached;
    in-out property <string> trouble;

    callback refresh(bool);
    callback install(int);
    callback cancel(int);
    callback remove(int);
    callback forget(int);
    callback measure();
    callback clear-downloads();
}

export global Pick {
    in-out property <bool> open;
    in-out property <string> title;
    in-out property <bool> directories;

    // A folder can be taken as well as entered.
    in-out property <bool> folders;

    in-out property <int> marked-folders;

    in-out property <bool> multiple;

    // A checkbox beside the pick button; only the port picker uses it.
    in-out property <string> option;
    in-out property <string> option-hint;
    in-out property <bool> option-set;

    in-out property <string> path;
    in-out property <[string]> parts;
    in-out property <bool> rooted;

    // The Windows drive list, above any root.
    in-out property <bool> drives;

    in-out property <[DirEntry]> entries;
    in-out property <int> marked;

    in-out property <bool> hidden-shown;

    // Shown when the list is empty.
    in-out property <string> nothing;

    // Typing a path.
    in-out property <bool> editing;

    in-out property <bool> saving;

    // name-seed is bumped each time a name is pushed in; the field is the user's after that.
    in-out property <string> name;
    in-out property <int> name-stem;
    in-out property <int> name-seed;

    // What the name would write, and whether that file exists.
    in-out property <string> target;
    in-out property <bool> replacing;

    callback start(string, string, [string], bool, bool, bool, string, string, string);

    callback start-save(string, string, [string], string, string);

    callback named(string);

    // Whether writing over an existing file is meant.
    callback save(string, bool);
    callback go(string);
    callback up();
    callback up-to(int);
    callback show-drives();
    callback show-hidden(bool);
    callback mark(string);
    callback choose(string);
    callback choose-marked();

    callback typed(string);

    callback dismiss();
}
