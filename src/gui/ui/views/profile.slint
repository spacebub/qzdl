import { ListView } from "std-widgets.slint";

import { Theme } from "../theme.slint";
import { Sys, Cfg, Runs, Notify, Pick, Choice } from "../state.slint";
import { Sheets } from "../sheets.slint";
import { Nav } from "../nav.slint";
import { Surface } from "../components/surface.slint";
import { Wash } from "../components/wash.slint";
import { CardArt } from "../components/card-art.slint";
import { RunPill } from "../components/run-pill.slint";
import { Pill } from "../components/pill.slint";
import { Glyph } from "../components/glyph.slint";
import { GlyphButton } from "../components/glyph-button.slint";
import { AppButton } from "../components/app-button.slint";
import { ActionMenu } from "../components/action-menu.slint";
import { Veil } from "../components/veil.slint";
import { Picker } from "../components/picker.slint";
import { Segmented } from "../components/segmented.slint";
import { Stepper } from "../components/stepper.slint";
import { Toggle } from "../components/toggle.slint";
import { Check } from "../components/check.slint";
import { Field } from "../components/field.slint";
import { Placeholders } from "../components/placeholders.slint";
import { PathField } from "../components/path-field.slint";
import { PathLabel } from "../components/path-label.slint";
import { SectionLabel } from "../components/section-label.slint";
import { EmptyState } from "../components/empty-state.slint";
import { Fact } from "../components/fact.slint";
import { Scroller } from "../components/scroller.slint";
import { Clip } from "../components/clip.slint";
import { Tip } from "../components/tips.slint";

// One profile: what runs it, what it plays, what is loaded on top.
export component ProfileView {
    // A page fills its frame; a component with no base would shrink to its contents.
    preferred-width: 100%;
    preferred-height: 100%;

    // "(Default)" is index 0 in both, which is also what 0 means in the config,
    // so a picker's index is the stored value and back again.
    property <[string]> skills: ["V. Easy", "Easy", "Medium", "Hard", "V. Hard"];
    property <[string]> monsters: ["No monsters", "Fast", "Respawn", "Fast & respawn"];

    // Each in the order the config numbers them, so a key's place in the list is
    // the value stored for it and back again.
    property <[string]> roles: ["alone", "host", "join"];
    property <[string]> types: ["coop", "dm", "altdm"];
    property <[string]> modes: ["any", "p2p", "cs"];
    property <[string]> demo-modes: ["off", "record", "play"];
    property <[string]> speeds: ["played", "timed", "fast"];

    // The library's inset, so the two pages line up as they swap.
    property <length> bleed: 16px;

    // What the top row cannot go under: the add-ons panel's floor, the gap, and
    // the run panel's fixed width. The panels below hold to the same, so the
    // whole page is swallowed by the window together rather than by halves.
    property <length> narrowest: 260px + 16px + 340px;

    property <bool> ready: Cfg.command-override
        ? Cfg.command-trouble == ""
        : Cfg.port != "";

    // Set to join with nowhere to join, which launches a game for one.
    property <bool> net-broken: Cfg.net-role == 2 && Cfg.host == "";

    // Set to record or play with no demo named, which does neither.
    property <bool> replay-broken: Cfg.replay-mode != 0 && Cfg.replay-file == "";
    property <bool> replay-wrong: root.replay-broken || Cfg.replay-trouble != "";

    // Only a port that has heard of one of the three gets the section at all.
    property <bool> demo-tunable: Cfg.replay-has-complevel || Cfg.replay-has-longtics
        || Cfg.replay-has-solo-net;

    // Set to load with nothing named, or a save that is gone or cannot be
    // handed to this port.
    property <bool> save-broken: Cfg.save-enabled && Cfg.save-file == "";
    property <bool> save-wrong: root.save-broken || Cfg.save-trouble != "";

    // The profile has no folder of its own yet, so there is nothing to list.
    property <bool> save-homeless: Cfg.save-folder == "";

    // The list is left alone until the row is let go: a new model mid-drag rebuilds
    // the rows and the grab goes with them.
    property <int> carrying: -1;
    property <int> target: -1;
    property <bool> dragging;
    property <length> grab-y;
    property <length> carry-y;
    property <length> row-height: Cfg.show-paths ? 46px : 34px;

    // Nothing while the row follows the pointer; the walk to the gap once let go.
    property <duration> settling: 160ms;

    animate carry-y {
        duration: root.dragging ? 0ms : root.settling;
        easing: cubic-bezier(0.33, 1, 0.68, 1);
    }

    // While one row is in the air, the places it passed close up behind it.
    function shift(index: int) -> length {
        if (root.carrying < 0 || index == root.carrying) {
            return 0px;
        }

        if (root.carrying < root.target && index > root.carrying && index <= root.target) {
            return -root.row-height;
        }

        if (root.carrying > root.target && index >= root.target && index < root.carrying) {
            return root.row-height;
        }

        return 0px;
    }

    function dropped() {
        root.dragging = false;

        if (root.carrying < 0) {
            return;
        }

        root.carry-y = (root.target - root.carrying) * root.row-height;
        settle.running = true;
    }

    // The list changes here and nowhere else. By now every row is drawn where the
    // new order puts it, so the list only catches up with what is on it.
    function land() {
        settle.running = false;

        if (root.carrying < 0) {
            return;
        }

        if (root.target != root.carrying) {
            Cfg.move-file(root.carrying, root.target);
        }

        root.carrying = -1;
        root.target = -1;
        root.carry-y = 0;
    }

    settle := Timer {
        interval: root.settling + 20ms;
        running: false;
        triggered => {
            root.land();
        }
    }

    function summary() -> string {
        if (Cfg.command-override) {
            return Cfg.command-trouble != "" ? Cfg.command-trouble
                : "Launches the command written on this page";
        }

        if (!root.ready) {
            return "No source port · this profile cannot be launched yet";
        }

        return Cfg.port
            + " · " + (Cfg.iwad == "" ? "no game" : Cfg.iwad)
            + (Cfg.warp == "" ? "" : " · " + Cfg.warp)
            + (Cfg.files.length == 0 ? ""
               : " · " + Cfg.files.length + (Cfg.files.length == 1 ? " file" : " files"));
    }

    // Beside the pill that names it, so the panel reads shut as well as open.
    function net-summary() -> string {
        if (Cfg.net-role == 0) {
            return "Off · this profile launches a single player game";
        }

        if (Cfg.net-role == 1) {
            return "for " + Cfg.players + " players"
                + (Cfg.net-port == "" ? "" : ", on port " + Cfg.net-port);
        }

        if (root.net-broken) {
            return "no address yet";
        }

        return Cfg.host + (Cfg.net-port == "" ? "" : ":" + Cfg.net-port);
    }

    function tuning-summary() -> string {
        return Cfg.netmode == -1 && Cfg.dup <= 0 && Cfg.extratic != 1
            ? "left to the port"
            : (Cfg.netmode == -1 ? "" : (Cfg.netmode == 0 ? "peer to peer" : "client/server"))
              + (Cfg.dup > 0 ? (Cfg.netmode == -1 ? "" : " · ") + Cfg.dup + "× tics" : "")
              + (Cfg.extratic == 1
                 ? (Cfg.netmode == -1 && Cfg.dup <= 0 ? "" : " · ") + "extra tic" : "");
    }

    function save-summary() -> string {
        if (!Cfg.save-enabled) {
            return "Off · every launch starts a new game";
        }

        if (Cfg.save-file == "") {
            return "nothing picked yet";
        }

        return "from " + Sys.fit-path(Cfg.save-path, 30);
    }

    function replay-summary() -> string {
        if (Cfg.replay-mode == 0) {
            return "Off · nothing is recorded and nothing is played back";
        }

        if (root.replay-broken) {
            return Cfg.replay-mode == 1 ? "no name yet" : "nothing picked yet";
        }

        return (Cfg.replay-mode == 1 ? "into " : "")
            + Sys.fit-path(Cfg.replay-path, 30);
    }

    VerticalLayout {
        spacing: 16px;

        HorizontalLayout {
            height: 74px;
            padding-left: root.bleed;
            padding-right: root.bleed;
            spacing: 14px;

            // The heading is the way to the other profiles.
            chooser := Rectangle {
                Wash {
                    x: -8px;
                    width: parent.width + 16px;
                    rounding: Theme.radius;
                    hovered: header.has-hover;
                    selected: others.is-open;
                    tint: Theme.muted-soft;
                }

                thumb := CardArt {
                    // Laid out from its far edge, so it starts at the near one.
                    x: 0;
                    width: 116px;
                    height: 66px;
                    y: (parent.height - self.height) / 2;
                    rounding: Theme.radius-small;
                    bottom-rounding: Theme.radius-small;
                    lit: header.has-hover;
                    caption: Cfg.iwad == "" ? "NO GAME" : Cfg.iwad.to-uppercase();
                    art-key: Cfg.art-key(Cfg.rev);
                }

                VerticalLayout {
                    x: thumb.x + thumb.width + 14px;
                    y: (parent.height - self.preferred-height) / 2;
                    width: parent.width - self.x;
                    height: self.preferred-height;
                    spacing: 4px;

                    HorizontalLayout {
                        spacing: 10px;
                        height: self.preferred-height;

                        Text {
                            width: min(self.preferred-width, parent.width - 130px);
                            text: Cfg.profile-name;
                            color: Theme.text;
                            font-size: Theme.font-display;
                            font-weight: Theme.heading-weight;
                            overflow: elide;
                            vertical-alignment: center;
                        }

                        RunPill {
                            y: (parent.height - self.height) / 2;
                            status: Runs.state-of(Runs.rev, Cfg.profile-key);
                            reason: Runs.reason-of(Runs.rev, Cfg.profile-key);
                            clicked => {
                                Runs.show(Cfg.profile-key);
                            }
                        }

                        Rectangle { }
                    }

                    Text {
                        text: root.summary();
                        color: root.ready ? Theme.faint : Theme.warning;
                        font-size: Theme.font-small;
                        overflow: elide;
                    }
                }

                header := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        others.show();
                    }
                }

                others := PopupWindow {
                    x: 0;
                    y: chooser.height + 6px;
                    width: clamp(chooser.width, 280px, 460px);
                    height: min(Cfg.profile-cards.length, 8) * 52px + 10px + 38px;
                    close-policy: close-on-click-outside;

                    sheen := Veil {
                        dismissed => {
                            others.close();
                        }

                        Rectangle {
                            background: Theme.raised;
                            border-radius: Theme.radius-small;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                        }

                        list := ListView {
                            x: 5px;
                            y: 5px;
                            width: parent.width - 10px - (mine.visible ? mine.width + 2px : 0px);
                            height: parent.height - 10px - 38px;
                            vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                            init => {
                                self.viewport-y = -clamp(Cfg.profile-index * 52px - self.height + 52px,
                                                         0px,
                                                         max(0px, self.viewport-height - self.height));
                            }

                            for entry in Cfg.profile-cards : Rectangle {
                                property <bool> current: entry.index == Cfg.profile-index;

                                height: 52px;

                                Wash {
                                    x: 1px;
                                    y: 1px;
                                    width: parent.width - 2px;
                                    height: parent.height - 2px;
                                    selected: current;
                                    hovered: over.has-hover;
                                }

                                chip := CardArt {
                                    x: 8px;
                                    y: (parent.height - self.height) / 2;
                                    width: 60px;
                                    height: 36px;
                                    rounding: Theme.radius-small - 3px;
                                    bottom-rounding: Theme.radius-small - 3px;
                                    art-key: entry.art-key;
                                }

                                VerticalLayout {
                                    x: chip.x + chip.width + 10px;
                                    y: (parent.height - self.preferred-height) / 2;
                                    width: parent.width - self.x - 10px;
                                    height: self.preferred-height;
                                    spacing: 1px;

                                    Text {
                                        text: entry.name;
                                        color: current ? Theme.accent : Theme.text;
                                        font-size: Theme.font-body;
                                        font-weight: current ? 600 : 400;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: entry.port == "" ? "No source port"
                                            : entry.port + " · "
                                              + (entry.iwad == "" ? "no game" : entry.iwad);
                                        color: Theme.faint;
                                        font-size: Theme.font-tiny;
                                        overflow: elide;
                                    }
                                }

                                over := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        Cfg.set-profile-index(entry.index);
                                        sheen.dismiss();
                                    }
                                }
                            }
                        }

                        mine := Scroller {
                            x: parent.width - self.width - 4px;
                            y: 5px;
                            height: parent.height - 10px - 38px;
                            offset: list.viewport-y;
                            content: list.viewport-height;
                            room: list.height;
                            scrolled(to) => {
                                list.viewport-y = to;
                            }
                        }

                        adder := Rectangle {
                            y: parent.height - 38px;
                            height: 38px;

                            Rectangle {
                                x: 4px;
                                y: 0;
                                width: parent.width - 8px;
                                height: 1px;
                                background: Theme.border;
                            }

                            Wash {
                                y: 5px;
                                height: parent.height - 5px;
                                hovered: fresh.has-hover;
                            }

                            HorizontalLayout {
                                x: 14px;
                                y: 2px;
                                width: self.preferred-width;
                                spacing: 9px;

                                Glyph {
                                    name: "plus";
                                    weight: 1;
                                    tone: fresh.has-hover ? Theme.accent : Theme.faint;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: "New profile…";
                                    color: fresh.has-hover ? Theme.accent : Theme.text;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                }
                            }

                            fresh := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    sheen.dismiss();
                                    Sheets.prompt("add-profile", "New profile", "Name",
                                                  "New profile", "Create");
                                }
                            }
                        }
                    }
                }
            }

            GlyphButton {
                y: (parent.height - self.height) / 2;
                width: Cfg.capture-output && !Cfg.dos-port && !Cfg.auto-close
                    ? Theme.control : 0px;
                visible: Cfg.capture-output && !Cfg.dos-port && !Cfg.auto-close;
                glyph: "terminal";
                size: Theme.control;
                outlined: true;
                enabled: Cfg.index-of(Runs.logged, Cfg.profile-key) >= 0;
                hint: self.enabled ? "Show what this profile printed"
                                   : "Nothing has been launched from this profile yet";
                clicked => {
                    Runs.show(Cfg.profile-key);
                }
            }

            cog := GlyphButton {
                y: (parent.height - self.height) / 2;
                glyph: "cog";
                size: Theme.control;
                outlined: true;
                hint: "What else can be done with this profile";
                turn: menu.is-open ? 90deg : 0deg;
                clicked => {
                    menu.show();
                }
            }

            menu := ActionMenu {
                x: cog.x + cog.width - self.width;
                y: cog.y + cog.height + 4px;

                items: [
                    { action: "rename", label: "Rename", glyph: "edit" },
                    { action: "duplicate", label: "Duplicate", glyph: "extract" },
                    { action: "clear", label: "Empty this profile", glyph: "refresh" },
                    { separator: true },
                    { action: "copyConfig", label: "Copy port config", glyph: "copy",
                      disabled: Cfg.port == "" },
                    { separator: true },
                    { action: "loadZdl", label: "Import a .zdl", glyph: "download" },
                    { action: "saveZdl", label: "Save as .zdl", glyph: "save" },
                    { separator: true },
                    { action: "delete", label: "Delete this profile", glyph: "trash", danger: true },
                ];

                triggered(action) => {
                    if (action == "rename") {
                        Sheets.prompt("rename-profile", "Rename profile", "Name", Cfg.profile-name,
                                      "Rename");
                    } else if (action == "duplicate") {
                        Cfg.duplicate-profile();
                    } else if (action == "copyConfig") {
                        Sheets.copy-config();
                    } else if (action == "clear") {
                        Sheets.ask("clear-profile", "", 0,
                                   "Empty \"" + Cfg.profile-name + "\"?",
                                   "Everything this profile launches is emptied: the port, the game, "
                                   + "the files and the multiplayer settings. The profile itself stays.",
                                   "Empty it", true);
                    } else if (action == "delete") {
                        Sheets.ask("delete-profile-here", "", 0,
                                   "Delete \"" + Cfg.profile-name + "\"?",
                                   "The profile and everything in it goes. The files it loaded are "
                                   + "left alone.",
                                   "Delete", true);
                    } else if (action == "loadZdl") {
                        Pick.start("load-zdl", "Load a .zdl launch config", Sys.zdl-filters,
                                   false, false, false, "zdl", "", "");
                    } else if (action == "saveZdl") {
                        Pick.start-save("save-zdl", "Save this profile as a .zdl",
                                        Sys.zdl-filters, "zdl", Cfg.zdl-file-name());
                    }
                }
            }

            AppButton {
                y: (parent.height - self.height) / 2;
                text: "Launch";
                variant: "primary";
                glyph: "play";
                enabled: root.ready;
                hint: root.ready ? Cfg.command-line
                    : Cfg.command-override ? Cfg.command-trouble
                    : "Pick a source port first";
                clicked => {
                    Cfg.launch();
                }
            }
        }

        body := Flickable {
            // A file drag and a flick are the same gesture and the flickable wins
            // it, stranding the row. The wheel and bar still scroll.
            interactive: false;

            // A layout hands its height up to whatever holds it, so without this
            // the page stops where its content does and scrolls the rest away.
            max-height: root.height;
            viewport-width: self.width;
            viewport-height: sheet.preferred-height + 8px;

            sheet := VerticalLayout {
                x: root.bleed;
                width: max(root.narrowest, body.width - root.bleed * 2);
                height: self.preferred-height;
                spacing: 16px;

                HorizontalLayout {
                    height: max(340px, run.preferred-height + 32px);
                    spacing: 16px;

                    Surface {
                        min-width: 260px;

                        VerticalLayout {
                            x: 16px;
                            y: 16px;
                            width: parent.width - 32px;
                            height: parent.height - 32px;
                            spacing: 12px;

                            HorizontalLayout {
                                height: Theme.control-small;
                                spacing: 8px;

                                Text {
                                    text: "Add-ons";
                                    color: Theme.text;
                                    font-size: Theme.font-medium;
                                    font-weight: Theme.heading-weight;
                                    vertical-alignment: center;
                                }

                                Rectangle { }

                                if Cfg.files.length > 0 : Pill {
                                    y: (parent.height - self.height) / 2;
                                    dot: false;
                                    text: Cfg.enabled-count == Cfg.files.length
                                        ? Cfg.files.length + " loaded"
                                        : Cfg.enabled-count + " of " + Cfg.files.length
                                          + " loaded";
                                    tone: Theme.muted;
                                    wash: Theme.muted-soft;
                                }

                                GlyphButton {
                                    glyph: "plus";
                                    hint: "Add files";
                                    clicked => {
                                        Pick.start("add-files", "Add files", Sys.wad-filters,
                                                   false, true, true, "wad", "", "");
                                    }
                                }

                                GlyphButton {
                                    glyph: "trash";
                                    hint: "Remove every file from this profile";
                                    enabled: Cfg.files.length > 0;
                                    hover-tone: Theme.danger;
                                    clicked => {
                                        Sheets.ask("clear-files", "", 0,
                                                   "Clear the file list?",
                                                   "Every file in this profile's list is "
                                                   + "removed. The files themselves are left "
                                                   + "alone, and the rest of the profile is "
                                                   + "untouched.",
                                                   "Clear", true);
                                    }
                                }
                            }

                            Surface {
                                inset: true;

                                EmptyState {
                                    x: 24px;
                                    y: (parent.height - self.preferred-height) / 2;
                                    width: parent.width - 48px;
                                    height: self.preferred-height;
                                    visible: Cfg.files.length == 0;
                                    title: "Nothing loaded";
                                    body: "WADs, PK3s, DEH and BEX patches, demos and configs "
                                        + "go here. They are passed to the source port in the "
                                        + "order they are listed.";
                                }

                                files := ListView {
                                    x: 6px;
                                    y: 6px;
                                    width: parent.width - 12px - fileBar.width - 4px;
                                    height: parent.height - 12px;
                                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                                    // The list's own flickable would take the drag
                                    // the same way.
                                    mouse-drag-pan-enabled: false;

                                    for row[index] in Cfg.files : Rectangle {
                                        height: root.row-height;

                                        content := Rectangle {
                                            y: root.carrying == index ? root.carry-y
                                                : root.shift(index);

                                            // The carried row is placed by its
                                            // offset; the rest slide.
                                            animate y {
                                                duration: root.carrying >= 0
                                                    && index != root.carrying
                                                    ? root.settling : 0ms;
                                                easing: cubic-bezier(0.33, 1, 0.68, 1);
                                            }

                                            Wash {
                                                rounding: Theme.radius-small - 2px;
                                                hovered: hover.has-hover;
                                                selected: root.carrying == index;
                                                tint: Theme.muted-soft;
                                            }

                                            // Inside the row, not over it: an area
                                            // on top would take the hover.
                                            hover := TouchArea {
                                                grab := TouchArea {
                                                    x: 0;
                                                    width: 22px;
                                                    height: parent.height;
                                                    mouse-cursor: ns-resize;

                                                    pointer-event(event) => {
                                                        if (event.kind == PointerEventKind.down) {
                                                            root.land();
                                                            root.dragging = true;
                                                            root.carrying = index;
                                                            root.target = index;
                                                            root.grab-y = self.absolute-position.y
                                                                + self.mouse-y;
                                                            root.carry-y = 0;
                                                        }

                                                        if (event.kind == PointerEventKind.up
                                                            || event.kind
                                                               == PointerEventKind.cancel) {
                                                            root.dropped();
                                                        }
                                                    }

                                                    moved => {
                                                        if (root.carrying != index) {
                                                            return;
                                                        }

                                                        root.target =
                                                            clamp(floor((self.absolute-position.y
                                                                         + self.mouse-y
                                                                         - files.absolute-position.y
                                                                         - files.viewport-y)
                                                                        / root.row-height),
                                                                  0, Cfg.files.length - 1);

                                                        root.carry-y = self.absolute-position.y
                                                            + self.mouse-y - root.grab-y;
                                                    }

                                                    Glyph {
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        name: "grip";
                                                        weight: 1;
                                                        tone: grab.has-hover || grab.pressed
                                                            ? Theme.muted : Theme.border;
                                                    }
                                                }

                                                mark := Check {
                                                    x: 24px;
                                                    y: (parent.height - self.height) / 2;
                                                    checked: row.loaded;
                                                    hint: row.loaded
                                                        ? "Loaded. Click to leave it out"
                                                        : "Not loaded. Click to load it";
                                                    toggled(value) => {
                                                        Cfg.set-file-enabled(index, value);
                                                    }
                                                }

                                                VerticalLayout {
                                                    x: mark.x + mark.width + 10px;
                                                    y: (parent.height - self.preferred-height) / 2;
                                                    width: tools.x - self.x - 8px;
                                                    height: self.preferred-height;
                                                    spacing: 1px;

                                                    HorizontalLayout {
                                                        spacing: 7px;
                                                        height: self.preferred-height;

                                                        Text {
                                                            width: min(self.preferred-width,
                                                                       parent.width
                                                                       - (row.missing ? 60px : 0px));
                                                            text: row.name;
                                                            color: row.missing ? Theme.danger
                                                                : row.loaded ? Theme.text
                                                                : Theme.faint;
                                                            font-size: Theme.font-body;
                                                            overflow: elide;
                                                            vertical-alignment: center;

                                                            // Slint has no strike
                                                            // through, so it is drawn.
                                                            if !row.loaded : Rectangle {
                                                                y: parent.height / 2;
                                                                width: min(parent.preferred-width,
                                                                           parent.width);
                                                                height: 1px;
                                                                background: Theme.faint;
                                                            }
                                                        }

                                                        if row.missing : Text {
                                                            text: "missing";
                                                            color: Theme.danger;
                                                            font-size: Theme.font-tiny;
                                                            font-weight: 600;
                                                            vertical-alignment: center;
                                                        }

                                                        Rectangle { }
                                                    }

                                                    if Cfg.show-paths : PathLabel {
                                                        room: tools.x - mark.x - mark.width - 18px;
                                                        path: row.directory;
                                                    }
                                                }

                                                tools := GlyphButton {
                                                    x: parent.width - self.width - 6px;
                                                    y: (parent.height - self.height) / 2;
                                                    glyph: "cross";
                                                    size: 26px;
                                                    hover-tone: Theme.danger;
                                                    hint: "Remove from the list";
                                                    opacity: hover.has-hover ? 1 : 0;

                                                    animate opacity { duration: 110ms; }

                                                    clicked => {
                                                        Cfg.remove-file(index);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                fileBar := Scroller {
                                    x: parent.width - self.width - 6px;
                                    y: 6px;
                                    height: parent.height - 12px;
                                    offset: files.viewport-y;
                                    content: files.viewport-height;
                                    room: files.height;
                                    scrolled(to) => {
                                        files.viewport-y = to;
                                    }
                                }
                            }
                        }
                    }

                    Surface {
                        width: 340px;

                        run := VerticalLayout {
                            x: 16px;
                            y: 16px;
                            width: parent.width - 32px;
                            height: self.preferred-height;
                            spacing: 14px;
                            alignment: start;

                            Text {
                                text: "The run";
                                color: Theme.text;
                                font-size: Theme.font-medium;
                                font-weight: Theme.heading-weight;
                            }

                            // Ports are set up on the Engines page, so an empty
                            // list is a signpost, not an empty dropdown.
                            if Cfg.ports.length == 0 : VerticalLayout {
                                spacing: 6px;

                                SectionLabel { text: "SOURCE PORT"; }

                                AppButton {
                                    text: "Add a source port…";
                                    glyph: "plus";
                                    hint: "Ports are set up on the Engines page";
                                    clicked => {
                                        Sys.go("engines");
                                    }
                                }
                            }

                            if Cfg.ports.length > 0 : Picker {
                                label: "Source port";
                                placeholder: "None selected";
                                options: Cfg.port-names;

                                badges: Cfg.port-badges;

                                current: Cfg.index-of(Cfg.port-names, Cfg.port);
                                clearable: true;
                                hint: "What actually runs. Add ports on the Engines page.";
                                selected(index) => {
                                    Cfg.set-port(index < 0 ? "" : Cfg.port-names[index]);
                                }
                            }

                            // Games are kept on the shelf, so an empty list points
                            // there rather than adding one nowhere.
                            if Cfg.iwads.length == 0 : VerticalLayout {
                                spacing: 6px;

                                SectionLabel { text: "GAME"; }

                                AppButton {
                                    text: "Add a game…";
                                    glyph: "plus";
                                    hint: "Games are added on the library's games shelf";
                                    clicked => {
                                        Nav.shelf = "games";
                                        Sys.go("library");
                                    }
                                }
                            }

                            if Cfg.iwads.length > 0 : Picker {
                                label: "Game";
                                placeholder: "None selected";
                                options: Cfg.iwad-names;
                                current: Cfg.index-of(Cfg.iwad-names, Cfg.iwad);
                                clearable: true;
                                hint: "The IWAD itself. Add games from the library.";
                                selected(index) => {
                                    Cfg.set-iwad(index < 0 ? "" : Cfg.iwad-names[index]);
                                }
                            }

                            Picker {
                                label: "Map";
                                options: Cfg.maps;
                                current: Cfg.index-of(Cfg.maps, Cfg.warp);
                                clearable: true;
                                hint: "Read out of the game and everything loaded on top of it";
                                selected(index) => {
                                    Cfg.set-warp(index < 0 ? "" : Cfg.maps[index]);
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                height: self.preferred-height;

                                // Half the card each: a picker asks for more, and
                                // the row would outgrow the card.
                                Picker {
                                    width: (run.width - 12px) / 2;
                                    label: "Skill";
                                    options: root.skills;
                                    current: Cfg.skill - 1;
                                    clearable: true;
                                    selected(index) => {
                                        Cfg.set-skill(index + 1);
                                    }
                                }

                                Picker {
                                    width: (run.width - 12px) / 2;
                                    label: "Monsters";
                                    options: root.monsters;
                                    current: Cfg.monsters - 1;
                                    clearable: true;
                                    selected(index) => {
                                        Cfg.set-monsters(index + 1);
                                    }
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.border;
                            }

                            // A DOS port prints into DOSBox's own window, where
                            // nothing here can reach it.
                            if !Cfg.dos-port : Toggle {
                                enabled: !Cfg.auto-close;
                                text: "Log the game's output";
                                checked: Cfg.capture-output && !Cfg.auto-close;
                                hint: Cfg.auto-close
                                    ? "Nothing to record while ZDL4 closes on launch: the log "
                                      + "goes with the window. Turn that off in Settings."
                                    : "Takes what the source port prints into a log along the "
                                      + "bottom of the window. Off, nothing is piped at all.";
                                toggled(value) => {
                                    Cfg.set-capture-output(value);
                                }
                            }

                            if Cfg.dos-port : Toggle {
                                text: "Full screen";
                                checked: Cfg.dos-fullscreen;
                                hint: "Give DOSBox the whole screen rather than a window";
                                toggled(value) => {
                                    Cfg.set-dos-fullscreen(value);
                                }
                            }

                            // Nothing to bypass with the setting off, and a DOS
                            // port takes no -config at all.
                            if Cfg.profile-configs && !Cfg.dos-port : Toggle {
                                text: "Use the port's config";
                                checked: Cfg.shared-config;
                                hint: "Launch on the settings the source port keeps for itself, "
                                    + "shared with everything else that uses them";
                                toggled(value) => {
                                    Cfg.set-shared-config(value);
                                }
                            }

                            if Cfg.profile-configs && !Cfg.shared-config && !Cfg.dos-port : Fact {
                                label: "Its own port settings";
                                value: Cfg.config-file;
                                path: true;
                                clickable: true;
                                hint: "Open the folder the source port writes them in";
                                opens: Sys.directory-of(Cfg.config-file);
                                room: run.width;
                            }
                        }
                    }
                }

                // What is recorded and what is played back, which every port here
                // does something of. What it can be told about a demo differs
                // family by family, so the panel only offers what this one has.
                if Cfg.replay-records : Surface {
                    height: demo.preferred-height + 32px;

                    demo := VerticalLayout {
                        x: 16px;
                        y: 16px;
                        width: parent.width - 32px;
                        height: self.preferred-height;
                        alignment: start;

                        demoBar := Rectangle {
                            height: Theme.control;

                            demoHeading := HorizontalLayout {
                                x: 0;
                                width: mode.x - 14px;
                                height: parent.height;
                                spacing: 10px;

                                Glyph {
                                    name: "down";
                                    weight: 1;
                                    tone: demoFold.has-hover ? Theme.text : Theme.faint;
                                    turn: Cfg.replay-open ? 180deg : 0deg;
                                    y: (parent.height - self.height) / 2;

                                    animate turn {
                                        duration: 220ms;
                                        easing: cubic-bezier(0.33, 1, 0.68, 1);
                                    }
                                }

                                Text {
                                    text: "Replay";
                                    color: Theme.text;
                                    font-size: Theme.font-medium;
                                    font-weight: Theme.heading-weight;
                                    vertical-alignment: center;
                                }

                                if Cfg.replay-mode != 0 : Pill {
                                    y: (parent.height - self.height) / 2;
                                    text: Cfg.replay-mode == 1 ? "Recording" : "Playing";
                                    tone: root.replay-wrong ? Theme.warning : Theme.accent;
                                    wash: root.replay-wrong ? Theme.warning-soft
                                                            : Theme.accent-soft;
                                }

                                // Takes the row's spare width, so the pill hugs the
                                // right and the rest packs left.
                                Text {
                                    text: root.replay-summary();
                                    color: root.replay-wrong ? Theme.warning : Theme.faint;
                                    font-size: Theme.font-small;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }

                            // Only the words fold the panel; one area over the pair
                            // would swallow the control beside them.
                            demoFold := TouchArea {
                                x: 0;
                                width: demoHeading.width;
                                height: parent.height;
                                mouse-cursor: pointer;
                                clicked => {
                                    Cfg.set-replay-open(!Cfg.replay-open);
                                }
                            }

                            demoReset := GlyphButton {
                                x: parent.width - self.width;
                                y: (parent.height - self.height) / 2;
                                glyph: "refresh";
                                size: Theme.control;
                                outlined: true;
                                enabled: Cfg.replay-set;
                                hint: self.enabled
                                    ? "Put every replay setting back to its default"
                                    : "Nothing here has been set";
                                clicked => {
                                    Sheets.ask("clear-replay", "", 0,
                                               "Reset the replay settings?",
                                               "The profile goes back to recording nothing "
                                               + "and playing nothing back. The demos already "
                                               + "in its replays folder are left where they "
                                               + "are.",
                                               "Reset", true);
                                }
                            }

                            mode := Segmented {
                                // Not in a row, so it says it is as wide as its tabs.
                                width: self.min-width;
                                x: demoReset.x - self.width - 10px;
                                y: (parent.height - self.height) / 2;
                                options: [{ key: "off", label: "Off" },
                                          { key: "record", label: "Record" },
                                          { key: "play", label: "Play" }];
                                current: root.demo-modes[Cfg.replay-mode];
                                selected(key) => {
                                    Cfg.set-replay-mode(Cfg.index-of(root.demo-modes, key));
                                    Cfg.set-replay-open(key != "off");
                                }
                            }
                        }

                        // Kept in the tree and clipped so the panel slides rather than blinks. The
                        // 16px is the gap the row above would have had as the column's spacing.
                        demoSlide := Rectangle {
                            clip: true;
                            height: Cfg.replay-open ? demoPanel.preferred-height + 16px : 0px;

                            animate height { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }

                            demoPanel := VerticalLayout {
                                x: 0;
                                y: 16px;
                                width: parent.width;
                                height: self.preferred-height;
                                spacing: 16px;
                                opacity: Cfg.replay-open ? 1 : 0;

                                animate opacity { duration: 180ms; }

                                Rectangle {
                                    height: 1px;
                                    background: Theme.border;
                                }

                                if Cfg.replay-mode == 0 : Text {
                                    text: "This profile neither records nor plays anything back. "
                                        + "Record writes what is played into the profile's own "
                                        + "replays folder; Play runs one of them back.";
                                    color: Theme.faint;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                }

                                if Cfg.replay-mode == 1 : VerticalLayout {
                                    spacing: 10px;

                                    Field {
                                        label: "Record it as";
                                        placeholder: "A name for the demo";
                                        text: Cfg.replay-file;
                                        mono: true;
                                        hint: ".lmp goes on the end by itself, and the file "
                                            + "lands in the profile's replays folder";
                                        edited(value) => {
                                            Cfg.set-replay-file(value);
                                        }
                                    }

                                    if root.replay-broken : Text {
                                        text: "Without a name there is nothing to record into, "
                                            + "and the profile launches without recording.";
                                        color: Theme.warning;
                                        font-size: Theme.font-small;
                                        wrap: word-wrap;
                                    }

                                    if Cfg.replay-trouble != "" : Text {
                                        text: Cfg.replay-trouble;
                                        color: Theme.danger;
                                        font-size: Theme.font-small;
                                        wrap: word-wrap;
                                    }

                                    if Cfg.replay-overwrites : Text {
                                        text: "A demo by that name is in the folder already. The "
                                            + "port writes over it without asking.";
                                        color: Theme.warning;
                                        font-size: Theme.font-small;
                                        wrap: word-wrap;
                                    }

                                    if !root.replay-broken : PathLabel {
                                        path: Cfg.replay-path;
                                        clickable: true;
                                        opens: Cfg.replay-folder;
                                        hint: "Open the folder this profile's demos go in";
                                        room: demoPanel.width;
                                    }
                                }

                                if Cfg.replay-mode == 2 : VerticalLayout {
                                    spacing: 10px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        height: self.preferred-height;
                                        alignment: start;

                                        Picker {
                                            width: 340px;
                                            label: "Replay";
                                            placeholder: Cfg.replay-files.length == 0
                                                ? "Nothing recorded yet"
                                                : "Nothing picked";
                                            options: Cfg.replay-files;
                                            current: Cfg.replay-index;
                                            clearable: true;
                                            enabled: Cfg.replay-files.length > 0;
                                            hint: "The demos in this profile's replays folder, "
                                                + "newest first";
                                            selected(index) => {
                                                Cfg.set-replay-index(index);
                                            }
                                        }

                                        // The list is read once; a demo written by the
                                        // run that just ended is not in it yet.
                                        VerticalLayout {
                                            width: self.preferred-width;
                                            alignment: end;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                height: self.preferred-height;

                                                GlyphButton {
                                                    glyph: "refresh";
                                                    size: Theme.control;
                                                    outlined: true;
                                                    hint: "Look in the folder again";
                                                    clicked => {
                                                        Cfg.refresh-replays();
                                                    }
                                                }

                                                GlyphButton {
                                                    glyph: "folder";
                                                    size: Theme.control;
                                                    outlined: true;
                                                    hint: "Play a demo from somewhere else";
                                                    clicked => {
                                                        Pick.start("replay", "Select a replay",
                                                                   Sys.replay-filters, false,
                                                                   false, false, "replay",
                                                                   "", "");
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    if root.replay-broken : Text {
                                        text: Cfg.replay-files.length == 0
                                            ? "This profile has recorded nothing yet, so there "
                                              + "is nothing to play back. Record writes a demo "
                                              + "the next time it is launched."
                                            : "Without a demo picked there is nothing to play "
                                              + "back, and the profile launches an ordinary "
                                              + "game.";
                                        color: Theme.warning;
                                        font-size: Theme.font-small;
                                        wrap: word-wrap;
                                    }

                                    if Cfg.replay-trouble != "" : Text {
                                        text: Cfg.replay-trouble;
                                        color: Theme.danger;
                                        font-size: Theme.font-small;
                                        wrap: word-wrap;
                                    }

                                    if !root.replay-broken && Cfg.replay-index < 0 : PathLabel {
                                        path: Cfg.replay-path;
                                        clickable: true;
                                        hint: "A demo from outside this profile's folder";
                                        room: demoPanel.width;
                                    }

                                    if Cfg.replay-timed : VerticalLayout {
                                        spacing: 6px;
                                        width: self.preferred-width;
                                        alignment: start;

                                        SectionLabel { text: "HOW IT PLAYS"; }

                                        // The same control twice rather than one
                                        // with a list built by a condition, which
                                        // is more than a tab strip can be told.
                                        if Cfg.replay-fast : Segmented {
                                            options: [{ key: "played", label: "As recorded" },
                                                      { key: "timed", label: "Timed" },
                                                      { key: "fast",
                                                        label: "As fast as it draws" }];
                                            current: root.speeds[Cfg.replay-playback];
                                            selected(key) => {
                                                Cfg.set-replay-playback(
                                                    Cfg.index-of(root.speeds, key));
                                            }
                                        }

                                        if !Cfg.replay-fast : Segmented {
                                            options: [{ key: "played", label: "As recorded" },
                                                      { key: "timed", label: "Timed" }];
                                            current: root.speeds[Cfg.replay-playback];
                                            selected(key) => {
                                                Cfg.set-replay-playback(
                                                    Cfg.index-of(root.speeds, key));
                                            }
                                        }
                                    }
                                }

                                // What a demo is recorded under, which decides what
                                // will play it back and what it can be judged as.
                                if Cfg.replay-mode == 1 && root.demo-tunable : VerticalLayout {
                                    spacing: 12px;

                                    Rectangle {
                                        height: 1px;
                                        background: Theme.border;
                                    }

                                    // Not folded: what these say goes into
                                    // every recording the port makes.
                                    SectionLabel { text: "COMPATIBILITY"; }

                                    HorizontalLayout {
                                        spacing: 20px;
                                        height: self.preferred-height;
                                        alignment: start;

                                        if Cfg.replay-has-complevel : Picker {
                                            width: 220px;
                                            label: "Complevel";
                                            options: Cfg.replay-complevels;
                                            badges: Cfg.replay-complevel-numbers;
                                            current: Cfg.replay-complevel;
                                            hint: "The rules the demo is recorded under, and "
                                                + "what it has to be played back under";
                                            selected(index) => {
                                                Cfg.set-replay-complevel(index);
                                            }
                                        }

                                        if Cfg.replay-has-longtics : VerticalLayout {
                                            spacing: 6px;
                                            width: self.preferred-width;
                                            alignment: start;

                                            SectionLabel { text: "TURNING"; }

                                            Toggle {
                                                // Shares the complevel box's
                                                // centre line.
                                                height: Theme.control;
                                                text: "Long tics";
                                                checked: Cfg.replay-longtics;
                                                hint: "Records turns at the port's own precision "
                                                    + "rather than vanilla's. A demo made this "
                                                    + "way needs a port that reads them";
                                                toggled(value) => {
                                                    Cfg.set-replay-longtics(value);
                                                }
                                            }
                                        }

                                        if Cfg.replay-has-solo-net : VerticalLayout {
                                            spacing: 6px;
                                            width: self.preferred-width;
                                            alignment: start;

                                            SectionLabel { text: "RULES"; }

                                            Toggle {
                                                height: Theme.control;
                                                text: "Solo net";
                                                checked: Cfg.replay-solo-net;
                                                hint: "Plays alone under a netgame's rules, "
                                                    + "which is what a recorded run is judged "
                                                    + "under";
                                                toggled(value) => {
                                                    Cfg.set-replay-solo-net(value);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // A port that cannot be told which save to load, or given a folder
                // to keep them in, has no panel here.
                if Cfg.save-loads : Surface {
                    height: saved.preferred-height + 32px;

                    saved := VerticalLayout {
                        x: 16px;
                        y: 16px;
                        width: parent.width - 32px;
                        height: self.preferred-height;
                        alignment: start;

                        savedBar := Rectangle {
                            height: Theme.control;

                            savedHeading := HorizontalLayout {
                                x: 0;
                                width: loads.x - 14px;
                                height: parent.height;
                                spacing: 10px;

                                Glyph {
                                    name: "down";
                                    weight: 1;
                                    tone: savedFold.has-hover ? Theme.text : Theme.faint;
                                    turn: Cfg.save-open ? 180deg : 0deg;
                                    y: (parent.height - self.height) / 2;

                                    animate turn {
                                        duration: 220ms;
                                        easing: cubic-bezier(0.33, 1, 0.68, 1);
                                    }
                                }

                                Text {
                                    text: "Saves";
                                    color: Theme.text;
                                    font-size: Theme.font-medium;
                                    font-weight: Theme.heading-weight;
                                    vertical-alignment: center;
                                }

                                // Takes the row's spare width, so the rest packs left.
                                Text {
                                    text: root.save-summary();
                                    color: root.save-wrong ? Theme.warning : Theme.faint;
                                    font-size: Theme.font-small;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }

                            savedFold := TouchArea {
                                x: 0;
                                width: savedHeading.width;
                                height: parent.height;
                                mouse-cursor: pointer;
                                clicked => {
                                    Cfg.set-save-open(!Cfg.save-open);
                                }
                            }

                            // Off launches a new game; the save it named is kept for
                            // the next time it is on.
                            loads := Segmented {
                                // Not in a row, so it says it is as wide as its tabs.
                                width: self.min-width;
                                x: parent.width - self.width;
                                y: (parent.height - self.height) / 2;
                                options: [{ key: "off", label: "Off" },
                                          { key: "on", label: "On" }];
                                current: Cfg.save-enabled ? "on" : "off";
                                selected(key) => {
                                    Cfg.set-save-enabled(key == "on");
                                    Cfg.set-save-open(key == "on");
                                }
                            }
                        }

                        // Kept in the tree and clipped so the panel slides rather than
                        // blinks, as the one above it does.
                        savedSlide := Rectangle {
                            clip: true;
                            height: Cfg.save-open ? savedPanel.preferred-height + 16px : 0px;

                            animate height { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }

                            savedPanel := VerticalLayout {
                                x: 0;
                                y: 16px;
                                width: parent.width;
                                height: self.preferred-height;
                                spacing: 16px;
                                opacity: Cfg.save-open ? 1 : 0;

                                animate opacity { duration: 180ms; }

                                Rectangle {
                                    height: 1px;
                                    background: Theme.border;
                                }

                                VerticalLayout {
                                    spacing: 10px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        height: self.preferred-height;
                                        alignment: start;

                                        Picker {
                                            width: 340px;
                                            label: "Save";
                                            placeholder: Cfg.save-files.length == 0
                                                ? "Nothing saved yet"
                                                : "Nothing picked";
                                            options: Cfg.save-files;
                                            badges: Cfg.save-slot-labels;
                                            current: Cfg.save-index;
                                            clearable: true;
                                            enabled: Cfg.save-files.length > 0;
                                            hint: Cfg.save-slots
                                                ? "The saves in this profile's folder, newest "
                                                  + "first. The port is handed the slot it "
                                                  + "sits in"
                                                : "The saves in this profile's folder, newest "
                                                  + "first";
                                            selected(index) => {
                                                Cfg.set-save-index(index);
                                            }
                                        }

                                        VerticalLayout {
                                            width: self.preferred-width;
                                            alignment: end;

                                            GlyphButton {
                                                glyph: "refresh";
                                                size: Theme.control;
                                                outlined: true;
                                                hint: "Look in the folder again";
                                                clicked => {
                                                    Cfg.refresh-saves();
                                                }
                                            }
                                        }
                                    }

                                    if root.save-homeless : Text {
                                        text: "This profile launches on the settings the "
                                            + "source port keeps for itself, so its saves are "
                                            + "the port's own and there is nothing here to "
                                            + "list. Give it settings of its own to keep them "
                                            + "apart.";
                                        color: Theme.faint;
                                        font-size: Theme.font-small;
                                        wrap: word-wrap;
                                    }

                                    if !root.save-homeless && Cfg.save-files.length == 0 : Text {
                                        text: "Nothing has been saved in this profile yet. A "
                                            + "game saved while it is playing lands in its "
                                            + "saves folder and shows up here.";
                                        color: Theme.faint;
                                        font-size: Theme.font-small;
                                        wrap: word-wrap;
                                    }

                                    if root.save-broken && Cfg.save-files.length > 0 : Text {
                                        text: "Without a save picked there is nothing to load, "
                                            + "and the profile launches a new game.";
                                        color: Theme.warning;
                                        font-size: Theme.font-small;
                                        wrap: word-wrap;
                                    }

                                    if Cfg.save-trouble != "" : Text {
                                        text: Cfg.save-trouble;
                                        color: Theme.danger;
                                        font-size: Theme.font-small;
                                        wrap: word-wrap;
                                    }

                                    if Cfg.save-enabled && Cfg.save-file != ""
                                        && Cfg.savegame != "" && Cfg.net-role == 1 : Text {
                                        text: "Multiplayer names a save for the game this "
                                            + "profile hosts. A port loads one save, and this "
                                            + "is the one it gets.";
                                        color: Theme.warning;
                                        font-size: Theme.font-small;
                                        wrap: word-wrap;
                                    }

                                    if Cfg.save-file != "" && Cfg.replay-mode != 0 : Text {
                                        text: Cfg.replay-mode == 1
                                            ? "A demo is being recorded, which starts where a "
                                              + "new game starts, so the save is left out of "
                                              + "the launch."
                                            : "A demo is being played back, so the save is "
                                              + "left out of the launch.";
                                        color: Theme.warning;
                                        font-size: Theme.font-small;
                                        wrap: word-wrap;
                                    }

                                    if Cfg.save-file != "" : PathLabel {
                                        path: Cfg.save-path;
                                        clickable: true;
                                        opens: Cfg.save-folder;
                                        hint: "Open the folder this profile's saves go in";
                                        room: savedPanel.width;
                                    }
                                }
                            }
                        }
                    }
                }

                // Which side the profile is on is what the rest of the panel follows
                // from, so the header carries it. A DOS netgame is IPX and a setup
                // program of its own, so the panel is not offered there.
                if !Cfg.dos-port : Surface {
                    height: net.preferred-height + 32px;

                    net := VerticalLayout {
                        x: 16px;
                        y: 16px;
                        width: parent.width - 32px;
                        height: self.preferred-height;
                        alignment: start;

                        netBar := Rectangle {
                            height: Theme.control;

                            heading := HorizontalLayout {
                                x: 0;
                                width: role.x - 14px;
                                height: parent.height;
                                spacing: 10px;

                                Glyph {
                                    name: "down";
                                    weight: 1;
                                    tone: fold.has-hover ? Theme.text : Theme.faint;
                                    turn: Cfg.multiplayer-open ? 180deg : 0deg;
                                    y: (parent.height - self.height) / 2;

                                    animate turn {
                                        duration: 220ms;
                                        easing: cubic-bezier(0.33, 1, 0.68, 1);
                                    }
                                }

                                Text {
                                    text: "Multiplayer";
                                    color: Theme.text;
                                    font-size: Theme.font-medium;
                                    font-weight: Theme.heading-weight;
                                    vertical-alignment: center;
                                }

                                if Cfg.net-role != 0 : Pill {
                                    y: (parent.height - self.height) / 2;
                                    text: Cfg.net-role == 2 ? "Joining"
                                        : Cfg.game-type == 1 ? "Co-op"
                                        : Cfg.game-type == 2 ? "Deathmatch"
                                        : "Alt deathmatch";
                                    tone: root.net-broken ? Theme.warning : Theme.accent;
                                    wash: root.net-broken ? Theme.warning-soft
                                                          : Theme.accent-soft;
                                }

                                // Takes the row's spare width, so the pill hugs the
                                // right and the rest packs left.
                                Text {
                                    text: root.net-summary();
                                    color: root.net-broken ? Theme.warning : Theme.faint;
                                    font-size: Theme.font-small;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }

                            // Only the words fold the panel; one area over the pair
                            // would swallow the control beside them.
                            fold := TouchArea {
                                x: 0;
                                width: heading.width;
                                height: parent.height;
                                mouse-cursor: pointer;
                                clicked => {
                                    Cfg.set-multiplayer-open(!Cfg.multiplayer-open);
                                }
                            }

                            reset := GlyphButton {
                                x: parent.width - self.width;
                                y: (parent.height - self.height) / 2;
                                glyph: "refresh";
                                size: Theme.control;
                                outlined: true;
                                enabled: Cfg.multiplayer-set;
                                hint: self.enabled
                                    ? "Put every multiplayer setting back to its default"
                                    : "Nothing here has been set";
                                clicked => {
                                    Sheets.ask("clear-multiplayer", "", 0,
                                               "Reset the multiplayer settings?",
                                               "The side this profile is on, the game it opens "
                                               + "and every address, limit and flag under it go "
                                               + "back to their defaults. The rest of the "
                                               + "profile is untouched.",
                                               "Reset", true);
                                }
                            }

                            role := Segmented {
                                // Not in a row, so it says it is as wide as its tabs.
                                width: self.min-width;
                                x: reset.x - self.width - 10px;
                                y: (parent.height - self.height) / 2;
                                options: [{ key: "alone", label: "Off" },
                                          { key: "host", label: "Host" },
                                          { key: "join", label: "Join" }];
                                current: root.roles[Cfg.net-role];
                                selected(key) => {
                                    Cfg.set-net-role(Cfg.index-of(root.roles, key));
                                    Cfg.set-multiplayer-open(key != "alone");
                                }
                            }
                        }

                        // Kept in the tree and clipped so the panel slides rather than blinks. The
                        // 16px is the gap the row above would have had as the column's spacing.
                        slide := Rectangle {
                            clip: true;
                            height: Cfg.multiplayer-open ? panel.preferred-height + 16px : 0px;

                            animate height { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }

                            panel := VerticalLayout {
                                x: 0;
                                y: 16px;
                                width: parent.width;
                                height: self.preferred-height;
                                spacing: 16px;
                                opacity: Cfg.multiplayer-open ? 1 : 0;

                                animate opacity { duration: 180ms; }

                                Rectangle {
                                    height: 1px;
                                    background: Theme.border;
                                }

                                if Cfg.net-role == 0 : Text {
                                    text: "This profile starts a game for one. Host opens a game "
                                        + "other machines can connect to; Join connects to one "
                                        + "somebody else is running.";
                                    color: Theme.faint;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                }

                                if Cfg.net-role == 1 : HorizontalLayout {
                                    spacing: 20px;
                                    height: self.preferred-height;
                                    alignment: start;

                                    VerticalLayout {
                                        spacing: 6px;
                                        width: self.preferred-width;
                                        alignment: start;

                                        SectionLabel { text: "GAME TYPE"; }

                                        Segmented {
                                            options: [{ key: "coop", label: "Co-op" },
                                                      { key: "dm", label: "Deathmatch" },
                                                      { key: "altdm", label: "Alt deathmatch" }];
                                            current: root.types[max(0, Cfg.game-type - 1)];
                                            selected(key) => {
                                                Cfg.set-game-type(
                                                    Cfg.index-of(root.types, key) + 1);
                                            }
                                        }
                                    }

                                    Stepper {
                                        width: 170px;
                                        label: "Players";
                                        from: 1;
                                        to: 8;
                                        value: Cfg.players;
                                        hint: "How many the game is opened for, this machine "
                                            + "included";
                                        stepped(value) => {
                                            Cfg.set-players(value);
                                        }
                                    }

                                    Field {
                                        width: 160px;
                                        label: "Listen on port";
                                        placeholder: "Default";
                                        text: Cfg.net-port;
                                        mono: true;
                                        edited(value) => {
                                            Cfg.set-net-port(value);
                                        }
                                    }
                                }

                                if Cfg.net-role == 2 : VerticalLayout {
                                    spacing: 10px;

                                    HorizontalLayout {
                                        spacing: 12px;
                                        height: self.preferred-height;

                                        Field {
                                            label: "Address of the game";
                                            placeholder: "A host name or an address";
                                            text: Cfg.host;
                                            mono: true;
                                            edited(value) => {
                                                Cfg.set-host(value);
                                            }
                                        }

                                        Field {
                                            width: 160px;
                                            label: "Port";
                                            placeholder: "Default";
                                            text: Cfg.net-port;
                                            mono: true;
                                            hint: "Replaces any port typed into the address";
                                            edited(value) => {
                                                Cfg.set-net-port(value);
                                            }
                                        }
                                    }

                                    if Cfg.host == "" : Text {
                                        text: "Without an address there is nothing to join, and the "
                                            + "profile launches a single player game.";
                                        color: Theme.warning;
                                        font-size: Theme.font-small;
                                        wrap: word-wrap;
                                    }

                                    if Cfg.host != "" : Text {
                                        text: "How the game is played is the host's to decide, so "
                                            + "there is nothing else to set on this side.";
                                        color: Theme.faint;
                                        font-size: Theme.font-small;
                                        wrap: word-wrap;
                                    }
                                }

                                if Cfg.net-role == 1 : VerticalLayout {
                                    spacing: 12px;

                                    Rectangle {
                                        height: 1px;
                                        background: Theme.border;
                                    }

                                    SectionLabel { text: "RULES OF THE GAME"; }

                                    HorizontalLayout {
                                        spacing: 12px;
                                        height: self.preferred-height;

                                        Field {
                                            label: "Frag limit";
                                            placeholder: "None";
                                            text: Cfg.frag-limit;
                                            mono: true;
                                            edited(value) => {
                                                Cfg.set-frag-limit(value);
                                            }
                                        }

                                        Field {
                                            label: "Time limit";
                                            placeholder: "None";
                                            text: Cfg.time-limit;
                                            mono: true;
                                            hint: "In minutes";
                                            edited(value) => {
                                                Cfg.set-time-limit(value);
                                            }
                                        }

                                        Field {
                                            label: "dmflags";
                                            placeholder: "None";
                                            text: Cfg.dmflags;
                                            mono: true;
                                            hint: "The port's own flag word";
                                            edited(value) => {
                                                Cfg.set-dmflags(value);
                                            }
                                        }

                                        Field {
                                            label: "dmflags2";
                                            placeholder: "None";
                                            text: Cfg.dmflags2;
                                            mono: true;
                                            hint: "The second, where a port has one";
                                            edited(value) => {
                                                Cfg.set-dmflags2(value);
                                            }
                                        }
                                    }

                                    PathField {
                                        label: "Start from a save";
                                        placeholder: "None · the game starts at its first map";
                                        text: Cfg.savegame;
                                        filters: Sys.save-filters;
                                        remember: "save";
                                        browse-title: "Select a save game";
                                        pick-action: "savegame";
                                        hint: "Everyone joining drops into the host's saved game";
                                        edited(value) => {
                                            Cfg.set-savegame(value);
                                        }
                                    }

                                    if Cfg.savegame != "" && Cfg.save-enabled
                                        && Cfg.save-file != "" : Text {
                                        text: "The Saves panel names one too, and a port loads "
                                            + "one save: that is the one it gets.";
                                        color: Theme.warning;
                                        font-size: Theme.font-small;
                                        wrap: word-wrap;
                                    }
                                }

                                if Cfg.net-role != 0 : VerticalLayout {
                                    spacing: 12px;

                                    Rectangle {
                                        height: 1px;
                                        background: Theme.border;
                                    }

                                    Rectangle {
                                        height: 18px;

                                        tuningHead := HorizontalLayout {
                                            x: 0;
                                            width: self.preferred-width;
                                            height: parent.height;
                                            spacing: 8px;

                                            Glyph {
                                                name: "down";
                                                weight: 0.85;
                                                tone: more.has-hover ? Theme.text : Theme.faint;
                                                turn: Nav.tuning ? 180deg : 0deg;
                                                y: (parent.height - self.height) / 2;

                                                animate turn {
                                                    duration: 220ms;
                                                    easing: cubic-bezier(0.33, 1, 0.68, 1);
                                                }
                                            }

                                            SectionLabel {
                                                text: "CONNECTION";
                                                color: more.has-hover ? Theme.text : Theme.faint;
                                                vertical-alignment: center;
                                            }

                                            if !Nav.tuning : SectionLabel {
                                                text: root.tuning-summary();
                                                letter-spacing: 0;
                                                font-weight: 400;
                                                vertical-alignment: center;
                                            }
                                        }

                                        more := TouchArea {
                                            x: 0;
                                            width: tuningHead.width;
                                            height: parent.height;
                                            mouse-cursor: pointer;
                                            clicked => {
                                                Nav.tuning = !Nav.tuning;
                                            }
                                        }
                                    }

                                    if Nav.tuning : HorizontalLayout {
                                        spacing: 20px;
                                        height: self.preferred-height;
                                        alignment: start;

                                        VerticalLayout {
                                            spacing: 6px;
                                            width: self.preferred-width;
                                            alignment: start;

                                            SectionLabel { text: "NET MODE"; }

                                            Segmented {
                                                options: [{ key: "any", label: "The port's own" },
                                                          { key: "p2p", label: "Peer to peer" },
                                                          { key: "cs", label: "Client/server" }];
                                                current: root.modes[Cfg.netmode + 1];
                                                selected(key) => {
                                                    Cfg.set-netmode(
                                                        Cfg.index-of(root.modes, key) - 1);
                                                }
                                            }
                                        }

                                        Stepper {
                                            width: 170px;
                                            label: "Duplicate tics";
                                            from: 1;
                                            to: 9;
                                            value: Cfg.dup;
                                            clearable: true;
                                            placeholder: "Off";
                                            hint: "Sends each tic more than once, which trades "
                                                + "bandwidth for a connection that drops packets";
                                            stepped(value) => {
                                                Cfg.set-dup(value);
                                            }
                                        }

                                        VerticalLayout {
                                            spacing: 6px;
                                            width: self.preferred-width;
                                            alignment: start;

                                            SectionLabel { text: "EXTRA TIC"; }

                                            Segmented {
                                                options: [{ key: "no", label: "Off" },
                                                          { key: "yes", label: "On" }];
                                                current: Cfg.extratic == 1 ? "yes" : "no";
                                                selected(key) => {
                                                    Cfg.set-extratic(key == "yes" ? 1 : 0);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Surface {
                    height: line.preferred-height + 32px;

                    line := VerticalLayout {
                        x: 16px;
                        y: 16px;
                        width: parent.width - 32px;
                        height: self.preferred-height;
                        spacing: 12px;
                        alignment: start;

                        HorizontalLayout {
                            spacing: 12px;
                            height: self.preferred-height;

                            Text {
                                text: "Command line";
                                color: Theme.text;
                                font-size: Theme.font-medium;
                                font-weight: Theme.heading-weight;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            Rectangle { }

                            // Hands the whole line over instead, for the launches
                            // nothing here was built to describe.
                            Toggle {
                                y: (parent.height - self.height) / 2;
                                text: "Override";
                                checked: Cfg.command-override;
                                hint: "Use a custom command instead of the generated one";
                                toggled(value) => {
                                    Cfg.set-command-override(value);
                                }
                            }
                        }

                        if !Cfg.command-override : Field {
                            label: "Extra arguments";
                            placeholder: "Passed to the source port as typed";
                            text: Cfg.extra;
                            mono: true;
                            edited(value) => {
                                Cfg.set-extra(value);
                            }
                        }

                        if Cfg.command-override : VerticalLayout {
                            spacing: 6px;

                            Field {
                                label: "The command";
                                placeholder: "{source_port} -iwad {game} -file {addon_1}";
                                text: Cfg.command;
                                mono: true;
                                edited(value) => {
                                    Cfg.set-command(value);
                                }
                            }

                            Placeholders {
                                room: line.width;
                            }
                        }

                        Surface {
                            height: min(resolved.preferred-height + 24px, 108px);
                            inset: true;
                            hovered: reach.has-hover;

                            reach := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    Sheets.command-open = true;
                                }
                            }

                            Tip {
                                text: "See the whole of it";
                                over: reach.has-hover;
                                at: reach.mouse-x;
                            }

                            resolved := Text {
                                x: 12px;
                                y: 12px;
                                width: parent.width - 24px - 34px;
                                text: Cfg.command-trouble != "" ? Cfg.command-trouble
                                    : Cfg.command-line != "" ? Cfg.command-line
                                    : Cfg.dos-port && Cfg.dosbox == "" && Cfg.system-dosbox == ""
                                        ? "A DOS source port, and no DOSBox to run it in. "
                                          + "Set one in Settings."
                                    : "Nothing to run yet.";

                                color: Cfg.command-trouble != "" ? Theme.danger
                                    : root.ready ? Theme.muted : Theme.faint;
                                font-size: Theme.font-small;
                                font-family: Theme.mono;
                                wrap: char-wrap;
                                overflow: elide;
                            }

                            GlyphButton {
                                x: parent.width - self.width - 8px;
                                y: 8px;
                                glyph: "extract";
                                size: 26px;
                                hint: "Copy it";
                                clicked => {
                                    Clip.copy(Cfg.command-line);
                                    Notify.success("The command line is on the clipboard.");
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    bar := Scroller {
        x: parent.width - self.width;
        y: body.y;
        height: body.height;
        offset: body.viewport-y;
        content: body.viewport-height;
        room: body.height;
        scrolled(to) => {
            body.viewport-y = to;
        }
    }

    // A config need have no profiles in it. The page is covered rather than left
    // showing fields that belong to nothing and keep nothing.
    if Cfg.profile-index < 0 : Rectangle {
        background: Theme.background;

        // Nothing under this is meant to be reached.
        TouchArea {
            mouse-cursor: default;
        }

        VerticalLayout {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.preferred-height) / 2;
            width: min(420px, parent.width - 60px);
            height: self.preferred-height;
            spacing: 18px;

            EmptyState {
                title: "No profiles";
                body: "A profile holds a game, the port it runs on and whatever is "
                    + "loaded over them, under a name. This config has none.";
            }

            HorizontalLayout {
                height: self.preferred-height;
                spacing: 8px;

                AppButton {
                    text: "New profile";
                    glyph: "plus";
                    variant: "primary";
                    clicked => {
                        Sheets.prompt("add-profile", "New profile", "Name", "New profile",
                                      "Create");
                    }
                }

                AppButton {
                    text: "Import a .zdl";
                    glyph: "download";
                    variant: "ghost";
                    hint: "Read a .zdl launch config in as a profile of its own";
                    clicked => {
                        Pick.start("load-zdl", "Load a .zdl launch config", Sys.zdl-filters,
                                   false, false, false, "zdl", "", "");
                    }
                }

                Rectangle { }
            }
        }
    }
}
