import { Theme } from "../theme.slint";
import { Sys } from "../state.slint";
import { Sheets } from "../sheets.slint";
import { Sheet } from "../components/sheet.slint";
import { Field } from "../components/field.slint";
import { AppButton } from "../components/app-button.slint";

export component PromptSheet inherits Sheet {
    property <string> value: Sheets.prompt-value;
    property <string> tidy: Sys.trim(root.value);

    open: Sheets.prompt-open;
    card-width: 460px;
    card-height: content.preferred-height + 44px;

    dismissed => {
        Sheets.close-prompt();
    }

    changed open => {
        if (root.open) {
            root.value = Sheets.prompt-value;
            input.take-focus();
        }
    }

    function commit() {
        if (root.tidy == "") {
            return;
        }

        Sheets.accept-prompt(root.tidy);
    }

    content := VerticalLayout {
        x: 22px;
        y: 22px;
        width: root.room-width - 44px;
        spacing: 16px;
        alignment: start;

        Text {
            text: Sheets.prompt-title;
            color: Theme.text;
            font-size: Theme.font-large;
            font-weight: Theme.heading-weight;
            wrap: word-wrap;
        }

        input := Field {
            label: Sheets.prompt-label;
            text: Sheets.prompt-value;
            edited(value) => {
                root.value = value;
            }
            accepted => {
                root.commit();
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            AppButton {
                text: "Cancel";
                clicked => {
                    Sheets.close-prompt();
                }
            }

            AppButton {
                text: Sheets.prompt-accept;
                variant: "primary";
                enabled: root.tidy != "";
                clicked => {
                    root.commit();
                }
            }
        }
    }
}
