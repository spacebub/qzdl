import { Theme } from "../theme.slint";
import { Sheets } from "../sheets.slint";
import { Sheet } from "../components/sheet.slint";
import { AppButton } from "../components/app-button.slint";

// Anything that cannot be taken back, confirmed in the window rather than a box.
export component ConfirmSheet inherits Sheet {
    open: Sheets.confirm-open;
    card-width: 460px;
    card-height: content.preferred-height + 44px;

    dismissed => {
        Sheets.close-confirm();
    }

    content := VerticalLayout {
        x: 22px;
        y: 22px;
        width: root.room-width - 44px;
        spacing: 10px;
        alignment: start;

        Text {
            text: Sheets.confirm-title;
            color: Theme.text;
            font-size: Theme.font-large;
            font-weight: Theme.heading-weight;
            wrap: word-wrap;
        }

        Text {
            text: Sheets.confirm-body;
            color: Theme.muted;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }

        Rectangle {
            height: 8px;
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            AppButton {
                text: "Cancel";
                clicked => {
                    Sheets.close-confirm();
                }
            }

            AppButton {
                text: Sheets.confirm-accept;
                variant: Sheets.confirm-danger ? "danger" : "primary";
                clicked => {
                    Sheets.accept-confirm();
                }
            }
        }
    }
}
