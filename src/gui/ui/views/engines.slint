import { Theme } from "../theme.slint";
import { Sys, Cfg, Ports, Pick } from "../state.slint";
import { Sheets } from "../sheets.slint";
import { Nav } from "../nav.slint";
import { Surface } from "../components/surface.slint";
import { Pill } from "../components/pill.slint";
import { Glyph } from "../components/glyph.slint";
import { GlyphButton } from "../components/glyph-button.slint";
import { AppButton } from "../components/app-button.slint";
import { Segmented } from "../components/segmented.slint";
import { PathLabel } from "../components/path-label.slint";
import { Scroller } from "../components/scroller.slint";
import { EngineBrowseView } from "engine-browse.slint";

// The ports that are set up and the ones ZDL knows where to get: two halves of one
// page, since getting one and having one is the same errand.
export component EnginesView {
    // A page fills its frame; a component with no base would shrink to its contents.
    preferred-width: 100%;
    preferred-height: 100%;

    property <bool> installed: Nav.engines == "installed";

    property <length> bleed: 16px;
    property <length> gutter: 16px;
    property <length> room: max(330px, shelf.width - root.bleed * 2);
    property <int> columns: max(1, floor((root.room + root.gutter) / (330px + root.gutter)));
    property <length> cell: (root.room - (root.columns - 1) * root.gutter) / root.columns;
    property <length> row-height: 152px;
    property <int> count: Cfg.ports.length;
    property <int> rows: floor((root.count + root.columns) / root.columns);

    // The list itself is left alone until the card is let go.
    property <string> carrying;
    property <int> origin: -1;
    property <int> target: -1;
    property <bool> dragging;

    property <length> slack: 6px;

    property <length> grab-x;
    property <length> grab-y;
    property <length> carry-x;
    property <length> carry-y;

    // Nothing while the card follows the pointer; the walk to the gap once let go.
    property <duration> settling: 190ms;

    animate carry-x, carry-y {
        duration: root.dragging ? 0ms : root.settling;
        easing: cubic-bezier(0.33, 1, 0.68, 1);
    }

    function cell-x(index: int) -> length {
        return root.bleed + Math.mod(index, root.columns) * (root.cell + root.gutter);
    }

    function cell-y(index: int) -> length {
        return 2px + floor(index / root.columns) * (root.row-height + root.gutter);
    }

    function place-at(px: length, py: length) -> int {
        return clamp(floor((py - shelf.absolute-position.y - shelf.viewport-y - 2px)
                           / (root.row-height + root.gutter)) * root.columns
                     + clamp(floor((px - shelf.absolute-position.x - root.bleed)
                                   / (root.cell + root.gutter)), 0, root.columns - 1),
                     0, root.count - 1);
    }

    // While one card is in the air, the places it passed shuffle up behind it.
    function slot(index: int) -> int {
        if (root.origin < 0 || index == root.origin) {
            return index;
        }

        if (root.origin < root.target && index > root.origin && index <= root.target) {
            return index - 1;
        }

        if (root.origin > root.target && index >= root.target && index < root.origin) {
            return index + 1;
        }

        return index;
    }

    function grabbed(index: int, px: length, py: length) {
        root.dragging = true;
        root.origin = index;
        root.target = index;
        root.grab-x = px - shelf.absolute-position.x - root.cell-x(index);
        root.grab-y = py - shelf.absolute-position.y - shelf.viewport-y - root.cell-y(index);
        root.carry-x = 0;
        root.carry-y = 0;
    }

    function carried(px: length, py: length) {
        root.target = root.place-at(px, py);
        root.carry-x = px - root.grab-x - shelf.absolute-position.x - root.cell-x(root.origin);
        root.carry-y = py - root.grab-y - shelf.absolute-position.y - shelf.viewport-y
            - root.cell-y(root.origin);
    }

    // The card walks to the gap held for it, and only then does the list change.
    function dropped() {
        root.dragging = false;

        if (root.origin < 0) {
            return;
        }

        root.carry-x = root.cell-x(root.target) - root.cell-x(root.origin);
        root.carry-y = root.cell-y(root.target) - root.cell-y(root.origin);
        landing.running = true;
    }

    // The list changes here and nowhere else. By now every card is drawn where the
    // new order puts it, so the shelf only catches up with what is on it.
    function land() {
        landing.running = false;

        if (root.origin < 0) {
            return;
        }

        if (root.target != root.origin) {
            Cfg.move-port(root.origin, root.target);
        }

        root.origin = -1;
        root.target = -1;
        root.carrying = "";
        root.carry-x = 0;
        root.carry-y = 0;
    }

    landing := Timer {
        interval: root.settling + 20ms;
        running: false;
        triggered => {
            root.land();
        }
    }

    function say(number: int, thing: string) -> string {
        return number + " " + thing + (number == 1 ? "" : "s");
    }

    // Opens on the half with something to offer. Once, not as a binding: it is
    // where to start, not where to stay.
    init => {
        if (Cfg.ports.length == 0) {
            Nav.engines = "browse";
        }
    }

    VerticalLayout {
        spacing: 16px;

        Rectangle {
            height: max(head.preferred-height, tools.preferred-height);
            clip: true;

            head := VerticalLayout {
                x: root.bleed;
                y: (parent.height - self.height) / 2;
                width: max(0px, tools.x - root.bleed - 14px);
                height: self.preferred-height;
                spacing: 3px;

                Text {
                    text: "Engines";
                    color: Theme.text;
                    font-size: Theme.font-display;
                    font-weight: Theme.heading-weight;
                    overflow: elide;
                }

                Text {
                    text: root.installed
                        ? root.say(Cfg.ports.length, "source port")
                          + " · what the profiles are run with"
                        : Ports.trouble != "" ? Ports.trouble
                        : "Fetched, unpacked and set up here · what each project has released "
                          + "is looked up on GitHub";

                    color: !root.installed && Ports.trouble != "" ? Theme.danger : Theme.faint;
                    font-size: Theme.font-small;
                    overflow: elide;
                }
            }

            // Kept at the far edge and cut off by the window rather than pushed
            // out of it: the two halves cannot be swapped from a control the
            // heading has shoved off the page.
            tools := HorizontalLayout {
                x: max(root.bleed, parent.width - root.bleed - self.width);
                y: (parent.height - self.height) / 2;
                width: self.preferred-width;
                height: self.preferred-height;
                spacing: 14px;
                cross-axis-alignment: center;

                if !root.installed : AppButton {
                    text: "Check again";
                    glyph: "refresh";
                    compact: true;
                    busy: Ports.checking;
                    hint: "Ask every project what it has released";
                    clicked => {
                        Ports.refresh(true);
                    }
                }

                Segmented {
                    current: Nav.engines;
                    options: [{ key: "installed", label: "Installed" },
                              { key: "browse", label: "Get more" }];
                    selected(key) => {
                        Nav.engines = key;
                    }
                }
            }
        }

        Rectangle {
            shelf := Flickable {
                // A card drag and a flick are the same gesture and the flickable
                // wins it, stranding the card. The wheel and bar still scroll.
                interactive: false;

                visible: root.installed;
                viewport-width: self.width;
                viewport-height: root.rows * (root.row-height + root.gutter) + 26px;

                for port[index] in Cfg.ports : Surface {
                    x: root.cell-x(root.slot(index))
                        + (root.carrying == port.name ? root.carry-x : 0px);
                    y: root.cell-y(root.slot(index))
                        + (root.carrying == port.name ? root.carry-y : 0px);
                    width: root.cell;
                    height: root.row-height;
                    hoverable: true;
                    hovered: reach.has-hover || root.carrying == port.name;

                    // The carried card is placed by its offset; the rest slide. When
                    // the list changes each is already where it belongs.
                    animate x, y {
                        duration: root.origin >= 0 && index != root.origin ? root.settling : 0ms;
                        easing: cubic-bezier(0.33, 1, 0.68, 1);
                    }

                    reach := TouchArea {
                        // So a press that wanders a pixel is still a press.
                        property <bool> carrying;
                        property <length> press-x;
                        property <length> press-y;

                        mouse-cursor: self.carrying ? MouseCursor.grabbing : MouseCursor.default;

                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                self.carrying = false;
                                self.press-x = self.absolute-position.x + self.mouse-x;
                                self.press-y = self.absolute-position.y + self.mouse-y;

                                // Put down anything still settling, so this drag
                                // measures against the places the list has.
                                root.land();
                            }

                            // A grab taken away counts as letting go, or the card
                            // hangs where it was lost.
                            if ((event.kind == PointerEventKind.up
                                 || event.kind == PointerEventKind.cancel) && self.carrying) {
                                self.carrying = false;
                                root.dropped();
                            }
                        }

                        moved => {
                            if (!self.carrying) {
                                if (abs(self.absolute-position.x + self.mouse-x - self.press-x)
                                        < root.slack
                                    && abs(self.absolute-position.y + self.mouse-y - self.press-y)
                                        < root.slack) {
                                    return;
                                }

                                self.carrying = true;
                                root.carrying = port.name;
                                root.grabbed(index, self.press-x, self.press-y);
                            }

                            root.carried(self.absolute-position.x + self.mouse-x,
                                         self.absolute-position.y + self.mouse-y);
                        }

                        double-clicked => {
                            Sheets.edit("edit-port", index, "port", "Edit " + port.name,
                                        Sys.port-filters, "src", port.name, port.file,
                                        true, port.dosbox);
                        }
                    }

                    VerticalLayout {
                        x: 16px;
                        y: 16px;
                        width: parent.width - 32px;
                        height: self.preferred-height;
                        spacing: 8px;
                        alignment: start;

                        HorizontalLayout {
                            spacing: 8px;
                            height: self.preferred-height;

                            Text {
                                text: port.name;
                                color: port.missing ? Theme.danger : Theme.text;
                                font-size: Theme.font-medium;
                                font-weight: 600;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            Rectangle { }

                            if port.dosbox : Pill {
                                height: 22px;
                                dot: false;
                                text: "DOS";
                                tone: Theme.muted;
                                wash: Theme.muted-soft;
                                y: (parent.height - self.height) / 2;
                            }

                            if port.missing : Pill {
                                height: 22px;
                                text: "Missing";
                                tone: Theme.danger;
                                wash: Theme.danger-soft;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        PathLabel {
                            room: root.cell - 32px;
                            path: port.file;
                        }

                        if port.fetched : Text {
                            text: "Fetched by ZDL";
                            color: Theme.faint;
                            font-size: Theme.font-small;
                        }
                    }

                    HorizontalLayout {
                        x: 16px;
                        y: parent.height - self.height - 16px;
                        width: self.preferred-width;
                        height: self.preferred-height;
                        spacing: 8px;

                        AppButton {
                            text: "Edit";
                            glyph: "edit";
                            compact: true;
                            hint: "Rename it or point it at another file";
                            clicked => {
                                Sheets.edit("edit-port", index, "port", "Edit " + port.name,
                                            Sys.port-filters, "src", port.name, port.file,
                                            true, port.dosbox);
                            }
                        }

                        GlyphButton {
                            glyph: "folder";
                            outlined: true;
                            y: (parent.height - self.height) / 2;
                            hint: "Open the directory it is in";
                            clicked => {
                                Sys.reveal(Sys.directory-of(port.file));
                            }
                        }

                        GlyphButton {
                            glyph: "trash";
                            outlined: true;
                            hover-tone: Theme.danger;
                            y: (parent.height - self.height) / 2;

                            hint: port.fetched
                                ? "Delete what was fetched and take it out of the list"
                                : "Take it out of the list. The file itself is left where it is";

                            clicked => {
                                Sheets.ask("forget-port", "", index,
                                           "Remove \"" + port.name + "\"?",
                                           port.fetched
                                               ? "Everything ZDL unpacked for it is deleted and "
                                                 + "it goes out of every profile that named it."
                                               : "It goes out of this list and out of every "
                                                 + "profile that named it. The file itself is "
                                                 + "left where it is.",
                                           "Remove", true);
                            }
                        }
                    }
                }

                adder := Surface {
                    x: root.cell-x(root.count);
                    y: root.cell-y(root.count);
                    width: root.cell;
                    height: root.row-height;
                    inset: true;
                    hoverable: true;
                    hovered: over.has-hover;

                    over := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            // One at a time, named after its own file.
                            Pick.start("add-port", "Add a source port", Sys.port-filters, false,
                                       false, "src", "DOS program",
                                       "It is started inside DOSBox instead of being run as "
                                       + "it is");
                        }
                    }

                    VerticalLayout {
                        x: 20px;
                        y: (parent.height - self.preferred-height) / 2;
                        width: parent.width - 40px;
                        height: self.preferred-height;
                        spacing: 8px;

                        Glyph {
                            x: (parent.width - self.width) / 2;
                            name: "plus";
                            weight: 1.6;
                            tone: over.has-hover ? Theme.accent : Theme.faint;
                        }

                        Text {
                            text: "Add one you already have";
                            color: over.has-hover ? Theme.text : Theme.muted;
                            font-size: Theme.font-body;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Point ZDL at a source port on this machine. It can be "
                                + "marked as a DOS program while it is picked.";
                            color: Theme.faint;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            bar := Scroller {
                x: parent.width - self.width;
                height: parent.height;
                visible: root.installed && shelf.viewport-height > shelf.height;
                offset: shelf.viewport-y;
                content: shelf.viewport-height;
                room: shelf.height;
                scrolled(to) => {
                    shelf.viewport-y = to;
                }
            }

            EngineBrowseView {
                visible: !root.installed;
            }
        }
    }
}
