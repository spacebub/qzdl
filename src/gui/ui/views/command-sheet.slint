import { Theme } from "../theme.slint";
import { Cfg, Notify } from "../state.slint";
import { Sheets } from "../sheets.slint";
import { Sheet } from "../components/sheet.slint";
import { Surface } from "../components/surface.slint";
import { GlyphButton } from "../components/glyph-button.slint";
import { AppButton } from "../components/app-button.slint";
import { Scroller } from "../components/scroller.slint";
import { Clip } from "../components/clip.slint";

export component CommandSheet inherits Sheet {
    property <string> shown: Cfg.command-line != "" ? Cfg.command-line
        : Cfg.dos-port && Cfg.dosbox == "" && Cfg.system-dosbox == ""
            ? "Nothing to launch yet: this source port is a DOS one, and there is no DOSBox "
              + "on this machine to run it in."
        : "Nothing to launch yet: no source port is selected.";

    open: Sheets.command-open;
    card-width: 760px;
    card-height: 420px;

    dismissed => {
        Sheets.command-open = false;
    }

    head := HorizontalLayout {
        x: 22px;
        y: 22px;
        width: root.room-width - 44px;
        height: self.preferred-height;
        spacing: 10px;

        Text {
            text: "Command line";
            color: Theme.text;
            font-size: Theme.font-large;
            font-weight: Theme.heading-weight;
            vertical-alignment: center;
        }

        GlyphButton {
            glyph: "cross";
            size: 26px;
            y: (parent.height - self.height) / 2;
            clicked => {
                Sheets.command-open = false;
            }
        }
    }

    Surface {
        x: 22px;
        y: head.y + head.height + 14px;
        width: root.room-width - 44px;
        height: root.room-height - self.y - 14px - Theme.control - 22px;
        inset: true;

        view := Flickable {
            x: 14px;
            y: 14px;
            // Giving the bar's room back would rewrap the text, which decides whether the bar is there.
            width: parent.width - 28px - bar.width - 6px;
            height: parent.height - 28px;
            viewport-height: line.preferred-height;

            line := Text {
                width: parent.width;
                text: root.shown;
                color: Cfg.command-line == "" ? Theme.faint : Theme.text;
                font-family: Theme.mono;
                font-size: Theme.font-small;
                wrap: char-wrap;
            }
        }

        bar := Scroller {
            x: parent.width - self.width - 14px;
            y: 14px;
            height: parent.height - 28px;
            offset: view.viewport-y;
            content: view.viewport-height;
            room: view.height;
            scrolled(to) => {
                view.viewport-y = to;
            }
        }
    }

    HorizontalLayout {
        x: 22px;
        y: root.room-height - self.height - 22px;
        width: root.room-width - 44px;
        height: Theme.control;
        alignment: end;
        spacing: 8px;

        AppButton {
            text: "Copy";
            glyph: "edit";
            enabled: Cfg.command-line != "";
            clicked => {
                Clip.copy(Cfg.command-line);
                Notify.success("The command line is on the clipboard.");
            }
        }

        AppButton {
            text: "Close";
            variant: "primary";
            clicked => {
                Sheets.command-open = false;
            }
        }
    }
}
