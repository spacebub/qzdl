import { ListView } from "std-widgets.slint";

import { Theme } from "../theme.slint";
import { Sys, Pick } from "../state.slint";
import { Sheet } from "../components/sheet.slint";
import { Surface } from "../components/surface.slint";
import { Crumb } from "../components/crumb.slint";
import { Wash } from "../components/wash.slint";
import { Glyph } from "../components/glyph.slint";
import { FileGlyph } from "../components/file-glyph.slint";
import { GlyphButton } from "../components/glyph-button.slint";
import { AppButton } from "../components/app-button.slint";
import { Toggle } from "../components/toggle.slint";
import { Scroller } from "../components/scroller.slint";

// The row along the top is where you are: click a piece of it to go there, or the
// path itself to type one.
export component PickSheet inherits Sheet {
    open: Pick.open;
    card-width: 700px;
    card-height: 540px;

    dismissed => {
        Pick.dismiss();
    }

    head := HorizontalLayout {
        x: 18px;
        y: 18px;
        width: root.room-width - 36px;
        height: self.preferred-height;
        spacing: 10px;

        Text {
            text: Pick.title;
            color: Theme.text;
            font-size: Theme.font-large;
            font-weight: Theme.heading-weight;
            vertical-alignment: center;
        }

        GlyphButton {
            glyph: "cross";
            size: 26px;
            y: (parent.height - self.height) / 2;
            clicked => {
                Pick.dismiss();
            }
        }
    }

    where := Rectangle {
        x: 18px;
        y: head.y + head.height + 12px;
        width: root.room-width - 36px;
        height: Theme.control;
        border-radius: Theme.radius-small;
        background: Theme.field;
        border-width: 1px;
        border-color: Pick.editing ? Theme.accent : Theme.border-strong;

        animate border-color { duration: 120ms; }

        up := GlyphButton {
            x: 4px;
            y: (parent.height - self.height) / 2;
            width: Pick.editing || Pick.drives ? 0px : 30px;
            visible: !Pick.editing && !Pick.drives;
            glyph: "up";
            size: 30px;
            hint: "Go up one directory";
            enabled: Pick.rooted || Pick.parts.length > 0;
            clicked => {
                Pick.up();
            }
        }

        crumbs := Flickable {
            x: up.x + up.width + 4px;
            y: 0;
            width: typer.x - self.x - 4px;
            height: parent.height;
            visible: !Pick.editing;
            viewport-width: row.preferred-width;
            viewport-height: parent.height;

            // A path that overruns is read from its far end, where the current
            // folder is written.
            changed viewport-width => {
                self.viewport-x = min(0px, self.width - self.viewport-width);
            }

            row := HorizontalLayout {
                width: self.preferred-width;
                height: parent.height;
                spacing: 1px;

                Crumb {
                    label: Sys.windows ? "This PC" : "/";
                    activated => {
                        if (Sys.windows) {
                            Pick.show-drives();
                        } else {
                            Pick.go("/");
                        }
                    }
                }

                for part[index] in Pick.drives ? [] : Pick.parts : HorizontalLayout {
                    spacing: 1px;
                    width: self.preferred-width;

                    Text {
                        text: "/";
                        color: Theme.faint;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                    }

                    Crumb {
                        label: part;
                        last: index == Pick.parts.length - 1;
                        activated => {
                            Pick.up-to(index);
                        }
                    }
                }
            }
        }

        typed := TextInput {
            x: 12px;
            y: 0;
            width: typer.x - self.x - 4px;
            height: parent.height;
            visible: Pick.editing;
            vertical-alignment: center;
            single-line: true;
            color: Theme.text;
            font-size: Theme.font-body;
            font-family: Theme.mono;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.accent-text;

            accepted => {
                Pick.typed(self.text);
            }
        }

        typer := GlyphButton {
            x: parent.width - self.width - 4px;
            y: (parent.height - self.height) / 2;
            glyph: Pick.editing ? "cross" : "edit";
            size: 30px;
            hint: Pick.editing ? "Back to browsing" : "Type a path";
            clicked => {
                Pick.editing = !Pick.editing;

                if (Pick.editing) {
                    typed.text = Pick.drives ? "" : Pick.path;
                    typed.focus();
                    typed.select-all();
                }
            }
        }
    }

    Surface {
        x: 18px;
        y: where.y + where.height + 12px;
        width: root.room-width - 36px;
        height: root.room-height - self.y - 12px - Theme.control-small - 18px;
        inset: true;

        entries := ListView {
            x: 6px;
            y: 6px;
            width: parent.width - 12px - bar.width - 2px;
            height: parent.height - 12px;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;

            for entry in Pick.entries : Rectangle {
                height: 34px;

                Wash {
                    width: parent.width - 6px;
                    rounding: Theme.radius-small - 2px;
                    selected: entry.marked;
                    hovered: hover.has-hover;
                }

                HorizontalLayout {
                    x: 10px;
                    width: parent.width - 40px;
                    spacing: 9px;
                    alignment: start;

                    FileGlyph {
                        folder: entry.directory;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: entry.name;
                        color: entry.marked ? Theme.accent
                            : entry.hidden ? Theme.muted
                            : Theme.text;
                        font-size: Theme.font-body;
                        font-family: Theme.mono;
                        font-weight: entry.marked ? 600 : 400;
                        vertical-alignment: center;
                    }
                }

                if entry.marked : Glyph {
                    x: parent.width - self.width - 16px;
                    y: (parent.height - self.height) / 2;
                    name: "check";
                    tone: Theme.accent;
                }

                hover := TouchArea {
                    clicked => {
                        if (entry.directory) {
                            Pick.go(entry.path);
                        } else {
                            Pick.mark(entry.path);
                        }
                    }

                    // A file is otherwise marked and taken with the button below,
                    // so one stray click adds nothing; twice is plain enough.
                    double-clicked => {
                        if (!entry.directory) {
                            Pick.choose(entry.path);
                        }
                    }
                }
            }
        }

        bar := Scroller {
            x: parent.width - self.width - 6px;
            y: 6px;
            height: parent.height - 12px;
            offset: entries.viewport-y;
            content: entries.viewport-height;
            room: entries.height;
            scrolled(to) => {
                entries.viewport-y = to;
            }
        }
    }

    HorizontalLayout {
        x: 18px;
        y: root.room-height - self.height - 18px;
        width: root.room-width - 36px;
        height: Theme.control-small;
        spacing: 10px;

        Text {
            width: Pick.entries.length == 0 ? self.preferred-width : 0px;
            visible: Pick.entries.length == 0;
            text: Pick.nothing;
            color: Theme.faint;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }

        Rectangle { }

        // Always here, so the row keeps something in it either way.
        Toggle {
            text: "Hidden";
            hint: "Show what the filesystem keeps out of the way";
            checked: Pick.hidden-shown;
            y: (parent.height - self.height) / 2;
            toggled(value) => {
                Pick.show-hidden(value);
            }
        }

        if Pick.option != "" : Toggle {
            text: Pick.option;
            hint: Pick.option-hint;
            checked: Pick.option-set;
            y: (parent.height - self.height) / 2;
            toggled(value) => {
                Pick.option-set = value;
            }
        }

        if Pick.directories && !Pick.drives : AppButton {
            text: "Use this directory";
            variant: "primary";
            compact: true;
            clicked => {
                Pick.choose(Pick.path);
            }
        }

        if !Pick.multiple && !Pick.directories : AppButton {
            text: "Use this file";
            variant: "primary";
            compact: true;
            enabled: Pick.marked > 0;
            clicked => {
                Pick.choose-marked();
            }
        }

        if Pick.multiple : AppButton {
            text: Pick.marked == 1 ? "Add 1 file" : "Add " + Pick.marked + " files";
            variant: "primary";
            compact: true;
            enabled: Pick.marked > 0;
            clicked => {
                Pick.choose-marked();
            }
        }
    }
}
