/*
Generated from lsan.supp, and only compiled into a build the sanitizers were
asked for. The runtimes look these symbols up as they start, which is what
saves every run from having to be told where to write and what to ignore.

Edit lsan.supp, not this file.

Everything here is a literal. The runtimes ask for these while they are still
coming up, before the calls they stand in front of are ready to be made, so
there is nothing to work out and nothing to call: the answers were built when
the binary was.
*/

// Where the binaries are put, so a run leaves its report beside the one that
// produced it. The name of the binary is added by whoever compiles this, and
// the process id by the runtime: bin/ZDL.san.10231.
#ifndef QZDL_SANITIZER_LOG
#define QZDL_SANITIZER_LOG "@CMAKE_RUNTIME_OUTPUT_DIRECTORY@/sanitizer"
#endif

extern "C" const char *__lsan_default_suppressions();
extern "C" const char *__asan_default_options();
extern "C" const char *__ubsan_default_options();

extern "C" const char *__lsan_default_suppressions() {
    return R"lsan(
@SANITIZER_SUPPRESSIONS@
)lsan";
}

extern "C" const char *__asan_default_options() {
    return "log_path=" QZDL_SANITIZER_LOG ".san";
}

/*
Undefined behaviour is otherwise reported with the line it happened on and
nothing else, and a line on its own is not enough to find anything by.

It stays a report and not a stop. A run that ended at the first of these would
never reach the part worth watching.
*/
extern "C" const char *__ubsan_default_options() {
    return "log_path=" QZDL_SANITIZER_LOG ".san"
           ":print_stacktrace=1"
           ":halt_on_error=0";
}
